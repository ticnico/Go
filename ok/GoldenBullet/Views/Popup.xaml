<mah:MetroWindow x:Class="GoldenBullet.Views.Popup"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="Trial Version"
                 Width="420"
                 Height="280"
                 Background="#FF1E1E1E"
                 BorderThickness="0"
                 GlowBrush="#FFD700"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowCloseButton="False"
                 ShowMinButton="False"
                 ShowMaxRestoreButton="False"
                 ShowInTaskbar="False"
                 WindowStyle="SingleBorderWindow"
                 Topmost="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <iconPacks:PackIconMaterial Kind="StarCircle" 
                                        Width="28" Height="28" 
                                        Foreground="#FFD700"
                                        VerticalAlignment="Center"/>
            <TextBlock Text="Trial Version" 
                       Foreground="#FFE0E0E0" 
                       FontSize="18" 
                       FontWeight="SemiBold"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Content -->
        <Border Grid.Row="1" 
                Background="#FF252525" 
                BorderBrush="#80D19900"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15">
            <StackPanel>
                <TextBlock Text="Thank you for trying GoldenBullet!" 
                           Foreground="#FFE0E0E0" 
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <TextBlock Foreground="#FFAAAAAA" 
                           FontSize="12"
                           TextWrapping="Wrap"
                           LineHeight="18"><Run Text="• Full features available "/><Run Language="fr-fr" Text="at Full Version"/><Run Text="&#xA;"/><Run Text=" "/><Run Text="• Some advanced tools may be limited&#xA;"/><Run Text=" "/><Run Text="• Purchase a license to unlock everything"/></TextBlock>

                <TextBlock Text="Hardware ID:" 
                           Foreground="#FF666666" 
                           FontSize="10"
                           Margin="0,12,0,4"/>
                <TextBlock x:Name="TxtHardwareId" 
                           Foreground="#FFD700" 
                           FontSize="10"
                           FontFamily="Consolas"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button x:Name="BtnDemo" Style="{StaticResource StyledPrimaryButton}"
                    Content="Continue Demo"
                    Width="130" Height="32"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Click="BtnDemo_Click">
            </Button>

            <Button x:Name="BtnBuy" Style="{StaticResource StyledSuccessButton}"
                    Content="Buy License"
                    Width="130" Height="32"
                    Cursor="Hand"
                    Click="BtnBuy_Click">
            </Button>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
