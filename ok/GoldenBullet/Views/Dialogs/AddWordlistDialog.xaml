<Page x:Class="GoldenBullet.Views.Dialogs.AddWordlistDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      Width="496"
      Title="Add a wordlist"
      Background="#1E1E1E">

    <Page.Resources>
        <!-- Modern Label Style -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Icon Button Style -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->

        <!-- Form Container -->
        <Border Grid.Row="1" 
                Background="#252526" 
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Location -->
                <Label Grid.Column="0" Grid.Row="0" 
                       Content="Location:" 
                       Style="{StaticResource ModernLabel}"
                       Margin="0,0,10,0"/>
                <TextBox x:Name="locationTextbox" 
                         Grid.Column="1" Grid.Row="0" 
                         Style="{StaticResource RoundedTextBox}"
                         IsReadOnly="True"
                         Margin="0,0,10,0"/>
                <Button Grid.Column="2" Grid.Row="0" 
                        Style="{StaticResource StyledPrimaryButton}"
                        Click="SearchInFolder">
                    <iconPacks:PackIconRemixIcon Kind="Folder2Fill" 
                                                 Foreground="#FF28A745" 
                                                 Width="18" 
                                                 Height="18"/>
                </Button>

                <!-- Name -->
                <Label Grid.Column="0" Grid.Row="1" 
                       Content="Name:" 
                       Style="{StaticResource ModernLabel}"
                       Margin="0,10,10,0"/>
                <TextBox x:Name="nameTextbox" 
                         Grid.Column="1" Grid.Row="1" 
                         Grid.ColumnSpan="2"
                         Style="{StaticResource RoundedTextBox}"
                         Margin="0,10,0,0"/>

                <!-- Type -->
                <Label Grid.Column="0" Grid.Row="2" 
                       Content="Type:" 
                       Style="{StaticResource ModernLabel}"
                       Margin="0,10,10,0"/>
                <ComboBox x:Name="typeCombobox" 
                          Grid.Column="1" Grid.Row="2" 
                          Grid.ColumnSpan="2"
                          Style="{StaticResource RoundedComboBox}"
                          Margin="0,10,0,0"/>

                <!-- Purpose -->
                <Label Grid.Column="0" Grid.Row="3" 
                       Content="Purpose:" 
                       Style="{StaticResource ModernLabel}"
                       Margin="0,10,10,0"/>
                <TextBox x:Name="purposeTextbox" 
                         Grid.Column="1" Grid.Row="3" 
                         Grid.ColumnSpan="2"
                         Style="{StaticResource RoundedTextBox}"
                         Margin="0,10,0,0"/>

                <!-- Accept Button -->
                <Button Grid.Column="0" 
                        Grid.ColumnSpan="3" 
                        Grid.Row="4" 
                        x:Name="acceptButton" 
                        Click="Accept" 
                        Style="{StaticResource StyledSuccessButton}" 
                        Margin="0,20,0,0"
                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconOcticons Kind="Check" 
                                                    Foreground="White" 
                                                    Width="16" 
                                                    Height="16" 
                                                    Margin="0,0,8,0"/>
                        <TextBlock Text="Accept" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
