<Page x:Class="GoldenBullet.Views.Dialogs.SelectConfigDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:local="clr-namespace:GoldenBullet.Views.Dialogs"
      mc:Ignorable="d" 
      Width="800"
      Height="600"
      d:DesignHeight="600" 
      d:DesignWidth="800"
      Title="Select Config"
      Background="#212121">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
        </Style>

        <!-- Count Badge Style -->
        <Style x:Key="CountBadge" TargetType="Border">
            <Setter Property="Background" Value="#2d3748"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Grid Card Style -->
        <Style x:Key="GridCard" TargetType="Border">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="BorderBrush" Value="#3a3a3a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1a3a5c"/>
                    <Setter Property="BorderBrush" Value="#666666"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="25,25,25,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Select Config" FontSize="32" FontWeight="Bold" Foreground="#e2e8f0"/>
            <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" Foreground="#e2e8f0" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Subtitle -->
        <TextBlock Grid.Row="1" Text="Select a config to use for testing. Configs contain the instructions needed to test a target website" 
                   Foreground="#718096" FontSize="14" Margin="0,0,0,15"/>

        <!-- Warning Banner -->
        <Border Grid.Row="2" Background="#2d1b1b" BorderBrush="#5c2a2a" BorderThickness="1" Margin="0,0,0,15" CornerRadius="4">
            <StackPanel Margin="15,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <iconPacks:PackIconMaterial Kind="Alert" Foreground="#ff6b6b" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock Text="Warning" Foreground="#ff6b6b" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#cccccc" FontSize="12">
                    Configs can contain C# code that is executed without any automatic checks for malicious behaviors. If you use configs made by third parties, it is 
                    <Run FontWeight="Bold" Foreground="#ff6b6b">your responsibility</Run> 
                    to make sure that configs do exactly what they are supposed to do and that nothing shady is going on. 
                    <Run FontWeight="Bold" Foreground="#ff6b6b">Always check</Run> 
                    the LoliCode / C# code yourself before running them if you don't completely trust the origin.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Section Title with Toolbar -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <!-- Section Title with Count -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Available Configs" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource CountBadge}">
                    <TextBlock Text="{Binding Total}" Foreground="#e2e8f0" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">


                <!-- Search -->
                <TextBox x:Name="filterTextbox" Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}" Width="200" KeyDown="UpdateSearch" 
                         Background="#2d2d2d" Foreground="White" BorderBrush="#444444" Padding="8,6" BorderThickness="1"/>
                <Button Click="Search" Background="#007bff" BorderBrush="#007bff" Foreground="White" Padding="12,6" Margin="5,0,0,0" Cursor="Hand">
                    <iconPacks:PackIconMaterial Kind="Magnify" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- GRID VIEW (Default) -->
        <Border Grid.Row="4" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <ItemsControl x:Name="configsGridView" ItemsSource="{Binding ConfigsCollection}" Margin="15">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="130" Height="140" Margin="6" 
                                    Style="{StaticResource GridCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>

                                    <Image Grid.Row="0" Source="{Binding Icon}" Stretch="Uniform" MaxWidth="48" MaxHeight="48" Margin="10" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="White" 
                                               FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" 
                                               Margin="8,4,8,0" TextAlignment="Center"/>

                                    <StackPanel Grid.Row="2" Margin="8,4,8,8">
                                        <TextBlock Text="{Binding Author}" Foreground="#888888" 
                                                   FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Category}" Foreground="#666666" 
                                                   FontSize="9" TextAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- TABLE VIEW -->
        <Border Grid.Row="4" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding IsTableView, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0">
                <ListView x:Name="configsListView" Foreground="#CCCCCC" Background="Transparent" 
          ItemsSource="{Binding ConfigsCollection}" SelectionMode="Single" BorderThickness="0" 
          VirtualizingPanel.IsVirtualizing="True" SelectionChanged="ItemHovered"
          MouseDoubleClick="ListItemDoubleClick"
          KeyDown="ConfigsListView_KeyDown"
          IsTabStop="True"
          Focusable="True">

                    <ListView.Resources>
                        <Style TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#808080" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="BorderBrush" Value="#3E3E42" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                        <Grid>
                                            <Border x:Name="HeaderBorder" 
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <Thumb x:Name="PART_HeaderGripper" 
                                                   HorizontalAlignment="Right" 
                                                   Width="8"
                                                   Background="Transparent"
                                                   BorderBrush="#3E3E42"
                                                   BorderThickness="0,0,1,0"
                                                   Cursor="SizeWE">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Width="{TemplateBinding Width}"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#3E3E42"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#4D90FE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="#3E3E42" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Name="Bd" 
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="true">
                                            <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3E3E42"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#3E3E42"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.Resources>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Path=Icon}" Width="24" Height="24" Margin="8,4" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Path=Name}" Width="150"/>
                            <GridViewColumn Header="Author" DisplayMemberBinding="{Binding Path=Author}" Width="120"/>
                            <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Path=Category}" Width="100"/>
                            <GridViewColumn Header="Remote" DisplayMemberBinding="{Binding Path=RemoteStatus}" Width="80"/>
                            <GridViewColumn Header="Proxies" DisplayMemberBinding="{Binding Path=ProxiesStatus}" Width="80"/>
                            <GridViewColumn Header="Wordlists" DisplayMemberBinding="{Binding Path=AllowedWordlistTypes}" Width="150"/>
                            <GridViewColumn Header="Creation Date" DisplayMemberBinding="{Binding Path=CreationDate, StringFormat='{}{0:MMM d, yyyy}'}" Width="120"/>
                            <GridViewColumn Header="Last Modified" DisplayMemberBinding="{Binding Path=LastModified, StringFormat='{}{0:MMM d, yyyy}'}" Width="120"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>
        </Border>

        <!-- Accept Button (Dialog-specific) -->
        <Button Click="Accept"
                Grid.Row="5"
                Margin="0 10 0 0"
                Style="{StaticResource StyledSuccessButton}"
                HorizontalAlignment="Stretch"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <iconPacks:PackIconOcticons Kind="Check" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" Margin="8 0 0 0">Select Config</TextBlock>
            </StackPanel>
        </Button>
    </Grid>
</Page>
