<Page x:Class="GoldenBullet.Views.Dialogs.AddProxyGroupDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" Width="320"
      Title="Proxy Group"
      Background="#FF1E1E1E" Height="191">

    <Page.Resources>
        <!-- Dialog Card Style -->
        <Style x:Key="DialogCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>

        <!-- Form Label Style -->
        <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>

        </Style>

    </Page.Resources>

    <!-- Centered Dialog Container -->
    <Grid Background="#FF1E1E1E">
        <Border Style="{StaticResource DialogCardStyle}" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="280">

            <StackPanel>

                <!-- Dialog Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <iconPacks:PackIconMaterial Kind="Server" 
                                                Width="20" Height="20" 
                                                Foreground="#D19900" 
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Proxy Group" 
                                   FontSize="14" FontWeight="SemiBold" 
                                   Foreground="#FFE0E0E0"/>
                        <TextBlock Text="Enter a name for your proxy group" 
                                   FontSize="10" Foreground="#FFAAAAAA"/>
                    </StackPanel>
                </StackPanel>

                <!-- Name Input Field -->
                <StackPanel Orientation="Horizontal" Margin="0,0,10,10">
                    <TextBlock Style="{StaticResource DialogLabelStyle}" Text="Name:"/>
                    <TextBox x:Name="nameTextbox"
                             AcceptsReturn="False"
                             Style="{StaticResource RoundedTextBox}" Margin="0" 
                             Width="182" Height="30"/>
                </StackPanel>

                <!-- Action Button -->
                <Button x:Name="acceptButton" 
                        Click="Accept"
                        Style="{StaticResource StyledSuccessButton}"
                        HorizontalAlignment="Stretch" Width="117">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterialDesign Kind="Check" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Create Group" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Page>
