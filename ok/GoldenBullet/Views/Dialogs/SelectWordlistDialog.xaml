<Page x:Class="GoldenBullet.Views.Dialogs.SelectWordlistDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Dialogs"
      xmlns:uc="clr-namespace:GoldenBullet.Controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      Width="800"
      Height="600"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Select wordlist"
      Background="#1E1E1E">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>


        <!-- Modern Green Button Style -->
        <Style x:Key="StyledSuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#34CE57"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E7E34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pagination Button Style -->
        <Style x:Key="PaginationButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4D90FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" 
                Background="#252526" 
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,15">
            <TextBox x:Name="filterTextbox" 
                     Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}" 
                     TextChanged="FilterTextChanged"
                     Background="Transparent"
                     Foreground="#CCCCCC"
                     BorderThickness="0"
                     Padding="10,8"
                     FontSize="13"
                     VerticalContentAlignment="Center"/>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="1" 
                Background="#252526" 
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <!-- No Results Message -->
                <TextBlock Grid.Row="0" 
                           x:Name="noResultsText"
                           Text="No wordlists found" 
                           Foreground="#808080"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Visibility="Collapsed"/>

                <!-- ListView -->
                <ListView 
                    x:Name="wordlistListView" 
                    Grid.Row="0"
                    Foreground="#CCCCCC"
                    Background="Transparent" 
                    ItemsSource="{Binding Path=WordlistsCollection}" 
                    SelectionMode="Extended"
                    BorderThickness="0"
                    SelectionChanged="ItemHovered"
                    MouseDoubleClick="ListItemDoubleClick" Margin="0,-10,10,53" Grid.RowSpan="2">
                    <ListView.Resources>
                        <Style TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#808080" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="BorderBrush" Value="#3E3E42" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                        <Grid>
                                            <Border x:Name="HeaderBorder" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="Center"/>
                                            </Border>
                                            <Thumb x:Name="PART_HeaderGripper" 
                           HorizontalAlignment="Right" 
                           Width="8"
                           Background="Transparent"
                           BorderBrush="#3E3E42"
                           BorderThickness="0,0,1,0"
                           Cursor="SizeWE">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Width="{TemplateBinding Width}"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#3E3E42"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#4D90FE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.Resources>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn DisplayMemberBinding="{Binding Path=Name}" Header="Name" Width="160"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Path=FileName}" Header="Path" Width="280"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Path=Type}" Header="Type" Width="100"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Path=Purpose}" Header="Purpose" Width="100"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Path=Total}" Header="Total" Width="80"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Bottom Bar: Pagination + Accept Button -->
                <Grid Grid.Row="1" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pagination -->
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center"/>

                    <!-- Pagination Info -->
                    <TextBlock x:Name="paginationText"
                               Grid.Column="1"
                               Text="Showing 0 to 0 of 0 entries" 
                               Foreground="#808080"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="12"/>

                    <!-- Accept Button -->
                    <Button Grid.Column="2"
                            Click="Accept"
                            Style="{StaticResource StyledSuccessButton}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconOcticons Kind="Check" Foreground="White" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Accept" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
