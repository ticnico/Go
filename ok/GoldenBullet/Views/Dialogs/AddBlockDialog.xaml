<Page x:Class="GoldenBullet.Views.Dialogs.AddBlockDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Dialogs"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:trees="clr-namespace:RuriLib.Models.Trees;assembly=RuriLib"
      xmlns:blocks="clr-namespace:RuriLib.Models.Blocks;assembly=RuriLib"
      xmlns:converters="clr-namespace:GoldenBullet.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="640" 
      Title="Add Block"
      
      Background="#FF1E1E1E">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToThicknessConverter x:Key="BoolToThick" />

        <!-- 🔹 Block Button Style - Option 1: Opacity-based press (respects category color) -->
        <Style x:Key="BlockButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding Category.BackgroundColor, TargetNullValue=#FF2D2D2D}"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- ✅ No CornerRadius in template for compatibility -->
                        <Border x:Name="border" 
                                CornerRadius="6"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Opacity="1.0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover: subtle highlight -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40D19900"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFD700" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- Pressed: darken by reducing opacity (preserves original color) -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.65"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFD700" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Block Label Style -->
        <Style x:Key="BlockLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Category.ForegroundColor, TargetNullValue=#FFE0E0E0}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Block Description Style -->
        <Style x:Key="BlockDescStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Category.ForegroundColor, TargetNullValue=#FFAAAAAA}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Border Background="#FF1E1E1E" Padding="3">
        <Grid MinHeight="400" Width="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <!-- Search Header -->
            <Border Grid.Row="0" 
                    Background="#FF252525" 
                    BorderBrush="#40D19900" 
                    BorderThickness="1"
                    Margin="0,0,0,6">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Click="GoUp" 
                            Grid.Column="0"
                            Width="28" Height="28"
                            Margin="0,0,6,0"
                            Visibility="{Binding CanGoUp, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource StyledPrimaryButton}"
                            ToolTip="Go up one level">
                        <iconPacks:PackIconUnicons Kind="AngleUp" Width="16" Height="16"/>
                    </Button>

                    <TextBox x:Name="filterTextBox"
                             Style="{StaticResource RoundedTextBox}"
                             AcceptsReturn="False"
                             KeyDown="FilterKeyDown"
                             Grid.Column="1"
                             Background="#FF2D2D2D"
                             BorderBrush="#40D19900"
                             BorderThickness="1"
                             Foreground="#FFE0E0E0"
                             Padding="6,4"
                             VerticalContentAlignment="Center"
                             FontSize="11"/>

                    <Button Click="Search"
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            Style="{StaticResource StyledEditButton}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterialDesign Kind="Search" Width="14" Height="14"/>
                            <TextBlock Text="Search" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Blocks List -->
            <Border Grid.Row="1"
                    Background="#FF252525"
                    BorderBrush="#40D19900"
                    BorderThickness="1"
                    Margin="0,0,0,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="6">
                    <ItemsControl ItemsSource="{Binding NodesCollection}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <!-- Category Node Template -->
                            <DataTemplate DataType="{x:Type trees:CategoryTreeNode}">
                                <Button Style="{StaticResource BlockButtonStyle}"
                                        Width="142" Height="70"
                                        Tag="{Binding}"
                                        Click="SelectCategory">
                                    <TextBlock Style="{StaticResource BlockLabelStyle}"
                                               FontSize="12"
                                               Text="{Binding Category.Name}"
                                               TextWrapping="Wrap"/>
                                </Button>
                            </DataTemplate>

                            <!-- Block Descriptor Template -->
                            <DataTemplate DataType="{x:Type blocks:BlockDescriptor}">
                                <Button Style="{StaticResource BlockButtonStyle}"
                                        Width="142" Height="70"
                                        Tag="{Binding}"
                                        Click="SelectDescriptor">
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Style="{StaticResource BlockLabelStyle}"
                                                   FontSize="11"
                                                   Text="{Binding Name}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1"
                                                   Style="{StaticResource BlockDescStyle}"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Recently Used Header -->
            <Border Grid.Row="2" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="History" 
                                                Width="14" Height="14" 
                                                Foreground="#D19900" 
                                                Margin="0,0,6,0"/>
                    <TextBlock Text="Recently used blocks" 
                               FontSize="11" FontWeight="Medium" 
                               Foreground="#FFE0E0E0"/>
                </StackPanel>
            </Border>

            <!-- Recent Blocks List -->
            <Border Grid.Row="3"
                    Background="#FF252525"
                    BorderBrush="#40D19900"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="6"
                              MaxHeight="150">
                    <ItemsControl ItemsSource="{Binding RecentDescriptors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type blocks:BlockDescriptor}">
                                <Button Style="{StaticResource BlockButtonStyle}"
                                        Width="142" Height="60"
                                        Tag="{Binding}"
                                        Click="SelectDescriptor">
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Style="{StaticResource BlockLabelStyle}"
                                                   FontSize="11"
                                                   Text="{Binding Name}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1"
                                                   Style="{StaticResource BlockDescStyle}"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

        </Grid>
    </Border>
</Page>
