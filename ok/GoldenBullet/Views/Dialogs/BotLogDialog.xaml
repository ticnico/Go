<Page x:Class="GoldenBullet.Views.Dialogs.BotLogDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Dialogs"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
      xmlns:wfh="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
      mc:Ignorable="d"
      Width="800"
      Height="600"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Bot Log"
      Background="#FF1E1E1E">

    <Page.Resources>
        <!-- Dialog Card Style -->
        <Style x:Key="LogDialogCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="20"/>
        </Style>

        <!-- Log Viewer Container Style -->
        <Style x:Key="LogViewerContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF1A1A1A"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Search Bar Style -->
        <Style x:Key="LogSearchBarStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <!-- Toolbar Button Style -->
        <Style x:Key="LogToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40D19900"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#D19900" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1A1A1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search Button Variant -->
        <Style x:Key="LogSearchButtonStyle" TargetType="Button" BasedOn="{StaticResource LogToolbarButtonStyle}">
            <Setter Property="Width" Value="85"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Match Info Label Style -->
        <Style x:Key="MatchInfoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="1"/>
        </Style>
    </Page.Resources>

    <!-- Main Container -->
    <Grid Background="#FF1E1E1E">
        <Border Style="{StaticResource LogDialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <!-- ==================== LOG VIEWER (WinForms RichTextBox) ==================== -->
                <Border Grid.Row="0" Style="{StaticResource LogViewerContainerStyle}">
                    <Grid>
                        <!-- Header overlay for log info -->
                        <Border Background="#FF1E1E1E" 
                                Padding="12,8" 
                                BorderBrush="#40D19900" 
                                BorderThickness="0,0,0,1"
                                CornerRadius="6,6,0,0"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FormatListBulleted" 
                                                            Width="14" Height="14" 
                                                            Foreground="#D19900"
                                                            Margin="0,0,8,0"/>
                                <TextBlock Text="Bot Execution Log" 
                                           Foreground="#FFE0E0E0" 
                                           FontSize="11"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="• Read-only • Auto-scroll" 
                                           Foreground="#FF666666" 
                                           FontSize="10"
                                           FontStyle="Italic"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- WindowsFormsHost with RichTextBox - VALID PROPERTIES ONLY -->
                        <WindowsFormsHost x:Name="logHost"
                                          Margin="0,32,0,0"
                                          Background="Transparent">
                            <wf:RichTextBox x:Name="logRTB"
                                            Dock="Fill"
                                            ForeColor="#FFE0E0E0"
                                            BackColor="#FF1A1A1A"
                                            ReadOnly="True"
                                            ScrollBars="Vertical"
                                            BorderStyle="None"
                                            DetectUrls="False"/>
                        </WindowsFormsHost>
                    </Grid>
                </Border>

                <!-- ==================== SEARCH TOOLBAR ==================== -->
                <Border Grid.Row="1" Style="{StaticResource LogSearchBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Input -->
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource RoundedTextBox}"
                                 Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Enter search term and press Enter or click Search" Margin="0,0,10,0"/>

                        <!-- Search Button -->
                        <Button Grid.Column="1"
                                Click="Search"
                                Style="{StaticResource LogSearchButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterialDesign Kind="Search" Width="14" Height="14"/>
                                <TextBlock Text="Search" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Previous Match -->
                        <Button Grid.Column="2"
                                Click="PreviousMatch"
                                Style="{StaticResource LogToolbarButtonStyle}"
                                ToolTip="Previous match (Shift+F3)">
                            <iconPacks:PackIconUnicons Kind="ArrowUp" Width="16" Height="16"/>
                        </Button>

                        <!-- Match Counter -->
                        <TextBlock Grid.Column="3"
                                   Style="{StaticResource MatchInfoStyle}"
                                   Text="{Binding MatchInfo}"
                                   ToolTip="Current match / Total matches"/>

                        <!-- Next Match -->
                        <Button Grid.Column="4"
                                Click="NextMatch"
                                Style="{StaticResource LogToolbarButtonStyle}"
                                Margin="0"
                                ToolTip="Next match (F3)">
                            <iconPacks:PackIconUnicons Kind="ArrowDown" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
