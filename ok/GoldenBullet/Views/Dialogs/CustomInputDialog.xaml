<Page x:Class="GoldenBullet.Views.Dialogs.CustomInputDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Dialogs"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      MinWidth="300"
      Title="Input Required"
      Background="#FF1E1E1E">

    <Page.Resources>
        <!-- Dialog Card Style -->
        <Style x:Key="DialogCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Margin" Value="20"/>
        </Style>

        <!-- Dialog Header Style -->
        <Style x:Key="DialogHeaderStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Dialog Title Style -->
        <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Question Text Style -->
        <Style x:Key="QuestionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="MaxWidth" Value="400"/>
        </Style>

        <!-- Input ComboBox Style -->
        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#40D19900"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#D19900" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dialog Button Style -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF28A745"/>
            <Setter Property="BorderBrush" Value="#FF1E7E34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF218838"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF19692C"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF28A745" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E7E34"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF155728"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- Centered Dialog Container -->
    <Grid Background="#FF1E1E1E">
        <Border Style="{StaticResource DialogCardStyle}" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="340">

            <StackPanel HorizontalAlignment="Center">

                <!-- Dialog Header -->
                <StackPanel Style="{StaticResource DialogHeaderStyle}">
                    <iconPacks:PackIconMaterial Kind="FormTextbox" 
                                                Width="20" Height="20" 
                                                Foreground="#D19900" 
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource DialogTitleStyle}" Text="Input Required"/>
                </StackPanel>

                <!-- Question Text (dynamic via code-behind) -->
                <TextBlock x:Name="question"
                           Style="{StaticResource QuestionTextStyle}"
                           Text="Please enter your answer below:"/>

                <!-- Input ComboBox -->
                <ComboBox x:Name="answerComboBox"
                          Style="{StaticResource RoundedComboBoxArow}"
                          Margin="0 0 0 15"
                          Width="270"
                          Height="36"
                          ToolTip="Type or select an answer"
                          IsEditable="True"
                          IsReadOnly="False"
                          StaysOpenOnEdit="False"
                          IsTextSearchEnabled="False"/>

                <!-- Action Button -->
                <Button Click="Ok"
                        Style="{StaticResource DialogButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconOcticons Kind="Check" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="OK" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Page>
