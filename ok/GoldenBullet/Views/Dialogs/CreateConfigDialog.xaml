<Page x:Class="GoldenBullet.Views.Dialogs.CreateConfigDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Dialogs"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Create Config"
      Background="#FF1E1E1E">

    <Page.Resources>
        <!-- Dialog Card Style -->
        <Style x:Key="DialogCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="20"/>
        </Style>

        <!-- Dialog Header Style -->
        <Style x:Key="DialogHeaderStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Dialog Title Style -->
        <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Dialog Subtitle Style -->
        <Style x:Key="DialogSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Form Field Label Style -->
        <Style x:Key="FormFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
    </Page.Resources>

    <!-- Centered Dialog Container -->
    <Grid Background="#FF1E1E1E">
        <Border Style="{StaticResource DialogCardStyle}" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="421">

            <StackPanel HorizontalAlignment="Center">

                <!-- Dialog Header -->
                <StackPanel Style="{StaticResource DialogHeaderStyle}">
                    <iconPacks:PackIconMaterial Kind="FileDocumentEdit" 
                                                Width="20" Height="20" 
                                                Foreground="#D19900" 
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource DialogTitleStyle}" Text="Create Config"/>
                        <TextBlock Style="{StaticResource DialogSubtitleStyle}" Text="Enter details for your new configuration"/>
                    </StackPanel>
                </StackPanel>

                <!-- Name Field -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,7" Height="37">
                    <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="Name:"/>
                    <TextBox x:Name="nameTextbox"
                             Style="{StaticResource RoundedTextBox}"
                              Width="244"
                             KeyDown="TextboxKeyDown"
                             ToolTip="Enter a unique name for your config" Height="34"/>
                </StackPanel>

                <!-- Category Field -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,7" Height="37">
                    <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="Category:"/>
                    <ComboBox x:Name="categoryCombobox"
                              Style="{StaticResource RoundedComboBoxArow}" Margin="0 0 0 0"
                              Width="244"
                              IsEditable="True"
                              Text="Default"
                              KeyDown="TextboxKeyDown"
                              ToolTip="Enter or select a category"/>
                </StackPanel>

                <!-- Author Field -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5" Height="37">
                    <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="Author:"/>
                    <TextBox x:Name="authorTextbox"
                             Style="{StaticResource RoundedTextBox}"
                             Width="244"
                             KeyDown="TextboxKeyDown"
                             ToolTip="Enter your name or handle" Height="34"/>
                </StackPanel>

                <!-- Icon Field: TextBox + Browse Button -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16" Height="37">
                    <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="Icon:"/>
                    <TextBox x:Name="iconPathTextBox"
                             Style="{StaticResource RoundedTextBox}"
                             Width="186"
                             Height="34"
                             ToolTip="Enter or browse for icon path"/>
                    <Button Click="OpenIcon" 
                            Background="#FF2D2D2D" BorderBrush="#40D19900" BorderThickness="1" 
                            Foreground="#FFE0E0E0" Cursor="Hand" Padding="10,6" 
                            Width="48" Height="34" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconForkAwesome Kind="FolderOpen" Width="12" Height="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Helper Text -->

                <!-- Action Button -->
                <Button x:Name="acceptButton"
                        Click="Accept"
                        Height="32"
                        Style="{StaticResource StyledSuccessButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterialDesign Kind="Check" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Create Config" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Page>
