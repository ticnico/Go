<Page x:Class="GoldenBullet.Views.Dialogs.ImportProxiesDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d"
      Title="Import Proxies"
      Background="#FF1E1E1E" Width="auto" Height="auto">

    <Page.Resources>
        <!-- Dialog Card Style -->
        <Style x:Key="DialogCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="20"/>
        </Style>

        <!-- Mode Selector Button Style -->
        <Style x:Key="ModeSelectorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 0 0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFE0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Active Mode Selector Style -->
        <Style x:Key="ModeSelectorActiveStyle" TargetType="TextBlock" BasedOn="{StaticResource ModeSelectorStyle}">
            <Setter Property="Foreground" Value="#D19900"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Form Label Style -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Multiline Input Style -->
        <Style x:Key="MultilineInputStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
            <Setter Property="Height" Value="100"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="RoundedComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Dialog Button Style -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF28A745"/>
            <Setter Property="BorderBrush" Value="#FF1E7E34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF218838"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF19692C"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF28A745" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E7E34"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF155728"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Advanced Syntax Box Style -->
        <Style x:Key="SyntaxBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Page.Resources>

    <!-- Centered Dialog Container -->
    <Grid Background="#FF1E1E1E">
        <Border Style="{StaticResource DialogCardStyle}" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="320">

            <StackPanel>

                <!-- Dialog Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <!-- ✅ Fixed: Use PackIconMaterial with valid Kind -->
                    <iconPacks:PackIconMaterial Kind="FileImport"
                                                Width="18" Height="18" 
                                                Foreground="#D19900" 
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"/>
                    <TextBlock Text="Import Proxies" 
                               FontSize="14" FontWeight="SemiBold" 
                               Foreground="#FFE0E0E0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Mode Selector (File / Paste / Remote) -->
                <Border Background="#FF1E1E1E" CornerRadius="4" Padding="2" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="fileMode" 
                                   Style="{StaticResource ModeSelectorActiveStyle}"
                                   Text="File"
                                   MouseDown="SelectFileMode"
                                   Padding="35 0 0 0" Width="90"/>
                        <TextBlock Text="|" Foreground="#FF3C3C3C" VerticalAlignment="Center" Margin="2 0 0 4"/>
                        <TextBlock x:Name="pasteMode" 
                                   Style="{StaticResource ModeSelectorStyle}"
                                   Text="Paste"
                                   MouseDown="SelectPasteMode"
                                   Padding="28 0 0 0" Width="90"/>
                        <TextBlock Text="|" Foreground="#FF3C3C3C" VerticalAlignment="Center" Margin="2 0 0 4"/>
                        <TextBlock x:Name="remoteMode" 
                                   Style="{StaticResource ModeSelectorStyle}"
                                   Text="Remote"
                                   MouseDown="SelectRemoteMode"
                                   Padding="25 0 0 0" Width="90"/>
                    </StackPanel>
                </Border>

                <!-- Tab Content Area (Hidden TabControl) -->
                <TabControl x:Name="modeTabControl" 
                            Background="Transparent" 
                            BorderThickness="0"
                            Margin="0,0,0,12"
>
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- File Tab Content -->
                    <TabItem x:Name="fileTab">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="Location:"/>
                                <TextBox x:Name="locationTextbox" 
                                         Grid.Column="1" 
                                         Style="{StaticResource RoundedTextBox}"
                                         Margin="0,0,6,0"
                                         IsReadOnly="True"
                                         ToolTip="Selected file path"/>
                                <!-- ✅ Fixed: Use valid icon Kind for folder -->
                                <iconPacks:PackIconMaterial Kind="Folder"
                                                            Grid.Column="2"
                                                             Width="25" Height="30"
                                                             Foreground="#D19900"
                                                             Cursor="Hand"
                                                             ToolTip="Browse for file"
                                                             MouseDown="SearchInFolder"
                                                             VerticalAlignment="Center"
                                                            Margin="10 0 1 0"/>
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <!-- Paste Tab Content -->
                    <TabItem x:Name="pasteTab">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FormLabelStyle}" 
                                       Text="Paste proxies below (one per line):"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="proxiesBox"
                                     Style="{StaticResource MultilineInputStyle}"
                                     ToolTip="Paste proxy list: 1.1.1.1:80 or type:user:pass"/>
                        </StackPanel>
                    </TabItem>

                    <!-- Remote Tab Content -->
                    <TabItem x:Name="remoteTab">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="URL:"/>
                                <TextBox x:Name="urlTextbox" 
                                         Grid.Column="1" 
                                         Style="{StaticResource RoundedTextBox}"
                                         ToolTip="Enter URL returning proxy list"/>
                            </Grid>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- Advanced Syntax Section -->
                <Border Style="{StaticResource SyntaxBoxStyle}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="#FFE0E0E0" FontSize="10" Margin="0,0,0,4">
                            <!-- ✅ Fixed: Use valid icon Kind -->
                            <iconPacks:PackIconMaterial Kind="CodeTags" Width="12" Height="12" 
                                                        Foreground="#D19900" VerticalAlignment="Center"/>
                            <Run Text=" Advanced Syntax"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="9" Foreground="#FFAAAAAA" TextWrapping="Wrap">
                            <Run Foreground="#FFE0E0E0" FontWeight="Bold">Type:</Run>
                            <Run Text="(Http)1.1.1.1:80"/><LineBreak/>
                            <Run Foreground="#FFE0E0E0" FontWeight="Bold">Auth:</Run>
                            <Run Text="1.1.1.1:80:user:pass"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Defaults Section -->
                <TextBlock Text="Defaults (when not specified):" 
                           Foreground="#FFE0E0E0" 
                           FontSize="11" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <!-- Proxy Type -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="Type:"/>
                    <ComboBox x:Name="proxyTypeCombobox" 
                              Grid.Column="1" 
                              Style="{StaticResource RoundedComboBox}"/>
                </Grid>

                <!-- Username -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="Username:"/>
                    <TextBox x:Name="usernameTextbox" 
                             Height="30"
                             AcceptsReturn="False"
                             Grid.Column="1" 
                             Style="{StaticResource RoundedTextBox}"/>
                </Grid>

                <!-- Password -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="59*"/>
                        <ColumnDefinition Width="13*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="Password:" Margin="0,0,8,0"/>
                    <TextBox x:Name="passwordTextbox" 
                             Height="30"
                             AcceptsReturn="False"
                             Grid.Column="1" 
                             Style="{StaticResource RoundedTextBox}" Grid.ColumnSpan="2"/>
                </Grid>

                <!-- Action Button -->
                <Button x:Name="acceptButton" 
                        Click="Accept"
                        Style="{StaticResource DialogButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <!-- ✅ Fixed: Use PackIconMaterial with valid Kind -->
                        <iconPacks:PackIconMaterial Kind="FileImport" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Import Proxies" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Page>
