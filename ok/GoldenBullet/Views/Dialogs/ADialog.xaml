<mah:MetroWindow x:Class="GoldenBullet.Views.ADialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Activate GoldenBullet"
        Height="425"
        Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True"
        GlowBrush="#FF007ACC"
        Background="#FF1E1E1E"
        WindowTitleBrush="#FF252525"
        BorderThickness="0"
        TextElement.FontFamily="Segoe UI">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <iconPacks:PackIconMaterial Kind="LockOutline" Width="28" Height="28" Foreground="#FF007ACC" Margin="0,0,12,0"/>
            <StackPanel>
                <TextBlock Text="Activation Required" FontSize="22" FontWeight="Bold" Foreground="#FFE0E0E0"/>
                <TextBlock Text="This device is not licensed. Contact support or enter your key." 
                           FontSize="13" Foreground="#FFAAAAAA" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Hardware ID -->
        <Border Grid.Row="1" Background="#FF2D2D2D" BorderBrush="#FF3C3C3C" BorderThickness="1" 
                CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Your Hardware ID" FontWeight="SemiBold" Foreground="#FFE0E0E0" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FF1A1A1A" BorderBrush="#FF3C3C3C" 
                            BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <TextBlock x:Name="TxtHardwareId" TextWrapping="Wrap" FontFamily="Consolas" 
                                   FontSize="12" Foreground="#FF00FF00"/>
                    </Border>
                    <Button Grid.Column="1" x:Name="BtnCopyHwId" Click="BtnCopyHwId_Click" 
                            Margin="10,0,0,0" Width="80" Style="{StaticResource StyledPrimaryButton}">
                        Copy
                    </Button>
                </Grid>
                <TextBlock Text="Send this ID to the developer to get your license." 
                           FontStyle="Italic" FontSize="12" Margin="0,10,0,0" Foreground="#FFAAAAAA"/>
            </StackPanel>
        </Border>

        <!-- License Key Input -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="License Key or Offline Activation File" Margin="0,0,0,8" Foreground="#FFE0E0E0" FontSize="13" FontWeight="SemiBold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtLicenseKey" Grid.Column="0"
                 mah:TextBoxHelper.Watermark="Enter Key or load .dat file"
                 Margin="0,0,10,0" Style="{StaticResource RoundedTextBox}"/>

                <!-- NEW: Load File Button -->
                <Button Grid.Column="1" x:Name="BtnLoadFile" Click="BtnLoadFile_Click"
                Width="90" Margin="0,0,10,0" Style="{StaticResource StyledPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FolderOpen" Width="14" Height="14" Margin="0,0,4,0"/>
                        <TextBlock Text="Load File" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" x:Name="BtnActivate" Click="BtnActivate_Click"
                Width="100" Style="{StaticResource StyledSuccessButton}">
                    Activate
                </Button>
            </Grid>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Click="BtnBuy_Click" Width="130" Margin="0,0,10,0" Style="{StaticResource StyledPrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Cart" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Buy License" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Click="BtnExit_Click" Width="110" Style="{StaticResource StyledDangerButton}">
                Exit
            </Button>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
