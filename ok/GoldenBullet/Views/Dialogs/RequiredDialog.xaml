<Page x:Class="GoldenBullet.Views.Dialogs.RequiredDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignWidth="450"
             Background="#FF1E1E1E" 
             Height="auto">

    <Page.Resources>
        <!-- Button Base Style -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#FF3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF007ACC"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF007ACC" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1A1A1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="DialogButtonPrimaryStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="BorderBrush" Value="#FF005A9E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Page.Resources>

    <Grid Margin="25,25,25,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Card Container (Visual Only) -->
        <Border Grid.Row="0"
                Background="#FF252525"
                BorderBrush="#FF3C3C3C"
                BorderThickness="1"
                CornerRadius="12" Margin="0,0,0,13">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
            </Border.Effect>
        </Border>

        <!-- Content Container -->
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header with Icon -->
            <StackPanel Grid.Row="0" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,25">
                <Border Background="#FF2D2D2D" CornerRadius="8" Width="50" Height="50" BorderBrush="#FF3C3C3C" BorderThickness="1">
                    <iconPacks:PackIconMaterial Kind="LockOutline" 
                                                Width="26" 
                                                Height="26" 
                                                Foreground="#FFD700"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Activation Required" 
                           FontSize="22" 
                           FontWeight="Bold"
                           Margin="15,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FFE0E0E0"/>
            </StackPanel>

            <!-- 2. Message Content -->
            <StackPanel Grid.Row="1" Margin="0,0,0,25">
                <TextBlock Text="This feature is only available in the full version." 
                           FontSize="14"
                           TextWrapping="Wrap"
                           Foreground="#FFE0E0E0"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="You can create, edit, and clone jobs in trial mode, but you must activate your license to start them." 
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="#FFAAAAAA"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Feature List Box -->
                <Border Background="#FF2D2D2D"
                        BorderBrush="#FF3C3C3C"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <!-- Allowed Items -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <iconPacks:PackIconMaterial Kind="CheckCircle" Width="16" Height="16" Foreground="#FF28A745" Margin="0,0,8,0"/>
                            <TextBlock Text="Unlock All Start Buttons" FontSize="13" Foreground="#FFE0E0E0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <iconPacks:PackIconMaterial Kind="CheckCircle" Width="16" Height="16" Foreground="#FF28A745" Margin="0,0,8,0"/>
                            <TextBlock Text="Unlock Save Button On Config" FontSize="13" Foreground="#FFE0E0E0"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="#FF3C3C3C" Margin="0,0,0,12"/>

                        <!-- Restricted Item -->
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CloseCircle" Width="16" Height="16" Foreground="#FFDC3545" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Start job execution" FontSize="13" Foreground="#FFE0E0E0"/>
                                <TextBlock Text="(Requires Activation)" FontSize="11" Foreground="#FFDC3545" FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. Action Buttons -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center">
                <Button Content="Activate License" 
                        Width="150"
                        Style="{StaticResource StyledEditButton}"
                        Click="ActivateButton_Click"/>

                <Button Content="Later" 
                        Width="150"
                        Margin="10,0,0,0"
                        Style="{StaticResource StyledPrimaryButton}"
                        Click="LaterButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
