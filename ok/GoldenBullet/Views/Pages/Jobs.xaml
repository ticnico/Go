<Page x:Class="GoldenBullet.Views.Pages.Jobs"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Pages"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Jobs"
      Background="#FF1E1E1E">

    <Page.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Table Header Text -->
        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <!-- Table Cell Text -->
        <Style x:Key="TableCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Muted Cell Text -->
        <Style x:Key="MutedCellText" TargetType="TextBlock" BasedOn="{StaticResource TableCellText}">
            <Setter Property="Foreground" Value="#FF888888"/>
        </Style>

        <!-- Status Badge -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <!-- Row Style -->
        <Style x:Key="JobRow" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2D2D2D"/>
                    <Setter Property="BorderBrush" Value="#40D19900"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#D19900" BlurRadius="6" ShadowDepth="0" Opacity="0.2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <!-- Main Container with Padding -->
    <Grid Background="#FF1E1E1E" Margin="10">

        <!-- Main Card -->
        <Border Background="#FF252525" 
                BorderBrush="#40D19900" 
                BorderThickness="1" 
                CornerRadius="6">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Toolbar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Table Header -->
                    <RowDefinition Height="*"/>
                    <!-- List -->
                </Grid.RowDefinitions>

                <!-- 1. Panel Header -->
                <Border Grid.Row="0" 
                        Background="#FF1E1E1E" 
                        Padding="15,12" 
                        BorderBrush="#40D19900" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="6,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="LightningBolt" 
                                                    Width="18" Height="18" 
                                                    Foreground="#D19900" 
                                                    Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Jobs Manager" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#FFE0E0E0"/>
                            <TextBlock Text="Create and manage multi-run jobs" 
                                       FontSize="10" Foreground="#FFAAAAAA"/>
                        </StackPanel>

                        <!-- Count Badge (Right Aligned in Header) -->
                        <Border Background="#FF2D2D2D" 
                                BorderBrush="#40D19900" 
                                BorderThickness="1"
                                CornerRadius="4" 
                                Padding="8,2" 
                                Margin="20,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding JobsCollection.Count}" 
                                       Foreground="#FFE0E0E0" 
                                       FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. Toolbar -->
                <Border Grid.Row="0" 
                        Background="#FF1E1E1E" 
                        Padding="10,8" 
                        BorderBrush="#40D19900" 
                        BorderThickness="0,0,0,1" Margin="589,0,0,36" Grid.RowSpan="3">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="NewJob" Style="{StaticResource StyledSuccessButton}" Width="80" Height="30">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="New" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="RemoveAll" Style="{StaticResource StyledDangerButton}" Width="95" Height="30" Margin="10 0 0 0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Remove All" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 3. Table Header -->
                <Grid Grid.Row="2" 
                      Background="#FF1E1E1E" 
                      Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <!-- # -->
                        <ColumnDefinition Width="85"/>
                        <!-- Status -->
                        <ColumnDefinition Width="*"/>
                        <!-- Config -->
                        <ColumnDefinition Width="80"/>
                        <!-- Proxies -->
                        <ColumnDefinition Width="45"/>
                        <!-- Bots -->
                        <ColumnDefinition Width="60"/>
                        <!-- CPM -->
                        <ColumnDefinition Width="110"/>
                        <!-- Progress -->
                        <ColumnDefinition Width="50"/>
                        <!-- Hits -->
                        <ColumnDefinition Width="60"/>
                        <!-- Custom -->
                        <ColumnDefinition Width="60"/>
                        <!-- To Check -->
                        <ColumnDefinition Width="*"/>
                        <!-- Data Pool -->
                        <ColumnDefinition Width="50"/>
                        <!-- Actions -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="#" Style="{StaticResource TableHeaderText}"/>
                    <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource TableHeaderText}"/>
                    <TextBlock Grid.Column="2" Text="Configuration" Style="{StaticResource TableHeaderText}"/>
                    <TextBlock Grid.Column="3" Text="Proxies" Style="{StaticResource TableHeaderText}"/>
                    <TextBlock Grid.Column="4" Text="Bots" Style="{StaticResource TableHeaderText}"/>
                    <TextBlock Grid.Column="5" Text="CPM" Style="{StaticResource TableHeaderText}"/>
                    <TextBlock Grid.Column="6" Text="Progress" Style="{StaticResource TableHeaderText}"/>
                    <TextBlock Grid.Column="7" Text="Hits" Style="{StaticResource TableHeaderText}" Foreground="#FF28A745"/>
                    <TextBlock Grid.Column="8" Text="Custom" Style="{StaticResource TableHeaderText}" Foreground="#FFFD7E14"/>
                    <TextBlock Grid.Column="9" Text="To Check" Style="{StaticResource TableHeaderText}" Foreground="#FF007ACC"/>
                    <TextBlock Grid.Column="10" Text="Data Pool" Style="{StaticResource TableHeaderText}"/>
                    <TextBlock Grid.Column="11" Text="" Style="{StaticResource TableHeaderText}"/>
                    <!-- Empty for actions -->
                </Grid>

                <!-- 4. Scrollable List -->
                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="#FF1A1A1A">
                    <ItemsControl ItemsSource="{Binding JobsCollection}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource JobRow}" 
                                        MouseLeftButtonDown="RowClick"
                                        Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ID -->
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" Style="{StaticResource MutedCellText}" TextAlignment="Center"/>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}">
                                            <Border.Background>
                                                <Binding Path="Status">
                                                    <Binding.Converter>
                                                        <local:StatusToBrushConverter/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Config Name -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding ConfigIcon}" 
                                                   Width="16" Height="16" 
                                                   Margin="0,0,8,0"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding ConfigIcon, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding ConfigName}" Style="{StaticResource TableCellText}" Margin="0"/>
                                        </StackPanel>

                                        <!-- Proxy Mode -->
                                        <Border Grid.Column="3" Background="#FF2D2D2D" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0">
                                            <TextBlock Text="{Binding ProxyMode}" Foreground="#FFAAAAAA" FontSize="10"/>
                                        </Border>

                                        <!-- Bots -->
                                        <TextBlock Grid.Column="4" Text="{Binding Bots}" Style="{StaticResource TableCellText}" TextAlignment="Center"/>

                                        <!-- CPM -->
                                        <TextBlock Grid.Column="5" Text="{Binding CPM}" Style="{StaticResource TableCellText}" TextAlignment="Center"/>

                                        <!-- Progress -->
                                        <TextBlock Grid.Column="6" Text="{Binding ProgressString}" Style="{StaticResource MutedCellText}" FontSize="11"/>

                                        <!-- Hits -->
                                        <TextBlock Grid.Column="7" Text="{Binding DataHits}" Foreground="#FF28A745" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Custom -->
                                        <TextBlock Grid.Column="8" Text="{Binding DataCustom}" Foreground="#FFFD7E14" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- To Check -->
                                        <TextBlock Grid.Column="9" Text="{Binding DataToCheck}" Foreground="#FF007ACC" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Data Pool -->
                                        <TextBlock Grid.Column="10" Text="{Binding DataPoolInfo}" Style="{StaticResource MutedCellText}" FontSize="11"/>

                                        <Button Grid.Column="11" 
        Background="Transparent" 
        BorderThickness="0" 
        Cursor="Hand"
        Click="ShowActionsMenu" 
        Tag="{Binding}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Width="24" Height="24">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="#FF888888"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <!-- Explicit base background -->
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#d19900"/>
                                                            <!-- ✅ Add background hover effect HERE -->
                                                            <Setter Property="Background" Value="#40D19900"/>
                                                            <!-- Semi-transparent gold -->
                                                            <!-- Optional: Add rounded corners -->
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="4">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <iconPacks:PackIconMaterial Kind="DotsVertical" Width="16" Height="16"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
