<Page x:Class="GoldenBullet.Views.Pages.ConfigReadme"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Pages"
      xmlns:uc="clr-namespace:GoldenBullet.Controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="Readme Editor"
      Background="#FF1E1E1E"
      Loaded="Page_Loaded">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- === Main Card Style === -->
        <Style x:Key="ReadmeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="20,10"/>
        </Style>

        <!-- === Editor Panel Style === -->
        <Style x:Key="EditorPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1,0,1,1"/>
            <Setter Property="CornerRadius" Value="0,0,12,12"/>
        </Style>

        <!-- === Toolbar Button Style === -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="10" Foreground="#FFE0E0E0" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33D19900"/>
                                <Setter Property="Foreground" Value="#FFD700"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55D19900"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- === RichTextBox Style === -->
        <Style x:Key="EditorRichTextBoxStyle" TargetType="RichTextBox">
            <Setter Property="Background" Value="#FF1A1A1A"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Consolas, Monaco, 'Courier New'"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Page.Resources>

    <Grid Background="#FF1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" MinHeight="180" MaxHeight="280"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOP: FULL PREVIEW ==================== -->
        <Border Grid.Row="0" Style="{StaticResource ReadmeCardStyle}" Margin="20,20,20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Preview Header -->
                <Border Grid.Row="0" Background="#FF2D2D2D" BorderThickness="0,0,0,1" BorderBrush="#40D19900" Padding="15,12" CornerRadius="12,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="EyeOutline" Width="18" Height="18" Foreground="#FF28A745" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Markdown Preview" FontSize="14" FontWeight="SemiBold" Foreground="#FFE0E0E0"/>
                            <TextBlock Text="Live rendering • Auto-sync enabled" FontSize="10" Foreground="#FFAAAAAA"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0">
                            <iconPacks:PackIconMaterial x:Name="PreviewStatusIcon" Kind="CheckCircleOutline" Width="14" Height="14" Foreground="#FF28A745" Margin="0,9,4,0"/>
                            <TextBlock x:Name="PreviewStatusText" Text="Synced" FontSize="10" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Markdown Viewer -->
                <Border Grid.Row="1" Background="#FF1A1A1A" CornerRadius="0,0,12,12" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <uc:MarkdownViewer 
                            x:Name="markdownViewer"
                            MarkdownText="{Binding Readme, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            Foreground="#FFE0E0E0"
                            FontSize="13"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== BOTTOM: COMPACT EDITOR ==================== -->
        <Border Grid.Row="1" Style="{StaticResource EditorPanelStyle}" Margin="20,0,20,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar Row 1: Formatting -->
                <Border Grid.Row="0" Background="#FF252525" Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="#40D19900">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Editor" FontSize="12" FontWeight="SemiBold" Foreground="#FFD700" Margin="0,0,0,0"/>

                        <!-- Bold & Italic (Fixed with CommandTarget) -->
                        <Button x:Name="BoldBtn" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Bold (Ctrl+B)" Tag="Bold" Click="BoldBtn_Click">
                            <iconPacks:PackIconMaterial Kind="FormatBold" Width="14" Height="14"/>
                        </Button>
                        <Button x:Name="ItalicBtn" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Italic (Ctrl+I)" Tag="Italic" Click="ItalicBtn_Click">
                            <iconPacks:PackIconMaterial Kind="FormatItalic" Width="14" Height="14"/>
                        </Button>

                        <Separator Background="#40D19900" Width="1" Margin="12,4"/>

                        <!-- Code Snippets -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Code Block" Tag="Code" Click="InsertCodeBlock_Click">
                            <iconPacks:PackIconMaterial Kind="CodeTags" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Inline Code" Tag="Inline" Click="InsertInlineCode_Click">
                            <iconPacks:PackIconMaterial Kind="CodeBraces" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Insert Image" Tag="Image" Click="InsertImage_Click">
                            <iconPacks:PackIconMaterial Kind="ImageOutline" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Insert Link" Tag="Link" Click="InsertLink_Click">
                            <iconPacks:PackIconMaterial Kind="Link" Width="14" Height="14"/>
                        </Button>

                        <Separator Background="#40D19900" Width="1" Margin="12,4"/>

                        <!-- Headers -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Heading 1" Tag="H1" Click="InsertH1_Click" FontSize="10" Padding="8,4">
                            <TextBlock Text="H1" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Heading 2" Tag="H2" Click="InsertH2_Click" FontSize="10" Padding="8,4">
                            <TextBlock Text="H2" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Heading 3" Tag="H3" Click="InsertH3_Click" FontSize="10" Padding="8,4">
                            <TextBlock Text="H3" FontWeight="Bold"/>
                        </Button>

                        <Separator Background="#40D19900" Width="1" Margin="12,4"/>

                        <!-- Lists & Quotes -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Bullet List" Tag="List" Click="InsertBulletList_Click" FontSize="10" Padding="8,4">
                            <TextBlock Text="• List"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Numbered List" Tag="NumList" Click="InsertNumberedList_Click" FontSize="10" Padding="8,4">
                            <TextBlock Text="1. List"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Quote" Tag="Quote" Click="InsertQuote_Click">
                            <iconPacks:PackIconMaterial Kind="FormatQuoteOpen" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Horizontal Rule" Tag="HR" Click="InsertHorizontalRule_Click">
                            <iconPacks:PackIconMaterial Kind="Minus" Width="14" Height="14"/>
                        </Button>

                        <!-- Spacer -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0">
                            <iconPacks:PackIconMaterial Kind="LanguageMarkdown" Width="14" Height="14" Foreground="#FFAAAAAA" Margin="0,6,4,0"/>
                            <TextBlock Text="Markdown" FontSize="10" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Editor Text Area -->
                <RichTextBox x:Name="readmeRTB" 
                             Grid.Row="1"
                             Style="{StaticResource EditorRichTextBoxStyle}"
                             TextChanged="ReadmeChanged"
                             PreviewKeyDown="RichTextBox_PreviewKeyDown">
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type Paragraph}">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="LineHeight" Value="18"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>

                <!-- Status Bar (No Action Buttons) -->
                <Border Grid.Row="2" Background="#FF252525" Padding="12,10" BorderThickness="0,1,0,0" BorderBrush="#40D19900">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CharCountText" Text="0 chars" FontSize="10" Foreground="#FFAAAAAA"/>
                            <TextBlock Text=" • " FontSize="10" Foreground="#FFAAAAAA"/>
                            <TextBlock x:Name="WordCountText" Text="0 words" FontSize="10" Foreground="#FFAAAAAA"/>
                        </StackPanel>

                        <Separator Background="#40D19900" Width="1" Margin="0,0,20,0" VerticalAlignment="Center"/>

                        <!-- Sync Status -->
                        <iconPacks:PackIconMaterial x:Name="FooterStatusIcon" Kind="CheckCircleOutline" Width="14" Height="14" Foreground="#FF28A745" Margin="0,0,4,0"/>
                        <TextBlock x:Name="FooterStatusText" Text="All changes saved" FontSize="10" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
