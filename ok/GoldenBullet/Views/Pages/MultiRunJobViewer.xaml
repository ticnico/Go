<Page x:Class="GoldenBullet.Views.Pages.MultiRunJobViewer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Pages"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1100"
      Title="MultiRunJobViewer">

    <Page.Resources>
        <!-- Filename Converter -->
        <local:FilenameConverter x:Key="FilenameConverter"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="CardBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
        <SolidColorBrush x:Key="ForegroundGood" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ForegroundBad" Color="#F44336"/>
        <SolidColorBrush x:Key="ForegroundCustom" Color="#FF9800"/>
        <SolidColorBrush x:Key="ForegroundRetry" Color="#FFEB3B"/>
        <SolidColorBrush x:Key="ForegroundBanned" Color="#9C27B0"/>
        <SolidColorBrush x:Key="ForegroundToCheck" Color="#00BCD4"/>
        <SolidColorBrush x:Key="ForegroundError" Color="#F44336"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5 8"/>
        </Style>

        <Style x:Key="StatLineStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0 3"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="2 0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonSuccessStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonWarningStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#F57F17"/>
            <Setter Property="BorderBrush" Value="#FBC02D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FBC02D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FDD835"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonDangerStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#B71C1C"/>
            <Setter Property="BorderBrush" Value="#C62828"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C62828"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonPrimaryStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#0D47A1"/>
            <Setter Property="BorderBrush" Value="#1565C0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="hitsContextMenu">
            <MenuItem Header="Copy Selected Data" Click="CopySelectedHits">
                <MenuItem.Icon>
                    <iconPacks:PackIconMaterial Kind="ContentCopy" Width="14" Height="14"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy Selected Proxy" Click="CopySelectedProxies">
                <MenuItem.Icon>
                    <iconPacks:PackIconMaterial Kind="ServerNetwork" Width="14" Height="14"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy Selected Data with Capture" Click="CopySelectedHitsCapture">
                <MenuItem.Icon>
                    <iconPacks:PackIconMaterial Kind="ContentDuplicate" Width="14" Height="14"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Send To Debugger" Click="SendToDebugger">
                <MenuItem.Icon>
                    <iconPacks:PackIconMaterial Kind="Bug" Width="14" Height="14"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Select All" Click="SelectAll">
                <MenuItem.Icon>
                    <iconPacks:PackIconMaterial Kind="SelectAll" Width="14" Height="14"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show Bot Log" Click="ShowBotLog">
                <MenuItem.Icon>
                    <iconPacks:PackIconMaterial Kind="FileDocument" Width="14" Height="14"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Page.Resources>

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Status -->
        <Grid Grid.Row="0" Margin="10 10 10 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Height="25">
                <Border Background="#333" CornerRadius="3" Padding="8 4" Margin="0 0 10 0">
                    <TextBlock Text="{Binding Job.Status}" Foreground="#FFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="txtJobTitle" Text="Core's job" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="MULTI RUN JOB" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="10 5 0 0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Label Content="{Binding RemainingWaitString}" VerticalAlignment="Center"
           Visibility="{Binding IsWaiting, Converter={StaticResource ResourceKey=BoolToVis}}" />
                <Label Content="Starting..." VerticalAlignment="Center"
           Visibility="{Binding IsStarting, Converter={StaticResource ResourceKey=BoolToVis}}" />
                <Label Content="Stopping..." VerticalAlignment="Center"
           Visibility="{Binding IsStopping, Converter={StaticResource ResourceKey=BoolToVis}}" />
                <Label Content="Pausing..." VerticalAlignment="Center"
           Visibility="{Binding IsPausing, Converter={StaticResource ResourceKey=BoolToVis}}" />

                <Button Click="Start" Visibility="{Binding CanStart, Converter={StaticResource ResourceKey=BoolToVis}}"
        Style="{StaticResource IconButtonSuccessStyle}" ToolTip="Start Job">
                    <iconPacks:PackIconFontAwesome Kind="PlaySolid" Width="16" Height="16" Foreground="White"/>
                </Button>
                <Button Click="Resume" Visibility="{Binding CanResume, Converter={StaticResource ResourceKey=BoolToVis}}"
        Style="{StaticResource IconButtonSuccessStyle}" ToolTip="Resume Job">
                    <iconPacks:PackIconFontAwesome Kind="PlaySolid" Width="16" Height="16" Foreground="White"/>
                </Button>
                <Button Click="Pause" Visibility="{Binding CanPause, Converter={StaticResource ResourceKey=BoolToVis}}"
        Style="{StaticResource IconButtonWarningStyle}" ToolTip="Pause Job">
                    <iconPacks:PackIconFontAwesome Kind="PauseSolid" Width="16" Height="16" Foreground="White"/>
                </Button>
                <Button Click="SkipWait" Visibility="{Binding CanSkipWait, Converter={StaticResource ResourceKey=BoolToVis}}"
        Style="{StaticResource IconButtonPrimaryStyle}" ToolTip="Skip Wait">
                    <iconPacks:PackIconFontAwesome Kind="ForwardSolid" Width="16" Height="16" Foreground="White"/>
                </Button>
                <Button Click="Stop" Visibility="{Binding CanStop, Converter={StaticResource ResourceKey=BoolToVis}}"
        Style="{StaticResource IconButtonDangerStyle}" ToolTip="Stop Job">
                    <iconPacks:PackIconFontAwesome Kind="StopSolid" Width="16" Height="16" Foreground="White"/>
                </Button>
                <Button Click="Abort" Visibility="{Binding CanAbort, Converter={StaticResource ResourceKey=BoolToVis}}"
        Style="{StaticResource IconButtonDangerStyle}" ToolTip="Abort Job">
                    <iconPacks:PackIconMaterial Kind="CloseThick" Width="18" Height="18" Foreground="White"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Click="GoBack" Style="{StaticResource IconButtonStyle}" ToolTip="Back" Margin="2 0 3 0">
                    <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="18" Height="18" Foreground="White"/>
                </Button>
                <Button Click="ChangeOptions" Style="{StaticResource IconButtonPrimaryStyle}" ToolTip="Edit Settings">
                    <iconPacks:PackIconRemixIcon Kind="Settings3Fill" Width="18" Height="18" Foreground="White"/>
                </Button>
            </StackPanel>
            
            
        </Grid>

        <!-- Stats Cards -->
        <Grid Grid.Row="1" Margin="5 0 5 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Data Stats -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Data stats" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>
                    <Grid Margin="0 25 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Tested: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.DataTested}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="0" Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Retried: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundRetry}"/>
                            <TextBlock Text="{Binding Job.DataRetried}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundRetry}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Hits: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundGood}"/>
                            <TextBlock Text="{Binding Job.DataHits}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundGood}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="1" Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Banned: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundBanned}"/>
                            <TextBlock Text="{Binding Job.DataBanned}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundBanned}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="2" Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Custom: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundCustom}"/>
                            <TextBlock Text="{Binding Job.DataCustom}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundCustom}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="2" Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="To check: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundToCheck}"/>
                            <TextBlock Text="{Binding Job.DataToCheck}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundToCheck}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="3" Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Fails: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundBad}"/>
                            <TextBlock Text="{Binding Job.DataFails}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundBad}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="3" Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Errors: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundError}"/>
                            <TextBlock Text="{Binding Job.DataErrors}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundError}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="4" Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Invalid: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundBad}"/>
                            <TextBlock Text="{Binding Job.DataInvalid}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundBad}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Proxy Stats -->
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Proxy stats" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>
                    <StackPanel Margin="0 25 0 0">
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Total: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.ProxiesTotal}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Alive: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundGood}"/>
                            <TextBlock Text="{Binding Job.ProxiesAlive}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundGood}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Banned: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundBanned}"/>
                            <TextBlock Text="{Binding Job.ProxiesBanned}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundBanned}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Bad: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundBad}"/>
                            <TextBlock Text="{Binding Job.ProxiesBad}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundBad}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Other Stats -->
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Other stats" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>
                    <StackPanel Margin="0 25 0 0">
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="CPM: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.CPM}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Captcha credit: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.CaptchaCredit}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Elapsed: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.ElapsedString}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Remaining: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.RemainingString}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Progress: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.ProgressString}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Job Options -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="10 0" Padding="1">
            <Grid>
                <TextBlock Text="Job options" FontWeight="Bold" FontSize="14" Margin="5 0 0 10"/>
                <UniformGrid Columns="5" Margin="0 25 0 0">
                    <!-- Config -->
                    <StackPanel Margin="5,5,-116,5">
                        <TextBlock Text="Config" Opacity="0.6" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="8" Padding="10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding ConfigIcon}" Width="45" Height="32" Margin="0 0 10 0" Stretch="Uniform"/>
                                <TextBlock Text="{Binding ConfigNameAndAuthor}" 
                       FontWeight="Bold" 
                       FontSize="12" 
                       VerticalAlignment="Center"
                       Foreground="White" Width="239"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Data Pool -->
                    <StackPanel Margin="132,5,-124,5">
                        <TextBlock Text="Data pool" Opacity="0.6" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="8" Padding="10" MinHeight="54">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataPoolInfo, Converter={StaticResource FilenameConverter}}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding Job.Skip, StringFormat='Skip {0}'}" Opacity="0.6" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Bots -->
                    <StackPanel Margin="138,5,-49,5">
                        <TextBlock Text="Bots" Opacity="0.6" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="8" Padding="10" MinHeight="54">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Job.Bots}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                <iconPacks:PackIconRemixIcon Kind="Edit2Fill" Width="15" Height="15" Margin="60 2 0 0" 
                                    Foreground="{DynamicResource ForegroundMain}" Opacity="0.6" Cursor="Hand" MouseDown="ChangeBots"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Use Proxies -->
                    <StackPanel Margin="60,5,5,5">
                        <TextBlock Text="Use proxies" Opacity="0.6" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="8" Padding="10" MinHeight="54">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Job.ProxyMode}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding ProxySourcesInfo}" Opacity="0.6" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Hit Outputs -->
                    <StackPanel Margin="5">
                        <TextBlock Text="Hit outputs" Opacity="0.6" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="8" Padding="10" MinHeight="54">
                            <TextBlock Text="{Binding HitOutputsInfo}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Job Controls & Progress -->
        <Grid Grid.Row="3" Margin="10,5,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Progress Bar with Controls -->
            <Grid Grid.Row="0" Margin="0 -5 0 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <Border Background="Transparent" CornerRadius="3" Padding="5" Grid.Column="0" Margin="0 0 5 0">
                    <Grid>
                        <ProgressBar Style="{StaticResource GlowingProgressBar}" Minimum="0" Maximum="100" Height="15" Value="{Binding Progress, Mode=OneWay}" 
                            Background="#333" Foreground="#D19900" BorderThickness="0" Margin="-5,0,-10,0" />
                        <TextBlock Text="{Binding Progress, StringFormat='{}{0:F2}%'}" HorizontalAlignment="Center" 
                            VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                    </Grid>
                </Border>

                

            </Grid>

            <!-- Bots and Hits -->
            <Grid Grid.Row="1" Margin="0 -5 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="313*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="222*"/>
                </Grid.ColumnDefinitions>

                <!-- Bots List View -->
                <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Bots" FontWeight="Bold" Margin="10" Grid.Row="0"/>
                        <ListView x:Name="botsListView" Grid.Row="1" Margin="10 0 10 10"
                                  Foreground="{DynamicResource ForegroundMain}"
                                  Background="Transparent"
                                  ItemsSource="{Binding BotsCollection}"
                                  SelectionMode="Extended"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.Resources>
                                <Style TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundMain}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                                <Grid>
                                                    <Border Background="Transparent" Padding="5">
                                                        <TextBlock Text="{TemplateBinding Content}"/>
                                                    </Border>
                                                    <Thumb x:Name="PART_HeaderGripper" 
                                                           HorizontalAlignment="Right" 
                                                           Width="1.5" 
                                                           Height="15"
                                                           Margin="0 0 5 0"
                                                           Cursor="SizeWE"
                                                           Background="Transparent"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                <Border Background="{TemplateBinding Background}" Padding="5">
                                                    <GridViewRowPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#333"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#444"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Resources>

                            <ListView.View>
                                <GridView AllowsColumnReorder="True">
                                    <GridViewColumn Width="40" Header="Id" DisplayMemberBinding="{Binding Id}" />
                                    <GridViewColumn Width="200" Header="Data" DisplayMemberBinding="{Binding Data}" />
                                    <GridViewColumn Width="150" Header="Proxy" DisplayMemberBinding="{Binding Proxy}" />
                                    <GridViewColumn Width="1000" Header="Info" DisplayMemberBinding="{Binding Info}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Background="Transparent" ResizeBehavior="PreviousAndNext" Margin="1,0,8,0"/>

                <!-- Hits -->
                <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Hits" FontWeight="Bold" Margin="10" Grid.Row="0"/>

                        <ListView x:Name="hitsListView" Grid.Row="1" Margin="10 0" 
                                  Foreground="{DynamicResource ForegroundMain}"
                                  Background="Transparent"
                                  ItemsSource="{Binding HitsCollection}"
                                  SelectionMode="Extended"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.Resources>
                                <Style TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundMain}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                                <Grid>
                                                    <Border Background="Transparent" Padding="5">
                                                        <TextBlock Text="{TemplateBinding Content}"/>
                                                    </Border>
                                                    <Thumb x:Name="PART_HeaderGripper" 
                                                           HorizontalAlignment="Right" 
                                                           Width="1.5" 
                                                           Height="15"
                                                           Margin="0 0 5 0"
                                                           Cursor="SizeWE"
                                                           Background="Transparent"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <EventSetter Event="MouseRightButtonDown" Handler="LVIRightClick"/>
                                    <Setter Property="ContextMenu" Value="{StaticResource hitsContextMenu}"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                <Border Background="{TemplateBinding Background}" Padding="5">
                                                    <GridViewRowPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#333"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#444"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Resources>

                            <ListView.View>
                                <GridView AllowsColumnReorder="True">
                                    <GridViewColumn Header="Time" DisplayMemberBinding="{Binding Time}" Width="60"/>
                                    <GridViewColumn Header="Data" DisplayMemberBinding="{Binding Data}" Width="120"/>
                                    <GridViewColumn Header="Proxy" DisplayMemberBinding="{Binding Proxy}" Width="100"/>
                                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="80"/>
                                    <GridViewColumn Header="Capture" DisplayMemberBinding="{Binding Capture}" Width="1000"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <ComboBox Grid.Row="2" Margin="10" ItemsSource="{Binding HitsFilters}" SelectedValue="{Binding HitsFilter}" Style="{StaticResource RoundedComboBox}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
