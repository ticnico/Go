<Page x:Class="GoldenBullet.Views.Pages.NFTokenCheckerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:controls="clr-namespace:GoldenBullet.Controls"
      mc:Ignorable="d"
      d:DesignHeight="750"
      d:DesignWidth="1200"
      Title="Netflix Cookie Checker"
      Background="#0A0A0A">

    <Page.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        

        <!-- Color Palette -->
        <Color x:Key="BgPrimary">#0A0A0A</Color>
        <Color x:Key="BgSecondary">#161616</Color>
        <Color x:Key="BgTertiary">#1E1E1E</Color>
        <Color x:Key="BorderSubtle">#2A2A2A</Color>
        <Color x:Key="BorderFocus">#444444</Color>
        <Color x:Key="TextPrimary">#FFFFFF</Color>
        <Color x:Key="TextSecondary">#B0B0B0</Color>
        <Color x:Key="TextMuted">#707070</Color>
        <Color x:Key="AccentPrimary">#E50914</Color>
        <Color x:Key="AccentHover">#F6121D</Color>
        <Color x:Key="Success">#00C853</Color>
        <Color x:Key="Error">#FF5252</Color>
        <Color x:Key="Warning">#FFB300</Color>
        <Color x:Key="Info">#29B6F6</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimary}"/>
        <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondary}"/>
        <SolidColorBrush x:Key="BgTertiaryBrush" Color="{StaticResource BgTertiary}"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/>
        <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocus}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
        <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
        <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>

        <!-- Card Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/>
        <DropShadowEffect x:Key="AccentGlow" Color="{StaticResource AccentPrimary}" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>

        <!-- Base Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgTertiaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Stat Card Style -->
        <Style x:Key="StatCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- Section Header -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Section Label -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Stat Row -->
        <Style x:Key="StatRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>




        <!-- Icon Button Base -->
        <Style x:Key="IconButtonBase" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Buttons -->

        <!-- Modern ProgressBar -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
            <Setter Property="Foreground" Value="#D19900"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- DataGrid Styles -->
        <Style x:Key="ModernDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ModernDataGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E5091422"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                
            </Style.Triggers>
        </Style>

        <!-- TabControl Modernization -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" 
                                Background="Transparent" 
                                CornerRadius="3"
                                Margin="2,0">
                            <ContentPresenter ContentSource="Header" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BorderSubtleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Badge -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- HEADER: Title + Action Buttons + Status                     -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" 
        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="Netflix" 
                                   Width="22" Height="22" 
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="NETFLIX TOKEN CHECKER" 
                       FontSize="15" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
                    <TextBlock Text="• NFToken Validation Engine" 
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,1"/>
                </StackPanel>

                <!-- Status Badge -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="STATUS" Style="{StaticResource SectionLabelStyle}" 
                       HorizontalAlignment="Center"/>
                    <Border x:Name="StatusBadge" Style="{StaticResource StatusBadge}"
                    Background="{StaticResource WarningBrush}">
                        <TextBlock x:Name="StatusLabel" Text="READY" 
                           FontSize="10" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartStopButton" 
                    Style="{StaticResource StyledSuccessButton}" 
                    Click="StartStopButton_Click"
                    ToolTip="Start Validation"
                    Width="38" Height="38" Margin="0,0,3,0">
                        <iconPacks:PackIconMaterial x:Name="StartStopIcon" 
                                       Kind="Play" 
                                       Width="14" Height="14" 
                                       Foreground="White"/>
                    </Button>

                    <Button Style="{StaticResource StyledPrimaryButton}" Click="ClearAll_Click" Width="38" Height="38" Margin="0,0,3,0">
                        <iconPacks:PackIconMaterial Kind="Delete" 
                                            Width="14" Height="14" 
                                            Foreground="White"/>
                    </Button>

                    <Button Style="{StaticResource StyledEditButton}" Click="ExportResults_Click" Width="38" Height="38" Margin="0,0,3,0">
                        <iconPacks:PackIconMaterial Kind="Export" Width="14" Height="14" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- STATS CARDS: Metrics Overview                               -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Loaded -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="TOTAL LOADED" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="TotalCountLabel" Text="0" 
                       FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,4,0,0"/>
                    <TextBlock Text="cookies/tokens" 
                       Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                </StackPanel>
            </Border>

            <!-- Checked -->
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="CHECKED" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="CheckedCountLabel" Text="0" 
                       FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,4,0,0"/>
                    <ProgressBar x:Name="MiniProgress" Style="{StaticResource ModernProgressBar}"
                         Margin="0,6,0,0" Value="0"/>
                </StackPanel>
            </Border>

            <!-- Valid Hits -->
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="VALID HITS" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="ValidCountLabel" Text="0" 
                       FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource SuccessBrush}"
                       Margin="0,4,0,0"/>
                    <TextBlock x:Name="SuccessRateLabel" Text="0% success" 
                       Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                </StackPanel>
            </Border>

            <!-- Invalid -->
            <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="INVALID" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="InvalidCountLabel" Text="0" 
                       FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource ErrorBrush}"
                       Margin="0,4,0,0"/>
                    <TextBlock Text="failed checks" 
                       Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                </StackPanel>
            </Border>

            <!-- Proxies -->
            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="PROXIES" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="ProxyCountLabel" Text="0" 
                       FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource InfoBrush}"
                       Margin="0,4,0,0"/>
                    <TextBlock Text="from database" 
                       Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- CONFIGURATION BAR (Updated with Proxy Support)             -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="16,0,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Input Path -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="INPUT SOURCE" Style="{StaticResource SectionLabelStyle}"/>
                    <Grid>
                        <TextBox x:Name="InputPathTextBox" Style="{StaticResource RoundedTextBox}"
                         Height="38" Margin="0,0,80,0" IsReadOnly="True"
                         Text="Click Browse to select file or folder..."/>
                        <Button Content="Browse" Style="{StaticResource StyledEditButton}" Width="70"
                        HorizontalAlignment="Right" Click="BrowseInput_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Input Type -->
                <StackPanel Grid.Column="1" Margin="8,0">
                    <TextBlock Text="INPUT TYPE" Style="{StaticResource SectionLabelStyle}"/>
                    <ComboBox x:Name="InputTypeCombo" Style="{StaticResource RoundedComboBox}"
                      Height="38" SelectionChanged="InputTypeCombo_SelectionChanged">
                        <ComboBoxItem Content="📄 Single File" Tag="File" IsSelected="True"/>
                        <ComboBoxItem Content="📁 Folder Scan" Tag="Folder"/>
                    </ComboBox>
                </StackPanel>

                <!-- Proxy Group Selector -->
                <StackPanel Grid.Column="2" Margin="8,0">
                    <TextBlock Text="PROXY GROUP" Style="{StaticResource SectionLabelStyle}"/>
                    <ComboBox x:Name="ProxyGroupCombo" Style="{StaticResource RoundedComboBox}"
                      Height="38" SelectionChanged="ProxyGroupCombo_SelectionChanged"
                      DropDownOpened="ProxyGroupCombo_DropDownOpened">
                        <ComboBoxItem Content="-- Select group --" Tag="{x:Null}" IsSelected="True"/>
                        <ComboBoxItem Content="All" Tag="ALL" Foreground="{StaticResource TextMutedBrush}"/>
                    </ComboBox>
                </StackPanel>

                <!-- Threads -->
                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                    <TextBlock Text="CONCURRENCY" Style="{StaticResource SectionLabelStyle}"/>
                    <mah:NumericUpDown x:Name="ThreadsNumericUpDown" 
                               Style="{DynamicResource RoundedNumericUpDown}"
                               Value="100" Minimum="1" Maximum="500"
                               Height="38" Foreground="{StaticResource TextPrimaryBrush}"
                               mah:ControlsHelper.CornerRadius="8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT: Input Panel + Results                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Progress Bar Strip -->
            <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" 
                    CornerRadius="8" Padding="16,10" Margin="0,0,0,8">
                <Grid>
                    <ProgressBar x:Name="ProgressBar" Style="{StaticResource ModernProgressBar}"
                                 Value="0" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressLabel" Text="Awaiting start..." 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Two-Column Layout -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

               

                <!-- ═════ RIGHT PANEL: Results & Log ═════ -->
                <Grid Grid.Column="1" Margin="8,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <!-- Results DataGrid -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Results DataGrid Header with Filter -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="✅ VALIDATION RESULTS" Style="{StaticResource SectionHeaderStyle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox x:Name="FilterCombo" Width="120" Height="30" FontSize="10"
                  Style="{StaticResource RoundedComboBox}"
                  SelectedIndex="0">
                                        <ComboBoxItem Content="All Results"/>
                                        <ComboBoxItem Content="Valid Only"/>
                                        <ComboBoxItem Content="Invalid Only"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- DataGrid -->
                            <DataGrid x:Name="ResultsGrid" Grid.Row="1"
                                      AutoGenerateColumns="False" 
                                      Background="Transparent" 
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      GridLinesVisibility="Horizontal" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                                      BorderThickness="0" RowHeight="42"
                                      HeadersVisibility="Column" 
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                      CellStyle="{StaticResource ModernDataGridCell}">
                                <DataGrid.Columns>
                                    <!-- Status with Badge -->
                                    <DataGridTemplateColumn Header="STATUS" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusBadge}"
                                                        Background="{Binding StatusColor}">
                                                    <TextBlock Text="{Binding Status}" 
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="#1A1A1A"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="220"/>
                                    <DataGridTextColumn Header="PLAN" Binding="{Binding Plan}" Width="120"/>
                                    <DataGridTextColumn Header="COUNTRY" Binding="{Binding Country}" Width="90"/>
                                    <DataGridTextColumn Header="RENEWAL" Binding="{Binding Renewal}" Width="105"/>

                                    <!-- Action Buttons -->
                                    <DataGridTemplateColumn Header="LAUNCH" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button ToolTip="Open in PC Browser" 
                                                            Width="38" Height="30" Margin="2,0"
                                                            Background="#238636" Foreground="White"
                                                            BorderThickness="0" Cursor="Hand"
                                                            mah:ControlsHelper.CornerRadius="6"
                                                            Click="OpenLink_Click" Tag="{Binding LinkPC}">
                                                        <iconPacks:PackIconMaterial Kind="Monitor" 
                                                                                       Width="12" Height="12"/>
                                                    </Button>
                                                    <Button ToolTip="Open in Mobile View" 
                                                            Width="38" Height="30" Margin="2,0"
                                                            Background="#1f6feb" Foreground="White"
                                                            BorderThickness="0" Cursor="Hand"
                                                            mah:ControlsHelper.CornerRadius="6"
                                                            Click="OpenLink_Click" Tag="{Binding LinkMobile}">
                                                        <iconPacks:PackIconMaterial Kind="Cellphone" 
                                                                                       Width="12" Height="12"/>
                                                    </Button>
                                                    <Button ToolTip="Open in TV Interface" 
                                                            Width="38" Height="30" Margin="2,0"
                                                            Background="{StaticResource AccentPrimaryBrush}" 
                                                            Foreground="White" BorderThickness="0" Cursor="Hand"
                                                            mah:ControlsHelper.CornerRadius="6"
                                                            Click="OpenLink_Click" Tag="{Binding LinkTV}">
                                                        <iconPacks:PackIconMaterial Kind="Television" 
                                                                                       Width="12" Height="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
