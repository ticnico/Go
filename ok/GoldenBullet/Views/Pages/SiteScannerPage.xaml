<Page x:Class="GoldenBullet.Views.Pages.SiteScannerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Background="#FF1E1E1E">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ScannerCard" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,20,20,20">

            <!-- Header -->
            <Border Style="{StaticResource ScannerCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconMaterial Grid.Column="0" 
                                                Kind="ShieldSearch" 
                                                Width="40" Height="40" 
                                                Foreground="#D19900"
                                                VerticalAlignment="Center"
                                                Margin="0,0,15,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Site Security Scanner" 
                                   Foreground="#FFE0E0E0" 
                                   FontSize="20" 
                                   FontWeight="Bold"/>
                        <TextBlock Text="Analyze WAF, captcha and security headers — no external APIs required" 
                                   Foreground="#FFAAAAAA" 
                                   FontSize="12"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" 
                            Content="🔍 Scan" 
                            Style="{StaticResource StyledSuccessButton}"
                            Padding="25,12"
                            FontSize="14"
                            Click="ScanButton_Click"
                            x:Name="ScanBtn"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Target URL Input -->
            <Border Style="{StaticResource ScannerCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                   Text="Target URL:" 
                   Foreground="#FFAAAAAA" 
                   FontSize="13" 
                   VerticalAlignment="Center"
                   Margin="0,0,15,0"/>

                    <!-- Wrap the TextBox in a Grid to overlay the placeholder text -->
                    <Grid Grid.Column="1">
                        <TextBox x:Name="txtTargetURL" 
                     Text=""
                     Style="{StaticResource RoundedTextBox}"
                     FontSize="14"
                     Padding="12,10"/>

                        <!-- Placeholder Text -->
                        <TextBlock Text="URL ..." 
                       Foreground="Gray" 
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"
                       FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <!-- Show the placeholder only when the TextBox is completely empty -->
                                        <DataTrigger Binding="{Binding Text, ElementName=txtTargetURL}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- Status Bar (Hidden until scan) -->
            <Border x:Name="StatusBar" 
                    Style="{StaticResource ScannerCard}" 
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Status:" Style="{StaticResource StatusLabel}"/>
                        <TextBlock x:Name="txtStatus" Text="—" Style="{StaticResource StatusValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Time:" Style="{StaticResource StatusLabel}"/>
                        <TextBlock x:Name="txtTime" Text="—" Style="{StaticResource StatusValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Protocol:" Style="{StaticResource StatusLabel}"/>
                        <TextBlock x:Name="txtProtocol" Text="—" Style="{StaticResource StatusValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Final URL:" Style="{StaticResource StatusLabel}"/>
                        <TextBlock x:Name="txtFinalURL" Text="—" 
                                   Style="{StaticResource StatusValue}" 
                                   TextWrapping="Wrap"
                                   FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detection & Security Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Detection Card -->
                <Border Grid.Column="0" Style="{StaticResource ScannerCard}" Margin="0,0,7,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <iconPacks:PackIconMaterial Kind="Magnify" 
                                                        Width="18" Height="18" 
                                                        Foreground="#D19900"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Detection" 
                                       Foreground="#FFE0E0E0" 
                                       FontSize="16" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="WAF / Protection" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="txtWAF" Text="None detected" Foreground="#FFAAAAAA"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Challenge" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                            <Border x:Name="ChallengeBorder" Grid.Column="1" Background="#2F5738" CornerRadius="4" Padding="10,5">
                                <TextBlock x:Name="txtChallenge" Text="None" Foreground="#FFE0E0E0"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Security Grade:" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                            <Border x:Name="GradeBadge" Grid.Column="1" Background="#7A552A" CornerRadius="4" Padding="12,6">
                                <TextBlock x:Name="txtSecurityGrade" Text="—" Foreground="White" FontWeight="Bold" FontSize="16"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Security Tools Card -->
                <Border Grid.Column="1" Style="{StaticResource ScannerCard}" Margin="7,0,0,15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <iconPacks:PackIconMaterial Kind="ShieldLock" 
                                                            Width="18" Height="18" 
                                                            Foreground="#D19900"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"/>
                                <TextBlock Text="Security Tools Detected" 
                                           Foreground="#FFE0E0E0" 
                                           FontSize="16" 
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Application Security -->
                            <TextBlock Text="Application Security" Foreground="#D19900" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <CheckBox x:Name="chkJscrambler" Content="Jscrambler" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkArxan" Content="Arxan" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkApproov" Content="Approov" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkGuardSquare" Content="GuardSquare" Margin="0,3" IsEnabled="False"/>

                            <!-- Bot Protection -->
                            <TextBlock Text="Bot Protection" Foreground="#D19900" FontWeight="SemiBold" Margin="0,12,0,8"/>
                            <CheckBox x:Name="chkDataDome" Content="DataDome" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkPerimeterX" Content="PerimeterX / BotGuard" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkShapeSecurity" Content="Shape Security" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkKasada" Content="Kasada" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkDistil" Content="Distil Networks" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkRadware" Content="Radware Bot Manager" Margin="0,3" IsEnabled="False"/>

                            <!-- CAPTCHA Services -->
                            <TextBlock Text="CAPTCHA Services" Foreground="#D19900" FontWeight="SemiBold" Margin="0,12,0,8"/>
                            <CheckBox x:Name="chkReCAPTCHAv2" Content="reCAPTCHA v2" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkReCAPTCHAv3" Content="reCAPTCHA v3" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkReCAPTCHAEnt" Content="reCAPTCHA Enterprise" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkHCaptcha" Content="hCaptcha" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkCloudflare" Content="Cloudflare Turnstile" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkFunCaptcha" Content="FunCaptcha / Arkose" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkGeeTest" Content="GeeTest" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkTextImage" Content="Text / Image CAPTCHA" Margin="0,3" IsEnabled="False"/>

                            <!-- WAF / Firewall -->
                            <TextBlock Text="WAF / Firewall" Foreground="#D19900" FontWeight="SemiBold" Margin="0,12,0,8"/>
                            <CheckBox x:Name="chkAkamai" Content="Akamai" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkImperva" Content="Imperva Incapsula" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkF5" Content="F5 Advanced WAF" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkBarracuda" Content="Barracuda WAF" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkCitrix" Content="Citrix ADC" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkFortiWeb" Content="FortiWeb" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkModSecurity" Content="ModSecurity" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkSucuri" Content="Sucuri" Margin="0,3" IsEnabled="False"/>
                            <CheckBox x:Name="chkWordfence" Content="Wordfence" Margin="0,3" IsEnabled="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Security Headers -->
            <Border Style="{StaticResource ScannerCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Lock" 
                                                        Width="18" Height="18" 
                                                        Foreground="#D19900"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Security Headers" 
                                       Foreground="#FFE0E0E0" 
                                       FontSize="16" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="txtScore" Text="(score —/100)" Foreground="#FFAAAAAA"/>
                    </Grid>

                    <StackPanel x:Name="SecurityHeadersPanel">
                        <!-- Headers will be added dynamically -->
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Raw Response Headers -->
            <Border Style="{StaticResource ScannerCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <iconPacks:PackIconMaterial Kind="FileDocumentOutline" 
                                                    Width="18" Height="18" 
                                                    Foreground="#D19900"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                        <TextBlock Text="Raw Response Headers" 
                                   Foreground="#FFE0E0E0" 
                                   FontSize="16" 
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <TextBox x:Name="txtRawHeaders" 
                             Style="{StaticResource RoundedTextBoxWarp}"
                             FontFamily="Consolas" 
                             FontSize="12"
                             Height="300"
                             IsReadOnly="True"
                             Text="No scan performed yet..."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
