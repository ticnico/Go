<Page x:Class="GoldenBullet.Views.Pages.ConfigLoliCode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Pages"
      xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="780"
      Title="LoliCode"
      KeyDown="PageKeyDown"
      Background="#FF1E1E1E">

    <Page.Resources>
        <!-- Toolbar Button Style (Matches Reference) -->
        <Style x:Key="CodeActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40D19900"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#D19900" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1A1A1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel Header Style -->
        <Style x:Key="PanelHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
        </Style>

        <!-- Editor Container Style -->
        <Style x:Key="EditorContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </Page.Resources>

    <Grid Background="#FF1E1E1E" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Usings Panel -->
            <RowDefinition Height="Auto"/>
            <!-- Startup Panel -->
            <RowDefinition Height="*"/>
            <!-- Main Editor -->
        </Grid.RowDefinitions>

        <!-- 1. TOOLBAR -->
        <Border Grid.Row="0" 
                Background="#FF252525" 
                BorderBrush="#40D19900" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="10,8" 
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Click="ToggleUsings" Style="{StaticResource CodeActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconRadixIcons Kind="ActivityLog" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Toggle Usings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="ToggleStartup" Style="{StaticResource CodeActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconRadixIcons Kind="Code" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Toggle Startup LoliCode" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. USINGS PANEL (Collapsible) -->
        <Border Grid.Row="1" 
                x:Name="usingsContainer" 
                Style="{StaticResource EditorContainerStyle}" 
                Margin="0,0,0,10" 
                Visibility="Collapsed"
                Height="120">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CodeBraces" Width="16" Height="16" Foreground="#D19900" Margin="0,0,8,0"/>
                        <TextBlock Text="Using Statements" FontSize="12" FontWeight="SemiBold" Foreground="#FFE0E0E0"/>
                    </StackPanel>
                </Border>

                <!-- Content -->
                <TextBox x:Name="usingsTextBox"
                         Grid.Row="1"
                         Background="#FF1A1A1A"
                         Foreground="#FFE0E0E0"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         AcceptsReturn="True"
                         IsReadOnly="False"
                         VerticalContentAlignment="Top"
                         Padding="10"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding UsingsString}"/>
            </Grid>
        </Border>

        <!-- 3. STARTUP EDITOR PANEL (Collapsible) -->
        <Border Grid.Row="2" 
                x:Name="startupEditorContainer" 
                Style="{StaticResource EditorContainerStyle}" 
                Margin="0,0,0,10" 
                Visibility="Collapsed"
                Height="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="LanguagePython" Width="16" Height="16" Foreground="#FFFD7E14" Margin="0,0,8,0"/>
                        <TextBlock Text="Startup LoliCode" FontSize="12" FontWeight="SemiBold" Foreground="#FFE0E0E0"/>
                    </StackPanel>
                </Border>

                <!-- Content -->
                <avalonEdit:TextEditor Grid.Row="1"
                                       x:Name="startupEditor"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="#FFE0E0E0"
                                       Background="#FF1A1A1A"
                                       LostFocus="EditorLostFocus"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       ShowLineNumbers="True"
                                       WordWrap="{Binding WordWrap}"
                                       LineNumbersForeground="#FF555555">
                    <avalonEdit:TextEditor.Options>
                        <avalonEdit:TextEditorOptions ShowBoxForControlCharacters="False"/>
                    </avalonEdit:TextEditor.Options>
                </avalonEdit:TextEditor>
            </Grid>
        </Border>

        <!-- 4. MAIN EDITOR -->
        <Border Grid.Row="3" 
                Style="{StaticResource EditorContainerStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CodeTags" Width="16" Height="16" Foreground="#FF28A745" Margin="0,0,8,0"/>
                        <TextBlock Text="Main LoliCode Logic" FontSize="12" FontWeight="SemiBold" Foreground="#FFE0E0E0"/>
                    </StackPanel>
                </Border>

                <!-- Content -->
                <avalonEdit:TextEditor Grid.Row="1"
                                       x:Name="editor"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="#FFE0E0E0"
                                       Background="#FF1A1A1A"
                                       LostFocus="EditorLostFocus"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       ShowLineNumbers="True"
                                       WordWrap="{Binding WordWrap}"
                                       LineNumbersForeground="#FF555555">
                    <avalonEdit:TextEditor.Options>
                        <avalonEdit:TextEditorOptions ShowBoxForControlCharacters="False"/>
                    </avalonEdit:TextEditor.Options>
                </avalonEdit:TextEditor>
            </Grid>
        </Border>
    </Grid>
</Page>
