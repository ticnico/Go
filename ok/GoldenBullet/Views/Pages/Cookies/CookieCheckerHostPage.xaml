<Page x:Class="GoldenBullet.Views.Pages.Cookies.CookieCheckerHostPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1100"
      Title="Cookie Checker"
      Background="#FF121212">

    <Page.Resources>
        
    </Page.Resources>

    <Grid Background="#FF121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Checker Selector -->
        <Border Grid.Row="0" 
                Background="#FF252525" 
                BorderBrush="#80D19900" 
                BorderThickness="0,0,0,1"
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Cookie" 
                                               Width="22" Height="22" 
                                               Foreground="#D19900"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Cookie Checker" 
                               FontSize="16" FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" | Select Checker:" 
                               FontSize="12" 
                               Opacity="0.6"
                               VerticalAlignment="Center" 
                               Foreground="#AAA"
                               Margin="15,0,10,0"/>
                    <ComboBox x:Name="CheckerComboBox"
                              Style="{StaticResource RoundedComboBox}"
                              SelectionChanged="CheckerComboBox_SelectionChanged">
                        <ComboBoxItem Content="Netflix Cookie" Tag="NetflixCookie" IsSelected="True"/>
                        <ComboBoxItem Content="NF Token Checker" Tag="NFTokenChecker"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Frame -->
        <Border Grid.Row="1" Background="#FF121212">
            <Frame x:Name="ContentFrame"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Border>
    </Grid>
</Page>
