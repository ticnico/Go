<Page x:Class="GoldenBullet.Views.Pages.ConfigEditor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Pages"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Config Editor"
      Background="Black"
      MinWidth="900">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Background="#FF1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="650" MinWidth="600"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT PANEL: EDITOR ==================== -->
        <Border Grid.Column="0" Background="#FF252525" BorderBrush="#40D19900" BorderThickness="1" CornerRadius="8" Margin="5,5,5,5">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="auto"/>
                    <!-- Editor Content -->
                    <RowDefinition Height="*"/>
                    <!-- Mode Switcher Toolbar -->
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <!-- Panel Header -->
                <Border Grid.Row="0" Background="#FF1E1E1E" Padding="15,5,15,5" BorderBrush="#40D19900" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CodeBraces" Width="20" Height="20" Foreground="#D19900" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Config Editor" FontSize="14" FontWeight="SemiBold" Foreground="#FFE0E0E0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Editor Frame Container -->
                <Border Grid.Row="1" Background="#FF1A1A1A">
                    <Frame x:Name="editorFrame" 
                           NavigationUIVisibility="Hidden"
                           Background="Transparent"/>
                </Border>

                <!-- Mode Switcher Toolbar -->
                <Border Grid.Row="2" Background="#FF1E1E1E" Padding="10,8" BorderBrush="#40D19900" BorderThickness="0,1,0,0">
                    <DockPanel HorizontalAlignment="Stretch">
                        <Button Click="OpenStacker"
                                x:Name="stackerButton"
                                Style="{StaticResource StyledPrimaryButton}"
                                DockPanel.Dock="Left"
                                Margin="5,0,5,0"
                                Width="90">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="LayerGroupSolid" Width="14" Height="14"/>
                                <TextBlock Text="Stacker" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Click="OpenLoliCode"
                                x:Name="loliCodeButton"
                                Style="{StaticResource StyledEditButton}"
                                DockPanel.Dock="Left"
                                Width="90"
                                Margin="5,0,5,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconEntypo Kind="Code" Width="14" Height="14"/>
                                <TextBlock Text="LoliCode" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Click="OpenCSharpCode"
                                x:Name="cSharpButton"
                                Style="{StaticResource StyledWarningButton}"
                                DockPanel.Dock="Left"
                                Margin="5,0,5,0"
                                Width="60">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconEntypo Kind="Code" Width="14" Height="14"/>
                                <TextBlock Text="C#" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Click="Save" 
                                Style="{StaticResource StyledSuccessButton}"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                Width="75">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconRemixIcon Kind="Save3Fill" Width="14" Height="14"/>
                                <TextBlock Text="Save" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== GRID SPLITTER (Standard WPF) ==================== -->
        <GridSplitter 
            Grid.Column="1"
            Width="5"
            VerticalAlignment="Stretch"
            Background="#FF2D2D2D"
            BorderBrush="#40D19900"
            BorderThickness="1,0,1,0"
            Cursor="SizeWE"
            Margin="0,5,0,5">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <Rectangle Width="1" Height="30" Fill="#FF3C3C3C" VerticalAlignment="Center" RadiusX="1" RadiusY="1"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- ==================== RIGHT PANEL: DEBUGGER ==================== -->
        <Border Grid.Column="2" Background="#FF252525" BorderBrush="#40D19900" BorderThickness="1" CornerRadius="8" Margin="5,5,5,5">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="auto"/>
                    <!-- Debugger Content -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Panel Header -->
                <Border Grid.Row="0" Background="#FF1E1E1E" Padding="15,5,15,5" BorderBrush="#40D19900" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="BugOutline" Width="20" Height="20" Foreground="#FFDC3545" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Debugger" FontSize="14" FontWeight="SemiBold" Foreground="#FFE0E0E0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Debugger Frame Container -->
                <Border Grid.Row="1" Background="#FF1A1A1A">
                    <Frame x:Name="debuggerFrame" 
                           NavigationUIVisibility="Hidden"
                           Background="Transparent"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
