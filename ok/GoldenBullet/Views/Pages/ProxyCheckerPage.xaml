<Page x:Class="GoldenBullet.Views.Pages.ProxyCheckerPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:local="clr-namespace:GoldenBullet.Views.Pages"
xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
xmlns:controls="clr-namespace:GoldenBullet.Controls"
mc:Ignorable="d"
d:DesignHeight="650" d:DesignWidth="1100"
Title="ProxyCheckJobViewer"
Background="#FF121212">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="CardBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
        <SolidColorBrush x:Key="ForegroundGood" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ForegroundBad" Color="#F44336"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="StatLineStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0 3"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="2 0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonSuccessStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
        </Style>
        <Style x:Key="IconButtonWarningStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#F57F17"/>
            <Setter Property="BorderBrush" Value="#FBC02D"/>
        </Style>
        <Style x:Key="IconButtonDangerStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#B71C1C"/>
            <Setter Property="BorderBrush" Value="#C62828"/>
        </Style>
        <Style x:Key="IconButtonPrimaryStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#0D47A1"/>
            <Setter Property="BorderBrush" Value="#1565C0"/>
        </Style>
    </Page.Resources>

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="10 10 10 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="PROXY CHECK JOB" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0 8 0 0"/>
                <TextBlock Text=" | Configure and run proxy checks" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Foreground="#AAA"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="GoBack" Style="{StaticResource IconButtonStyle}" ToolTip="Back" Margin="0 0 5 0">
                    <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="18" Height="18" Foreground="White"/>
                </Button>
                <Button Click="ChangeOptions" Style="{StaticResource IconButtonPrimaryStyle}" ToolTip="Edit Settings">
                    <iconPacks:PackIconMaterial Kind="Cog" Width="18" Height="18" Foreground="White"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Stats Cards -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Proxy stats" FontWeight="Bold" FontSize="14" Margin="0 0 0 10" Foreground="White"/>
                    <StackPanel Margin="0 25 0 0">
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Total: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="TotalLabel" Text="0" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Tested: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="TestedLabel" Text="0" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Working: " Foreground="{StaticResource ForegroundGood}" FontSize="12"/>
                            <TextBlock x:Name="WorkingLabel" Text="0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundGood}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Not working: " Foreground="{StaticResource ForegroundBad}" FontSize="12"/>
                            <TextBlock x:Name="NotWorkingLabel" Text="0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundBad}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Other stats" FontWeight="Bold" FontSize="14" Margin="0 0 0 10" Foreground="White"/>
                    <StackPanel Margin="0 25 0 0">
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="CPM: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="CpmLabel" Text="0" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Elapsed: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="ElapsedLabel" Text="00:00:00" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Remaining: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="RemainingLabel" Text="∞" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Progress: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="ProgressPercentLabel" Text="0%" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Job Options (Display Only - Edit via Dialog) -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="10 5" Padding="15">
            <Grid>
                <TextBlock Text="Job settings" FontWeight="Bold" FontSize="14" Margin="0 0 0 10" Foreground="White"/>
                <UniformGrid Columns="5" Margin="0 25 0 0">
                    <StackPanel Margin="5">
                        <TextBlock Text="Target" Foreground="#AAA" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="3" Padding="10" MinHeight="54">
                            <TextBlock x:Name="TargetUrlLabel" Text="Not set" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Success key" Foreground="#AAA" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="3" Padding="10" MinHeight="54">
                            <TextBlock x:Name="SuccessKeyLabel" Text="None" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Bots" Foreground="#AAA" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="3" Padding="10" MinHeight="54">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="BotsLabel" Text="10" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Timeout (ms)" Foreground="#AAA" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="3" Padding="10" MinHeight="54">
                            <TextBlock x:Name="TimeoutLabel" Text="10000" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Check only untested" Foreground="#AAA" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="3" Padding="10" MinHeight="54">
                            <TextBlock x:Name="CheckUntestedLabel" Text="False" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Controls & Progress -->
        <Grid Grid.Row="3" Margin="10,5,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0 0 0 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="#252525" CornerRadius="3" Padding="5" Grid.Column="0" Margin="0 0 5 0">
                    <Grid>
                        <ProgressBar x:Name="MainProgressBar" Minimum="0" Maximum="100" Height="24" Value="0" Background="#333" Foreground="#4CAF50" BorderThickness="0"/>
                        <TextBlock x:Name="ProgressBarText" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="White"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="StartButton" Click="OnStart" Style="{StaticResource IconButtonSuccessStyle}" ToolTip="Start">
                        <iconPacks:PackIconFontAwesome Kind="PlaySolid" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button x:Name="ResumeButton" Click="OnResume" Style="{StaticResource IconButtonSuccessStyle}" ToolTip="Resume" Visibility="Collapsed">
                        <iconPacks:PackIconFontAwesome Kind="PlaySolid" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button x:Name="PauseButton" Click="OnPause" Style="{StaticResource IconButtonWarningStyle}" ToolTip="Pause" Visibility="Collapsed">
                        <iconPacks:PackIconFontAwesome Kind="PauseSolid" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button x:Name="StopButton" Click="OnStop" Style="{StaticResource IconButtonDangerStyle}" ToolTip="Stop" Visibility="Collapsed">
                        <iconPacks:PackIconFontAwesome Kind="StopSolid" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button x:Name="AbortButton" Click="OnAbort" Style="{StaticResource IconButtonDangerStyle}" ToolTip="Abort" Visibility="Collapsed">
                        <iconPacks:PackIconMaterial Kind="CloseThick" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Log" FontWeight="Bold" Margin="10" Grid.Row="0" Foreground="White"/>
                    <controls:ColoredLog Grid.Row="1" x:Name="jobLog" Margin="10 0 10 10"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
