<Page x:Class="GoldenBullet.Views.Pages.ProxyCheckJobViewer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Pages"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:controls="clr-namespace:GoldenBullet.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1100"
      Title="ProxyCheckJobViewer">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="CardBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
        <SolidColorBrush x:Key="ForegroundGood" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ForegroundBad" Color="#F44336"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="StatLineStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0 3"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="2 0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonSuccessStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonWarningStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#F57F17"/>
            <Setter Property="BorderBrush" Value="#FBC02D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FBC02D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FDD835"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonDangerStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#B71C1C"/>
            <Setter Property="BorderBrush" Value="#C62828"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C62828"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonPrimaryStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#0D47A1"/>
            <Setter Property="BorderBrush" Value="#1565C0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Status -->
        <Grid Grid.Row="0" Margin="10 10 10 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Background="#333" CornerRadius="3" Padding="8 4" Margin="0 0 10 0">
                    <TextBlock Text="{Binding Job.Status}" Foreground="#FFF" FontWeight="Bold" FontSize="12"/>
                </Border>
                <TextBlock Text="admin's job" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="PROXY CHECK JOB" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="10 5 0 0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Click="GoBack" Style="{StaticResource IconButtonStyle}" ToolTip="Back" Margin="0 0 5 0">
                    <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="18" Height="18" Foreground="White"/>
                </Button>
                <Button Click="ChangeOptions" Style="{StaticResource IconButtonPrimaryStyle}" ToolTip="Edit Settings">
                    <iconPacks:PackIconMaterial Kind="Cog" Width="18" Height="18" Foreground="White"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Stats Cards -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Proxy Stats -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Proxy stats" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>
                    <StackPanel Margin="0 25 0 0">
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Total: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.Total}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Tested: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.Tested}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Working: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundGood}"/>
                            <TextBlock Text="{Binding Job.Working}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundGood}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Not working: " Opacity="0.8" FontSize="12" Foreground="{StaticResource ForegroundBad}"/>
                            <TextBlock Text="{Binding Job.NotWorking}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundBad}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Other Stats -->
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Other stats" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>
                    <StackPanel Margin="0 25 0 0">
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="CPM: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.CPM}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Elapsed: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.ElapsedString}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Remaining: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.RemainingString}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Progress: " Opacity="0.8" FontSize="12"/>
                            <TextBlock Text="{Binding Job.ProgressString}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Job Options -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="10 5" Padding="15">
            <Grid>
                <TextBlock Text="Job options" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>
                <UniformGrid Columns="5" Margin="0 25 0 0">
                    <!-- Target -->
                    <StackPanel Margin="5">
                        <TextBlock Text="Target" Opacity="0.6" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="3" Padding="10" MinHeight="54">
                            <TextBlock Text="{Binding Job.Url}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>

                    <!-- Success Key -->
                    <StackPanel Margin="5">
                        <TextBlock Text="Success key" Opacity="0.6" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="3" Padding="10" MinHeight="54">
                            <TextBlock Text="{Binding Job.SuccessKey}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Bots -->
                    <StackPanel Margin="5">
                        <TextBlock Text="Bots" Opacity="0.6" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="3" Padding="10" MinHeight="54">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Job.Bots}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                <iconPacks:PackIconMaterial Kind="Pencil" Width="15" Height="15" Margin="10 2 0 0" 
                                    Foreground="{DynamicResource ForegroundMain}" Opacity="0.6" Cursor="Hand" MouseDown="ChangeBots"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Timeout -->
                    <StackPanel Margin="5">
                        <TextBlock Text="Timeout (ms)" Opacity="0.6" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="3" Padding="10" MinHeight="54">
                            <TextBlock Text="{Binding Job.TimeoutMilliseconds}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Check only untested -->
                    <StackPanel Margin="5">
                        <TextBlock Text="Check only untested" Opacity="0.6" FontSize="11" Margin="0 0 0 5"/>
                        <Border Background="#252525" CornerRadius="3" Padding="10" MinHeight="54">
                            <TextBlock Text="{Binding Job.CheckOnlyUntested}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Job Controls & Progress -->
        <Grid Grid.Row="3" Margin="10,5,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Progress Bar with Controls -->
            <Grid Grid.Row="0" Margin="0 0 0 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="#252525" CornerRadius="3" Padding="5" Grid.Column="0" Margin="0 0 5 0">
                    <Grid>
                        <ProgressBar Minimum="0" Maximum="100" Height="24" Value="{Binding Progress, Mode=OneWay}" 
                            Background="#333" Foreground="#4CAF50" BorderThickness="0"/>
                        <TextBlock Text="{Binding Progress, StringFormat='{}{0:F2}%'}" HorizontalAlignment="Center" 
                            VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Label Content="{Binding RemainingWaitString}" VerticalAlignment="Center"
                           Visibility="{Binding IsWaiting, Converter={StaticResource ResourceKey=BoolToVis}}" />
                    <Label Content="Stopping..." VerticalAlignment="Center"
                           Visibility="{Binding IsStopping, Converter={StaticResource ResourceKey=BoolToVis}}" />
                    <Label Content="Pausing..." VerticalAlignment="Center"
                           Visibility="{Binding IsPausing, Converter={StaticResource ResourceKey=BoolToVis}}" />

                    <Button Click="Start" Visibility="{Binding CanStart, Converter={StaticResource ResourceKey=BoolToVis}}"
                        Style="{StaticResource IconButtonSuccessStyle}" ToolTip="Start Job">
                        <iconPacks:PackIconFontAwesome Kind="PlaySolid" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button Click="Resume" Visibility="{Binding CanResume, Converter={StaticResource ResourceKey=BoolToVis}}"
                        Style="{StaticResource IconButtonSuccessStyle}" ToolTip="Resume Job">
                        <iconPacks:PackIconFontAwesome Kind="PlaySolid" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button Click="Pause" Visibility="{Binding CanPause, Converter={StaticResource ResourceKey=BoolToVis}}"
                        Style="{StaticResource IconButtonWarningStyle}" ToolTip="Pause Job">
                        <iconPacks:PackIconFontAwesome Kind="PauseSolid" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button Click="SkipWait" Visibility="{Binding CanSkipWait, Converter={StaticResource ResourceKey=BoolToVis}}"
                        Style="{StaticResource IconButtonPrimaryStyle}" ToolTip="Skip Wait">
                        <iconPacks:PackIconFontAwesome Kind="ForwardSolid" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button Click="Stop" Visibility="{Binding CanStop, Converter={StaticResource ResourceKey=BoolToVis}}"
                        Style="{StaticResource IconButtonDangerStyle}" ToolTip="Stop Job">
                        <iconPacks:PackIconFontAwesome Kind="StopSolid" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button Click="Abort" Visibility="{Binding CanAbort, Converter={StaticResource ResourceKey=BoolToVis}}"
                        Style="{StaticResource IconButtonDangerStyle}" ToolTip="Abort Job">
                        <iconPacks:PackIconMaterial Kind="CloseThick" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Log -->
            <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Log" FontWeight="Bold" Margin="10" Grid.Row="0"/>
                    <controls:ColoredLog Grid.Row="1" x:Name="jobLog" Margin="10 0 10 10"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
