<Page x:Class="GoldenBullet.Views.Pages.ConfigSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Pages"
      xmlns:uc="clr-namespace:GoldenBullet.Controls"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:resources="clr-namespace:RuriLib.Models.Data.Resources.Options;assembly=RuriLib"
      xmlns:rules="clr-namespace:RuriLib.Models.Data.Rules;assembly=RuriLib"
      mc:Ignorable="d" 
      d:DesignHeight="2750" d:DesignWidth="800"
      Title="Config Settings"
      Background="#FF1E1E1E"
      MinWidth="900">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Section Card Style -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Section Title Style -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Setting Row Style -->
        <Style x:Key="SettingRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,8,0,12"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Multiline TextBox Style -->
        <Style x:Key="SettingMultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
            <Setter Property="Height" Value="100"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,12"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="RoundedComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Numeric UpDown Style -->
        <Style x:Key="SettingNumericStyle" TargetType="mah:NumericUpDown" BasedOn="{StaticResource {x:Type mah:NumericUpDown}}">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- List Item Card Style -->
        <Style x:Key="SettingListItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#40D19900"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- List Item Label Style -->
        <Style x:Key="ListItemLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>

        <!-- Hint Text Style -->
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="FormButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40D19900"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#D19900" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1A1A1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Button (Green) -->
        <Style x:Key="FormSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource FormButtonStyle}">
            <Setter Property="Background" Value="#FF28A745"/>
            <Setter Property="BorderBrush" Value="#FF1E7E34"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF218838"/>
                    <Setter Property="BorderBrush" Value="#FF19692C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF1E7E34"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#FF1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Border Grid.Row="0" Background="#FF1E1E1E" Padding="20,20,20,15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <iconPacks:PackIconMaterial Kind="Cog" Width="24" Height="24" Foreground="#D19900" Margin="0,0,10,0"/>
                    <TextBlock Text="Config Settings" FontSize="20" FontWeight="Bold" Foreground="#FFE0E0E0"/>
                </StackPanel>
                <TextBlock Text="Configure bot behavior, proxy handling, data rules, and browser automation."
                           Foreground="#FFAAAAAA" FontSize="12" TextWrapping="Wrap" MaxWidth="700"/>
            </StackPanel>
        </Border>

        <!-- Scrollable Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,20">
            <StackPanel>

                <!-- ==================== GENERAL SECTION ==================== -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <!-- Section Header -->
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <iconPacks:PackIconMaterial Kind="CogOutline" Width="20" Height="20" Foreground="#D19900" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="General"/>
                        </StackPanel>

                        <!-- Suggested Bots -->
                        <StackPanel Style="{StaticResource SettingRowStyle}">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Suggested amount of bots:"/>
                            <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                  Minimum="1" Maximum="1000" Interval="1"
                                  Value="{Binding SuggestedBots}"/>
                        </StackPanel>

                        <!-- Maximum CPM -->
                        <StackPanel Style="{StaticResource SettingRowStyle}">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Maximum CPM (0 to disable):"/>
                            <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                  Minimum="0" Maximum="1000000" Interval="1"
                                  Value="{Binding MaximumCPM}"/>
                        </StackPanel>

                        <!-- Save Empty Captures -->
                        <CheckBox Style="{StaticResource RoundedCheckBox}"
                                  Content="Save empty captures" Margin="0 0 0 5"
                                  IsChecked="{Binding SaveEmptyCaptures}"/>

                        <!-- Report Last Captcha on Retry -->
                        <CheckBox Style="{StaticResource RoundedCheckBox}"
                                  Content="Report last captcha if bot ends with RETRY status"
                                  IsChecked="{Binding ReportLastCaptchaOnRetry}"/>

                        <!-- Continue Statuses -->
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Continue on these statuses:" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Bot will continue processing when ending with selected statuses"/>
                            <uc:MultipleSelector SelectedValues="{Binding ContinueStatuses, Mode=TwoWay}"
                                                 PossibleValues="{Binding AllStatuses}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== PROXIES SECTION ==================== -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <!-- Section Header -->
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <iconPacks:PackIconMaterial Kind="Server" Width="20" Height="20" Foreground="#D19900" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Proxies"/>
                        </StackPanel>

                        <!-- Use Proxies -->
                        <CheckBox Style="{StaticResource RoundedCheckBox}"
                                  Content="Use proxies"
                                  IsChecked="{Binding UseProxies}"/>

                        <!-- Max Uses Per Proxy -->
                        <StackPanel Style="{StaticResource SettingRowStyle}">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Max uses before proxy ban (0=disable):"/>
                            <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                  Minimum="0" Maximum="1000000" Interval="1"
                                  Value="{Binding MaxUsesPerProxy}"/>
                        </StackPanel>

                        <!-- Ban Loop Evasion -->
                        <StackPanel Style="{StaticResource SettingRowStyle}">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Ban loop evasion retries (0=disable):"/>
                            <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                  Minimum="0" Maximum="1000000" Interval="1"
                                  Value="{Binding BanLoopEvasion}"/>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource HintTextStyle}" Text="Retries before marking data as ToCheck" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Proxy Ban Statuses -->
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Ban proxy on these statuses:" Margin="0,0,0,8"/>
                            <uc:MultipleSelector SelectedValues="{Binding ProxyBanStatuses, Mode=TwoWay}"
                                                 PossibleValues="{Binding AllStatuses}"/>
                        </StackPanel>

                        <!-- Allowed Proxy Types -->
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Allowed proxy types:" Margin="0,0,0,8"/>
                            <uc:MultipleSelector SelectedValues="{Binding AllowedProxyTypes, Mode=TwoWay}"
                                                 PossibleValues="{Binding ProxyTypes}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== DATA SECTION ==================== -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <!-- Section Header -->
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <iconPacks:PackIconMaterial Kind="Database" Width="20" Height="20" Foreground="#D19900" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Data"/>
                        </StackPanel>

                        <!-- Allowed Wordlist Types -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Allowed wordlist types:" Margin="0,0,0,8"/>
                            <uc:MultipleSelector SelectedValues="{Binding AllowedWordlistTypes, Mode=TwoWay}"
                                                 PossibleValues="{Binding WordlistTypes}"/>
                        </StackPanel>

                        <!-- URL Encode After Slicing -->
                        <CheckBox Style="{StaticResource RoundedCheckBox}"
                                  Content="URL encode data after slicing"
                                  IsChecked="{Binding UrlEncodeDataAfterSlicing}"/>

                        <!-- Rules Section -->
                        <StackPanel Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <iconPacks:PackIconMaterial Kind="Filter" Width="16" Height="16" Foreground="#D19900" Margin="0,0,6,0"/>
                                <TextBlock Text="Data Rules" FontSize="13" FontWeight="SemiBold" Foreground="#FFE0E0E0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Click="AddSimpleDataRule" Style="{StaticResource StyledSuccessButton}" Cursor="Hand" Width="90" Height="32" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="14" Height="14"/>
                                        <TextBlock Text="Simple" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="AddRegexDataRule" Style="{StaticResource StyledSuccessButton}" Cursor="Hand" Width="80" Height="32">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="14" Height="14"/>
                                        <TextBlock Text="Regex" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding DataRulesCollection}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Resources>
                                    <!-- SimpleDataRule Template -->
                                    <DataTemplate DataType="{x:Type rules:SimpleDataRule}">
                                        <Border Style="{StaticResource SettingListItemStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Style="{StaticResource ListItemLabelStyle}" Text="Slice:"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource RoundedTextBox}" 
                                                         Text="{Binding SliceName}" Margin="0,0,8,0" Height="30"/>

                                                <ComboBox Grid.Column="2" Style="{StaticResource RoundedComboBox}"
                                                          ItemsSource="{Binding DataContext.StringRules, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding Comparison}" Width="100" Margin="0,0,8,0" Height="30"/>

                                                <TextBox Grid.Column="3" Style="{StaticResource RoundedTextBox}" 
                                                         Text="{Binding StringToCompare}" Margin="0,0,8,0" Height="30"/>

                                                <CheckBox Grid.Column="4" Style="{StaticResource RoundedCheckBox}"
                                                          Content="Case" IsChecked="{Binding CaseSensitive}" Margin="0,0,4,0" FontSize="11"/>
                                                <CheckBox Grid.Column="5" Style="{StaticResource RoundedCheckBox}"
                                                          Content="Invert" IsChecked="{Binding Invert}" Margin="0,0,8,0" FontSize="11"/>

                                                <Button Grid.Column="6" Tag="{Binding}" Click="RemoveDataRule" 
                                                        Style="{StaticResource StyledDangerButton}" Cursor="Hand"
                                                        Width="30" Height="30" ToolTip="Remove rule">
                                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>

                                    <!-- RegexDataRule Template -->
                                    <DataTemplate DataType="{x:Type rules:RegexDataRule}">
                                        <Border Style="{StaticResource SettingListItemStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Style="{StaticResource ListItemLabelStyle}" Text="Slice:"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource RoundedTextBox}" 
                                                         Text="{Binding SliceName}" Margin="0,0,8,0" Height="30"/>

                                                <TextBlock Grid.Column="2" Style="{StaticResource ListItemLabelStyle}" Text="Regex:"/>
                                                <TextBox Grid.Column="3" Style="{StaticResource RoundedTextBox}" 
                                                         Text="{Binding RegexToMatch}" Margin="0,0,8,0" Height="30"/>

                                                <CheckBox Grid.Column="4" Style="{StaticResource RoundedCheckBox}"
                                                          Content="Invert" IsChecked="{Binding Invert}" Margin="0,0,8,0" FontSize="11"/>

                                                <Button Grid.Column="5" Tag="{Binding}" Click="RemoveDataRule" 
                                                        Style="{StaticResource StyledDangerButton}" Cursor="Hand"
                                                        Width="30" Height="30" ToolTip="Remove rule">
                                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>

                            <!-- Test Rules Section -->
                            <Border Background="#FF2D2D2D" BorderBrush="#40D19900" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingLabelStyle}" Text="Test data:" MinWidth="80"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource RoundedTextBox}" 
                                             Text="{Binding TestDataForRules}" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource RoundedComboBox}"
                                              ItemsSource="{Binding WordlistTypes}" 
                                              SelectedValue="{Binding TestWordlistTypeForRules}" 
                                              Width="120" Margin="0,0,8,0"/>
                                    <Button Grid.Column="3" Click="TestDataRules" Style="{StaticResource StyledPrimaryButton}" 
                                            Cursor="Hand" Width="75" Height="34">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBoxIcons Kind="RegularTestTube" Width="14" Height="14"/>
                                            <TextBlock Text="Test" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Resources Section -->
                        <StackPanel Margin="0,24,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <iconPacks:PackIconMaterial Kind="Folder" Width="16" Height="16" Foreground="#D19900" Margin="0,0,6,0"/>
                                <TextBlock Text="Resources" FontSize="13" FontWeight="SemiBold" Foreground="#FFE0E0E0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Click="AddLinesFromFileResource" Style="{StaticResource StyledSuccessButton}" Cursor="Hand" Width="130" Height="32" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="14" Height="14"/>
                                        <TextBlock Text="Lines from file" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="AddRandomLinesFromFileResource" Style="{StaticResource StyledSuccessButton}" Cursor="Hand" Width="170" Height="32">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="14" Height="14"/>
                                        <TextBlock Text="Random lines" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding ResourcesCollection}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Resources>
                                    <!-- LinesFromFileResource Template -->
                                    <DataTemplate DataType="{x:Type resources:LinesFromFileResourceOptions}">
                                        <Border Style="{StaticResource SettingListItemStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Style="{StaticResource ListItemLabelStyle}" Text="Name:"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource RoundedTextBox}" 
                                                         Text="{Binding Name}" Margin="0,0,8,0" Height="30"/>

                                                <TextBlock Grid.Column="2" Style="{StaticResource ListItemLabelStyle}" Text="Location:"/>
                                                <TextBox Grid.Column="3" Style="{StaticResource RoundedTextBox}" 
                                                         Text="{Binding Location}" Margin="0,0,8,0" Height="30"/>

                                                <CheckBox Grid.Column="4" Style="{StaticResource RoundedCheckBox}"
                                                          Content="Loop" IsChecked="{Binding LoopsAround}" Margin="0,0,4,0" FontSize="11"/>
                                                <CheckBox Grid.Column="5" Style="{StaticResource RoundedCheckBox}"
                                                          Content="No empty" IsChecked="{Binding IgnoreEmptyLines}" Margin="0,0,8,0" FontSize="11"/>

                                                <Button Grid.Column="6" Tag="{Binding}" Click="RemoveResource" 
                                                        Style="{StaticResource StyledDangerButton}" Cursor="Hand"
                                                        Width="30" Height="30" ToolTip="Remove resource">
                                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>

                                    <!-- RandomLinesFromFileResource Template -->
                                    <DataTemplate DataType="{x:Type resources:RandomLinesFromFileResourceOptions}">
                                        <Border Style="{StaticResource SettingListItemStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Style="{StaticResource ListItemLabelStyle}" Text="Name:"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource RoundedTextBox}" 
                                                         Text="{Binding Name}" Margin="0,0,8,0" Height="30"/>

                                                <TextBlock Grid.Column="2" Style="{StaticResource ListItemLabelStyle}" Text="Location:"/>
                                                <TextBox Grid.Column="3" Style="{StaticResource RoundedTextBox}" 
                                                         Text="{Binding Location}" Margin="0,0,8,0" Height="30"/>

                                                <CheckBox Grid.Column="4" Style="{StaticResource RoundedCheckBox}"
                                                          Content="Unique" IsChecked="{Binding Unique}" Margin="0,0,4,0" FontSize="11"/>
                                                <CheckBox Grid.Column="5" Style="{StaticResource RoundedCheckBox}"
                                                          Content="No empty" IsChecked="{Binding IgnoreEmptyLines}" Margin="0,0,8,0" FontSize="11"/>

                                                <Button Grid.Column="6" Tag="{Binding}" Click="RemoveResource" 
                                                        Style="{StaticResource StyledDangerButton}" Cursor="Hand"
                                                        Width="30" Height="30" ToolTip="Remove resource">
                                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== INPUTS SECTION ==================== -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <!-- Section Header -->
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <iconPacks:PackIconMaterial Kind="KeyboardOutline" Width="20" Height="20" Foreground="#D19900" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Inputs"/>
                        </StackPanel>

                        <!-- Custom Inputs -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <iconPacks:PackIconMaterial Kind="FormTextbox" Width="16" Height="16" Foreground="#D19900" Margin="0,0,6,0"/>
                                <TextBlock Text="Custom Inputs" FontSize="13" FontWeight="SemiBold" Foreground="#FFE0E0E0"/>
                            </StackPanel>

                            <Button x:Name="addCustomInputButton" Click="AddCustomInput" 
                                    Style="{StaticResource StyledSuccessButton}" Cursor="Hand"
                                    Width="75" Height="32" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterialDesign Kind="Add" Width="14" Height="14"/>
                                    <TextBlock Text="Add" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <ItemsControl x:Name="customInputsControl" ItemsSource="{Binding CustomInputsCollection}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingListItemStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Style="{StaticResource ListItemLabelStyle}" Text="Desc:"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource RoundedTextBox}" 
                                                         Text="{Binding Description}" Margin="0,0,8,0" Height="30"/>

                                                <TextBlock Grid.Column="2" Style="{StaticResource ListItemLabelStyle}" Text="Variable:"/>
                                                <TextBox Grid.Column="3" Style="{StaticResource RoundedTextBox}" 
                                                         Text="{Binding VariableName}" Margin="0,0,8,0" Height="30"/>

                                                <TextBlock Grid.Column="4" Style="{StaticResource ListItemLabelStyle}" Text="Default:"/>
                                                <TextBox Grid.Column="5" Style="{StaticResource RoundedTextBox}" 
                                                         Text="{Binding DefaultAnswer}" Margin="0,0,8,0" Height="30"/>

                                                <Button Grid.Column="6" Tag="{Binding}" Click="RemoveCustomInput" 
                                                        Style="{StaticResource StyledDangerButton}" Cursor="Hand"
                                                        Width="30" Height="30" ToolTip="Remove input">
                                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== BROWSER SECTION ==================== -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <!-- Section Header -->
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <iconPacks:PackIconMaterial Kind="Web" Width="20" Height="20" Foreground="#D19900" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Browser"/>
                        </StackPanel>

                        <!-- Automation Engine -->
                        <StackPanel Style="{StaticResource SettingRowStyle}">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Automation engine:"/>
                            <ComboBox Style="{StaticResource RoundedComboBox}"
                                      ItemsSource="{Binding BrowserAutomationEngines}"
                                      SelectedValue="{Binding Path=SelectedBrowserAutomationEngine}"
                                      Width="180"/>
                        </StackPanel>

                        <!-- Mouse Automation -->
                        <StackPanel Style="{StaticResource SettingRowStyle}">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Mouse automation:"/>
                            <ComboBox Style="{StaticResource RoundedComboBox}"
                                      ItemsSource="{Binding BrowserMouseAutomationModes}"
                                      SelectedValue="{Binding Path=SelectedBrowserMouseAutomationMode}"
                                      Width="180"/>
                        </StackPanel>

                        <!-- Quit Browser Statuses -->
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Quit browser on these statuses:" Margin="0,0,0,8"/>
                            <uc:MultipleSelector SelectedValues="{Binding QuitBrowserStatuses, Mode=TwoWay}"
                                                 PossibleValues="{Binding AllStatuses}"/>
                        </StackPanel>

                        <!-- Headless Mode -->
                        <CheckBox Style="{StaticResource RoundedCheckBox}" Margin="0,8,0,5"
                                  Content="Headless mode"
                                  IsChecked="{Binding Headless}"/>

                        <!-- Load Only Document and Script -->
                        <CheckBox Style="{StaticResource RoundedCheckBox}" Margin="0,0,0,5"
                                  Content="Load only document and script"
                                  IsChecked="{Binding LoadOnlyDocumentAndScript}"/>

                        <!-- Dismiss Dialogs -->
                        <CheckBox Style="{StaticResource RoundedCheckBox}" Margin="0,0,0,5"
                                  Content="Dismiss dialogs"
                                  IsChecked="{Binding DismissDialogs}"/>

                        <!-- Ignore HTTPS Errors -->
                        <CheckBox Style="{StaticResource RoundedCheckBox}" Margin="0,0,0,5"
                                  Content="Ignore HTTPS errors"
                                  IsChecked="{Binding IgnoreHttpsErrors}"/>

                        <!-- Command Line Arguments -->
                        <StackPanel Style="{StaticResource SettingRowStyle}" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Command line args:"/>
                            <TextBox Style="{StaticResource RoundedTextBox}"
                                     Text="{Binding CommandLineArgs}" Width="300"/>
                        </StackPanel>

                        <!-- Blocked URLs -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Blocked URLs:" Margin="0,0,0,5"/>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="One URL per line"/>
                            <TextBox x:Name="blockedUrlsTextBox" 
                                     Style="{StaticResource SettingMultilineTextBoxStyle}"
                                     TextChanged="BlockedUrlsChanged"/>
                        </StackPanel>

                        <!-- Ghost Cursor Section -->
                        <StackPanel Visibility="{Binding IsGhostCursorMouseAutomationSelected, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <iconPacks:PackIconMaterial Kind="CursorDefaultOutline" Width="16" Height="16" Foreground="#D19900" Margin="0,0,6,0"/>
                                <TextBlock Text="Ghost Cursor" FontSize="13" FontWeight="SemiBold" Foreground="#FFE0E0E0"/>
                            </StackPanel>
                            
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="These settings affect generic browser clicks, cursor movement, and scrolling when Ghost Cursor is selected." Margin="0,0,0,12"/>

                            <!-- Moving -->
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Moving" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#FFD19900"/>
                            
                            <StackPanel Style="{StaticResource SettingRowStyle}">
                                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Move speed:"/>
                                <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                      Minimum="0" Maximum="1000000" Interval="1"
                                      Value="{Binding GhostCursorMoveSpeed}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Higher values produce denser and faster paths. Leave empty or use 0 for Ghost Cursor automatic speed."/>

                            <StackPanel Style="{StaticResource SettingRowStyle}">
                                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Move delay (ms):"/>
                                <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                      Minimum="0" Maximum="1000000" Interval="1"
                                      IsEnabled="{Binding IsGhostCursorMoveDelayEnabled}"
                                      Value="{Binding GhostCursorMoveDelay}"/>
                                <CheckBox Style="{StaticResource RoundedCheckBox}" Margin="15,0,0,0"
                                          Content="Randomize move delay"
                                          IsChecked="{Binding GhostCursorRandomizeMoveDelay}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Empty uses Ghost Cursor defaults. Move delay is disabled when randomization is enabled."/>

                            <StackPanel Style="{StaticResource SettingRowStyle}">
                                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Delay per step (ms):"/>
                                <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                      Minimum="0" Maximum="1000000" Interval="1"
                                      Value="{Binding GhostCursorDelayPerStep}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Extra delay between generated points. Default: 0 ms."/>

                            <StackPanel Style="{StaticResource SettingRowStyle}">
                                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Max retries:"/>
                                <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                      Minimum="0" Maximum="1000000" Interval="1"
                                      Value="{Binding GhostCursorMaxTries}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Reacquire attempts if the target moves. Default: 10."/>

                            <StackPanel Style="{StaticResource SettingRowStyle}">
                                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Overshoot threshold:"/>
                                <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                      Minimum="0" Maximum="1000000" Interval="1"
                                      Value="{Binding GhostCursorOvershootThreshold}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Distance in pixels before overshoot correction kicks in. Default: 500."/>

                            <!-- Clicking -->
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Clicking" Margin="0,16,0,8" FontWeight="SemiBold" Foreground="#FFD19900"/>

                            <StackPanel Style="{StaticResource SettingRowStyle}">
                                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Hesitate before click (ms):"/>
                                <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                      Minimum="0" Maximum="1000000" Interval="1"
                                      Value="{Binding GhostCursorHesitate}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Delay before pressing the mouse button. Default: 0 ms."/>

                            <StackPanel Style="{StaticResource SettingRowStyle}">
                                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Wait for click (ms):"/>
                                <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                      Minimum="0" Maximum="1000000" Interval="1"
                                      Value="{Binding GhostCursorWaitForClick}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Delay between mouse down and mouse up. Default: 0 ms."/>

                            <!-- Scrolling -->
                            <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Scrolling" Margin="0,16,0,8" FontWeight="SemiBold" Foreground="#FFD19900"/>

                            <StackPanel Style="{StaticResource SettingRowStyle}">
                                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Scroll speed:"/>
                                <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                      Minimum="0" Maximum="100" Interval="1"
                                      Value="{Binding GhostCursorScrollSpeed}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Range: 0-100. 100 is effectively instant and is also the default."/>

                            <StackPanel Style="{StaticResource SettingRowStyle}">
                                <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Scroll delay (ms):"/>
                                <mah:NumericUpDown Style="{StaticResource SettingNumericStyle}"
                                      Minimum="0" Maximum="1000000" Interval="1"
                                      Value="{Binding GhostCursorScrollDelay}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Delay after scroll actions. Default: 0 ms."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Bar -->
        <Border Grid.Row="2" Background="#FF252525" BorderBrush="#40D19900" BorderThickness="1" CornerRadius="8" Padding="15,12" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Settings are saved with the config file" 
                           Foreground="#FF666666" FontSize="11" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Click="Cancel_Click" Style="{StaticResource FormButtonStyle}" Width="90">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                            <TextBlock Text="Cancel" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Save_Click" Style="{StaticResource FormSuccessButtonStyle}" Width="90">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconRemixIcon Kind="Save3Fill" Width="14" Height="14"/>
                            <TextBlock Text="Save" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
