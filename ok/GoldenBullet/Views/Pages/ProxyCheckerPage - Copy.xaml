<Page x:Class="GoldenBullet.Views.Pages.ProxyCheckerPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:local="clr-namespace:GoldenBullet.Views.Pages"
xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
xmlns:controls="clr-namespace:GoldenBullet.Controls"
mc:Ignorable="d"
d:DesignHeight="700"
d:DesignWidth="1100"
Title="Proxy Checker"
Background="#FF121212">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
        <SolidColorBrush x:Key="ForegroundGood" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ForegroundBad" Color="#F44336"/>
        <SolidColorBrush x:Key="ForegroundWarning" Color="#FBC02D"/>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="StatLineStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0 3"/>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="2 0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
       
    </Page.Resources>
    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Grid Grid.Row="0" Margin="10 10 10 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Server" 
       Width="22" Height="22" 
       Foreground="#d19900"
       VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="PROXY CHECKER" VerticalAlignment="Center"
FontSize="15"
FontWeight="Bold"
Foreground="White"/>
                <TextBlock Text=" | Test HTTP/HTTPS/SOCKS proxies"
FontSize="12"
Opacity="0.6"
VerticalAlignment="Center"
Foreground="#AAA"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Start Button -->
                <Button x:Name="CheckButton"
        Click="StartStopChecking_Click"
        Style="{StaticResource StyledSuccessButton}"
        ToolTip="Start Checking"
                        Width="auto"
        Margin="5 0 0 0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconFontAwesome Kind="PlaySolid"
                                       Width="16"
                                       Height="16"
                                       Foreground="White"/>
                        <TextBlock Text="Start Processing"
                   Foreground="White"
                   Margin="5 0 0 0"
                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Pause Button -->
                <Button x:Name="PauseButton"
        Click="PauseChecking_Click"
        Style="{StaticResource StyledWarningButton}"
        ToolTip="Pause Checking"
        Visibility="Collapsed"
                        Padding="5"
                        Width="auto"
        Margin="5 0 0 0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconFontAwesome Kind="PauseSolid"
                                       Width="16"
                                       Height="16"
                                       Foreground="White"/>
                        <TextBlock Text="Pause"
                   Foreground="White"
                   Margin="5 0 0 0"
                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Stop Button -->
                <Button x:Name="StopButton"
        Click="StopChecking_Click"
        Style="{StaticResource StyledDangerButton}"
        ToolTip="Stop Checking"
                        Padding="5"
        Visibility="Collapsed"
                        Width="auto"
        Margin="5 0 0 0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconFontAwesome Kind="StopSolid"
                                       Width="16"
                                       Height="16"
                                       Foreground="White"/>
                        <TextBlock Text="Stop"
                   Foreground="White"
                   Margin="5 0 0 0"
                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            
        </Grid>
        <!-- Stats Cards -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Proxy Stats"
FontWeight="Bold"
FontSize="14"
Margin="0 0 0 10"
Foreground="White"/>
                    <StackPanel Margin="0 25 0 0">
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Total: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="TotalCountLabel" Text="0" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Checked: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="CheckedCountLabel" Text="0" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Working: " Foreground="{StaticResource ForegroundGood}" FontSize="12"/>
                            <TextBlock x:Name="WorkingCountLabel" Text="0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundGood}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Failed: " Foreground="{StaticResource ForegroundBad}" FontSize="12"/>
                            <TextBlock x:Name="FailedCountLabel" Text="0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundBad}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Progress"
FontWeight="Bold"
FontSize="14"
Margin="0 0 0 10"
Foreground="White"/>
                    <StackPanel Margin="0 25 0 0">
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Success Rate: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="SuccessRateLabel" Text="0%" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Detected Type: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="ProxyTypeLabel" Text="auto" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Status: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="StatusLabel" Text="Idle" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundWarning}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Elapsed: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="ElapsedLabel" Text="00:00:00" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Configuration Section -->
        <Border Grid.Row="2"
Background="{StaticResource CardBackground}"
BorderBrush="{StaticResource BorderColor}"
BorderThickness="1"
CornerRadius="4"
Margin="10 5 10 0"
Padding="15">
            <Grid>
                <TextBlock Text="Configuration"
FontWeight="Bold"
FontSize="14"
Margin="0 0 0 10"
Foreground="White"/>
                <Grid Margin="0 25 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                    

                    <!-- Target URL -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                        <TextBlock Text="Target URL"
Foreground="#AAA"
FontSize="11"
Margin="0 0 0 5"/>
                        <TextBox x:Name="UrlEntry"
Style="{StaticResource RoundedTextBox}"
Height="35"
AcceptsReturn="False"
TextWrapping="NoWrap"
VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <!-- Import from Group -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                        <TextBlock Text="Import from group" Foreground="#AAA" FontSize="11" Margin="0 0 0 5"/>
                        <ComboBox x:Name="ImportGroupCombo"
Style="{StaticResource RoundedComboBox}" 
Height="35"
SelectionChanged="ImportGroupCombo_SelectionChanged"
DropDownOpened="ImportGroupCombo_DropDownOpened">
                        </ComboBox>
                    </StackPanel>
                    
                </Grid>

                <Grid Margin="0 90 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Only Untested CheckBox -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="OnlyUntestedCheckBox"
Style="{StaticResource RoundedCheckBox}"
VerticalAlignment="Center"
Checked="OnlyUntestedCheckBox_Changed"
Unchecked="OnlyUntestedCheckBox_Changed"/>
                        <TextBlock Text="Check Only Untested Proxies"
Foreground="#AAA"
FontSize="11"
VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="5" Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="Threads / Bots"
               Foreground="#AAA"
               FontSize="11"
               VerticalAlignment="Center"
               Margin="0 0 10 0"/>

                        <metro:NumericUpDown x:Name="ThreadCountEntry"
                         Height="35"
                         Width="100"
                         Minimum="1"
                         Maximum="500"
                         Interval="1"
                         Value="50"
                         VerticalContentAlignment="Center"
                         Background="#333333"
                         Foreground="White"/>
                    </StackPanel>
                    <!-- Timeout NumericUpDown -->
                    <StackPanel Grid.Row="2" Grid.Column="3" Margin="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Timeout (ms)" VerticalAlignment="Center"
Foreground="#AAA"
FontSize="11"
                                   HorizontalAlignment="Left"
Margin="0 0 10 0"/>
                        <metro:NumericUpDown x:Name="TimeoutUpDown"
Height="35"
Width="100"
HorizontalAlignment="left"
Minimum="1000"
Maximum="60000"
Interval="1000"
Value="10000"
VerticalContentAlignment="Center"
Background="#333333"
Foreground="White"/>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>
        
        
        <!-- Controls & Progress -->
        <Grid Grid.Row="3" Margin="10,5,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0 0 0 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="Transparent"
CornerRadius="3"
Padding="1"
Grid.Column="0"
Margin="0 0 0 0">
                    <ProgressBar x:Name="MainProgressBar" Style="{StaticResource GlowingProgressBar}"
         Minimum="0"
         Maximum="100"
         Height="15"
         Value="0"
         Foreground="#D19900"
         BorderThickness="0" Margin="-1,0,-1,0"/>
                </Border>
                
            </Grid>
            <!-- Log Output with ColoredLog -->
            <Border Grid.Row="1"
Background="{StaticResource CardBackground}"
BorderBrush="{StaticResource BorderColor}"
BorderThickness="1"
CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Results Log"
FontWeight="Bold"
Margin="10"
Grid.Row="0"
Foreground="White"/>
                    <controls:ColoredLog x:Name="jobLog"
Grid.Row="1"
Margin="10 0 10 10"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
