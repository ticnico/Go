<Page x:Class="GoldenBullet.Views.Pages.Plugins"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Pages"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="780"
      Title="Plugins"
      Background="Black"
      MinWidth="900">

    <Page.Resources>
        <!-- Card Style for Plugin Items -->
        <Style x:Key="PluginCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#40D19900"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#D19900" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Plugin Name Text Style -->
        <Style x:Key="PluginNameStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Plugin Meta Text Style -->
        <Style x:Key="PluginMetaStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Background="#FF1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="#FF1E1E1E" Padding="20,20,20,15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <iconPacks:PackIconMaterial Kind="Puzzle" Width="24" Height="24" Foreground="#D19900" Margin="0,0,10,0"/>
                    <TextBlock Text="Plugins" FontSize="20" FontWeight="Bold" Foreground="#FFE0E0E0"/>
                </StackPanel>
                <TextBlock Text="Manage installed plugins that extend GoldenBullet's functionality. Add or remove plugins as needed."
                           Foreground="#FFAAAAAA" FontSize="12" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                Margin="0,0,20,10" Padding="10">
            <Button x:Name="addPluginButton" 
                    Click="AddPlugin" 
                    Style="{StaticResource StyledSuccessButton}"
                    Cursor="Hand"
                    Height="32"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterialDesign Kind="Add" Width="16" Height="16"/>
                    <TextBlock Text="Add Plugin" VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="Medium"/>
                </StackPanel>
            </Button>
        </Border>

        <!-- Plugins List Container -->
        <Border Grid.Row="1"
                Background="#FF252525"
                BorderBrush="#40D19900"
                BorderThickness="1"
                CornerRadius="8"
                Margin="20,0,20,20"
                Padding="0"
                ClipToBounds="True">

            <Grid>
                <!-- ItemsControl (always present in the visual tree) -->
                <ScrollViewer x:Name="pluginsScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="15">

                    <ItemsControl x:Name="pluginsControl" 
                                  ItemsSource="{Binding PluginsCollection}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PluginCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Plugin Info -->
                                        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource PluginNameStyle}"/>
                                            <TextBlock Text="{Binding Description}" 
                                                       Style="{StaticResource PluginMetaStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="500"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Remove Button -->
                                        <Button x:Name="removePluginButton" 
                                                Tag="{Binding}" 
                                                Grid.Column="1" 
                                                Click="RemovePlugin" 
                                                Style="{StaticResource StyledDangerButton}"
                                                Cursor="Hand"
                                                Width="40"
                                                Height="30"
                                                Padding="8,4"
                                                Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="14" Height="14"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State (overlay, shown when Items.Count = 0) -->
                <Border x:Name="emptyState"
                        Background="#FF252525" 
                        Padding="30,40"
                        IsHitTestVisible="False"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- Show empty state when ItemsControl has no items -->
                                <DataTrigger Binding="{Binding ElementName=pluginsControl, Path=Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="PuzzleOutline"
                                                    HorizontalAlignment="Center"
                                                    Width="48" Height="48" 
                                                    Foreground="#FF3C3C3C"
                                                    Margin="0,0,0,15"/>
                        <TextBlock Text="No plugins installed" 
                                   Foreground="#FF666666" 
                                   FontSize="14"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Click 'Add Plugin' to extend functionality" 
                                   Foreground="#FF444444" 
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
