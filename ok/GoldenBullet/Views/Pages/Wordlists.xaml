<Page x:Class="GoldenBullet.Views.Pages.Wordlists"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Pages"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="780"
      Title="Wordlists"
      Background="#FF1E1E1E">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Toolbar Button Base Style -->
        <Style x:Key="WordlistActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#80D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#80D19900"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#D19900" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1A1A1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ UPDATED: Header Style matching Proxies.xaml -->
        <Style x:Key="WordlistHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,5,5,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Padding="{TemplateBinding Padding}"
                                           Width="{TemplateBinding Width}"
                                           TextAlignment="Left"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontWeight="{TemplateBinding FontWeight}"/>
                            </Border>
                            <!-- ✅ Resize thumb (matches Proxies.xaml) -->
                            <Thumb x:Name="PART_HeaderGripper"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,4"
                                   Opacity="0.3"
                                   Width="2"
                                   Background="Transparent"
                                   Cursor="SizeWE"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pagination Button Style (Minimal) -->
        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF2D2D2D"/>
                                <Setter Property="Foreground" Value="#FFE0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D19900"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- Main Container -->
    <Grid Background="#FF1E1E1E" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="19*"/>
            <RowDefinition Height="87*"/>
        </Grid.RowDefinitions>
        <Border Background="#FF252525" 
                BorderBrush="#80D19900" 
                BorderThickness="1" 
                CornerRadius="6" Grid.RowSpan="2">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Toolbar -->
                    <RowDefinition Height="*"/>
                    <!-- List -->
                </Grid.RowDefinitions>

                <!-- 1. HEADER -->
                <Border Grid.Row="0" 
                        Background="#252525" 
                        Padding="15,12" 
                        BorderBrush="#80D19900" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="6,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileDocumentOutline" 
                                                    Width="20" Height="20" 
                                                    Foreground="#D19900" 
                                                    Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Wordlists Manager" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#FFE0E0E0"/>
                            <TextBlock Text="Import and manage data lists for jobs" 
                                       FontSize="10" Foreground="#FFAAAAAA"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. TOOLBAR -->
                <Border Grid.Row="1" 
                        Background="#252525" 
                        Padding="10,8" 
                        BorderBrush="#80D19900" 
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Actions -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="addButton" Click="Add" Style="{StaticResource StyledSuccessButton}" Width="80" Margin="0 0 5 0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Add" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="deleteButton" Click="DeleteSelected" Style="{StaticResource StyledDangerButton}" Width="80" Margin="0,0,5,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="deleteNotFoundWordlistsButton" Click="DeleteNotFound" Style="{StaticResource StyledWarningButton}" ToolTip="Deletes missing wordlists from the list.">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Close" />
                                    <TextBlock VerticalAlignment="Center" Margin="5 0">Delete Not Found</TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right: Search -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="clearButton" Click="ClearSearch" Style="{StaticResource StyledPrimaryButton}" Width="70" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12" Foreground="#FFE0E0E0" Margin="0 2 5 0"/>
                                    <TextBlock Text="Clear" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="filterTextbox" 
                                     Text="{Binding SearchString}" 
                                     Style="{StaticResource RoundedTextBox}" 
                                     Width="180"
                                     KeyDown="UpdateSearch"
                                     ToolTip="Search keyword"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. LISTVIEW -->
                <Border Grid.Row="2" 
                        Background="#252525" 
                        BorderBrush="#80D19900" 
                        BorderThickness="0,1,0,1">
                    <Grid AllowDrop="True" Drop="HandleDrop">
                        <ListView x:Name="wordlistListView" 
          Background="Transparent" 
          BorderThickness="0"
          ItemsSource="{Binding Path=WordlistsCollection}" 
          SelectionMode="Extended"
          VirtualizingPanel.IsVirtualizing="True"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.CanContentScroll="True">

                            <ListView.Resources>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#FFE0E0E0"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#FF2D2D2D"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <GridViewRowPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF2D2D2D"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FF2D2D2D"/>
                                            <Setter Property="Foreground" Value="#FFE0E0E0"/>
                                            <Setter Property="BorderBrush" Value="#80D19900"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#D19900" BlurRadius="6" ShadowDepth="0" Opacity="0.2"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Resources>

                            <ListView.View>
                                <GridView>
                                    <!-- ✅ Apply the matching header style to all columns -->
                                    <GridView.ColumnHeaderContainerStyle>
                                        <StaticResource ResourceKey="WordlistHeaderStyle"/>
                                    </GridView.ColumnHeaderContainerStyle>
                                    
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Path=Name}" Width="200"/>
                                    <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path=FileName}" Width="300"/>
                                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Path=Type}" Width="100"/>
                                    <GridViewColumn Header="Purpose" DisplayMemberBinding="{Binding Path=Purpose}" Width="100"/>
                                    <GridViewColumn Header="Total Lines" DisplayMemberBinding="{Binding Path=Total}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Empty State -->
                        <TextBlock x:Name="emptyMessage" 
                                   Text="No wordlists added yet. Drag and drop files here or click Add." 
                                   Foreground="#FF555555" 
                                   FontSize="14"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 4. PAGINATION -->

            </Grid>
        </Border>
    </Grid>
</Page>
