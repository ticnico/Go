<Page x:Class="GoldenBullet.Views.Pages.LogsToUlpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1100"
      Title="Logs to ULP"
      Background="#FF121212">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
        <SolidColorBrush x:Key="ForegroundGood" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ForegroundBad" Color="#F44336"/>
        <SolidColorBrush x:Key="ForegroundWarning" Color="#FBC02D"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="StatLineStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0 3"/>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="10 10 10 5">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Login" 
       Width="22" Height="22" 
       Foreground="#d19900"
       VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="LOGS TO ULP"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text=" | Extract URL:User:Pass from log files"
                           FontSize="12"
                           Opacity="0.6"
                           VerticalAlignment="Center"
                           Foreground="#AAA"/>
            </StackPanel>
        </Grid>

        <!-- Stats Cards -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Results Card -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Results"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0 0 0 10"
                               Foreground="White"/>
                    <StackPanel Margin="0 25 0 0">
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Credentials Found: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="HitLabel" Text="Hits: 0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundGood}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Files Scanned: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="FilesScannedLabel" Text="0" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Status: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="StatusLabel" Text="Idle" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundWarning}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress Card -->
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Progress"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0 0 0 10"
                               Foreground="White"/>
                    <StackPanel Margin="0 25 0 0">
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Current File: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="CurrentFileLabel" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Lines Processed: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="LinesProcessedLabel" Text="0" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Elapsed: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="ElapsedLabel" Text="00:00:00" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Configuration Section -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="10 5 10 0"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <TextBlock Grid.Row="0"
                           Text="Configuration"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0 0 0 15"
                           Foreground="White"/>

                <!-- Instructions -->
                <TextBlock Grid.Row="1" 
                           Text="Select a folder containing log files to scan for credentials"
                           Foreground="#AAA"
                           FontSize="12"
                           Margin="0 0 0 15"
                           TextWrapping="Wrap"/>

                <!-- Folder Path + Browse Button -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Folder Path Display -->
                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="Target Folder" 
                                   Foreground="#AAA" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 6"/>
                        <TextBox x:Name="FolderPathEntry"
                                 Style="{StaticResource RoundedTextBox}"
                                 Height="36"
                                 IsReadOnly="True"
                                 Foreground="#AAA"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 ToolTip="Selected folder path"/>
                    </StackPanel>

                    <!-- Open Folder Button -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0 6 0 0">
                        <Button x:Name="OpenButton"
                                Click="OpenFolder_Click"
                                Style="{StaticResource StyledEditButton}"
                                Width="110"
                                Height="36"
                                ToolTip="Select folder to scan">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="FolderOpenSolid"
                                                               Width="14"
                                                               Height="14"
                                                               Foreground="White"/>
                                <TextBlock Text="Open" 
                                           Foreground="White" 
                                           VerticalAlignment="Center"
                                           Margin="6 0 0 0"
                                           FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <!-- Start/Stop Button -->
                        <Button x:Name="StartStopButton"
            Click="StartStop_Click"
            Style="{StaticResource StyledSuccessButton}"
            ToolTip="Start/Stop Extraction"
            Margin="5 0 0 0"
            Content="▶ Start"
                                Width="100"
                                VerticalAlignment="Bottom"
                                Height="36"
            IsEnabled="False"/>
                    </StackPanel>
                    
                </Grid>
            </Grid>
        </Border>

        <!-- Controls & Output -->
        <Grid Grid.Row="3" Margin="10,5,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Control Buttons -->
            <Grid Grid.Row="0" Margin="0 0 0 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="Transparent"
        CornerRadius="3"
        Padding="5"
        Grid.Column="0">
                    <ProgressBar x:Name="MainProgressBar" Style="{StaticResource GlowingProgressBar}"
                 Minimum="0"
                 Maximum="100"
                 Height="15"
                 Value="0"
                 Foreground="#D19900"
                 BorderThickness="0" Margin="-5,0,-5,0"/>
                </Border>

                
            </Grid>

            <!-- Output Log - With named ScrollViewer for code-behind compatibility -->
            <Border Grid.Row="1"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Extracted Credentials"
                               FontWeight="Bold"
                               Margin="10"
                               Grid.Row="0"
                               Foreground="White"/>
                    <ScrollViewer x:Name="OutputScrollViewer"
                                  Grid.Row="1"
                                  Margin="10 0 10 10"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <TextBox x:Name="OutputText"
                                 Background="Transparent"
                                 Foreground="#AAAAAA"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="12"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
