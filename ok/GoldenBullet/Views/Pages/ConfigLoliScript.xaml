<Page x:Class="GoldenBullet.Views.Pages.ConfigLoliScript"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GoldenBullet.Views.Pages"
      xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="780"
      Title="LoliScript"
      KeyDown="PageKeyDown"
      Background="#FF1E1E1E">

    <Page.Resources>
        <!-- Panel Header Style -->
        <Style x:Key="PanelHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
        </Style>

        <!-- Editor Container Style -->
        <Style x:Key="EditorContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </Page.Resources>

    <Grid Background="#FF1E1E1E" Margin="10">

        <!-- Main Editor Card -->
        <Border Style="{StaticResource EditorContainerStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ScriptText" 
                                                    Width="16" Height="16" 
                                                    Foreground="#FF9C27B0" 
                                                    Margin="0,0,8,0"/>
                        <TextBlock Text="LoliScript Editor" 
                                   FontSize="12" FontWeight="SemiBold" 
                                   Foreground="#FFE0E0E0"/>
                    </StackPanel>
                </Border>

                <!-- Content -->
                <avalonEdit:TextEditor Grid.Row="1"
                                       x:Name="editor"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="#FFE0E0E0"
                                       Background="#FF1A1A1A"
                                       LostFocus="EditorLostFocus"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       ShowLineNumbers="True"
                                       LineNumbersForeground="#FF555555">
                    <avalonEdit:TextEditor.Options>
                        <avalonEdit:TextEditorOptions ShowBoxForControlCharacters="False"/>
                    </avalonEdit:TextEditor.Options>
                </avalonEdit:TextEditor>
            </Grid>
        </Border>
    </Grid>
</Page>
