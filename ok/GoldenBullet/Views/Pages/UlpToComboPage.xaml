<Page x:Class="GoldenBullet.Views.Pages.UlpToComboPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1100"
      Title="ULP to Combo"
      Background="#FF121212">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
        <SolidColorBrush x:Key="ForegroundGood" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ForegroundBad" Color="#F44336"/>
        <SolidColorBrush x:Key="ForegroundWarning" Color="#FBC02D"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="StatLineStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0 3"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="2 0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="radioBorder"
                                    Width="16"
                                    Height="16"
                                    Background="#2D2D2D"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Ellipse x:Name="radioMark"
                                         Width="8"
                                         Height="8"
                                         Fill="White"
                                         Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="radioMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="radioBorder" Property="Background" Value="#1565C0"/>
                                <Setter TargetName="radioBorder" Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="radioBorder" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="10 10 10 5">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="VectorCombine" 
       Width="22" Height="22" 
       Foreground="#d19900"
       VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="ULP TO COMBO"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text=" | Extract username:password combos from ULP files"
                           FontSize="12"
                           Opacity="0.6"
                           VerticalAlignment="Center"
                           Foreground="#AAA"/>
            </StackPanel>
        </Grid>

        <!-- Stats Cards -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Results Card -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Results"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0 0 0 10"
                               Foreground="White"/>
                    <StackPanel Margin="0 25 0 0">
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Hits: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="HitsLabel" Text="Hits: 0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundGood}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Fails: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="FailsLabel" Text="Fails: 0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundBad}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress Card -->
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <TextBlock Text="Progress"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0 0 0 10"
                               Foreground="White"/>
                    <StackPanel Margin="0 25 0 0">
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Status: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="StatusLabel" Text="Idle" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource ForegroundWarning}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatLineStyle}">
                            <TextBlock Text="Elapsed: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="ElapsedLabel" Text="00:00:00" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Configuration Section -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="5,5,10,0"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <TextBlock Grid.Row="0"
                           Text="Configuration"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0 0 0 15"
                           Foreground="White"/>

                <!-- Keywords Row -->
                <Grid Grid.Row="1" Margin="0 0 0 15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Keywords Input -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Keywords" 
                                   Foreground="#AAA" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 6"/>
                        <TextBox x:Name="KeywordsTextBox"
                                 Style="{StaticResource RoundedTextBox}"
                                 Height="36"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 ToolTip="Enter keywords separated by commas (e.g., netflix,spotify)"/>
                    </StackPanel>

                    <!-- Load Button -->
                    <StackPanel Grid.Column="1" Margin="12 20 0 0" VerticalAlignment="Top">
                        <Button x:Name="LoadKeywordsButton"
                                Click="LoadKeywordsButton_Click"
                                Style="{StaticResource StyledEditButton}"
                                Width="90"
                                Height="36"
                                ToolTip="Load keywords from text file">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="FileImportSolid"
                                                               Width="14"
                                                               Height="14"
                                                               Foreground="White"/>
                                <TextBlock Text="Load" 
                                           Foreground="White" 
                                           VerticalAlignment="Center"
                                           Margin="6 0 0 0"
                                           FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Combo Type Row -->
                <StackPanel Grid.Row="2" Margin="0 10 0 15" HorizontalAlignment="Center">
                    <TextBlock Text="Output Format" HorizontalAlignment="Center"
                               Foreground="#AAA" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Margin="0 0 0 8"/>
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox x:Name="PhoneCheckBox"
                                  Style="{StaticResource RoundedCheckBox}"
                                  Content="PHONE"
                                  Margin="0 0 12 0"
                                  Padding="0 2 0 0"
                                  Foreground="#CCC"
                                  FontSize="12"
                                  Checked="Checkbox_Changed"
                                  Unchecked="Checkbox_Changed"/>
                        <CheckBox x:Name="EmailCheckBox"
                                  Style="{StaticResource RoundedCheckBox}"
                                  Content="E-MAIL"
                                  Margin="0 0 12 0"
                                  Padding="0 2 0 0"
                                  Foreground="#CCC"
                                  FontSize="12"
                                  Checked="Checkbox_Changed"
                                  Unchecked="Checkbox_Changed"/>
                        <CheckBox x:Name="UsernameCheckBox"
                                  Style="{StaticResource RoundedCheckBox}"
                                  Content="USERNAME"
                                  Margin="0 0 12 0"
                                  Padding="0 2 0 0"                                  
                                  Foreground="#CCC"
                                  FontSize="12"
                                  Checked="Checkbox_Changed"
                                  Unchecked="Checkbox_Changed"/>

                        <CheckBox x:Name="MacCheckBox"
                                  Style="{StaticResource RoundedCheckBox}"
                                  Content="MAC ADDRESS"
                                  Margin="0 0 12 0"
                                  Padding="0 2 0 0"                                  
                                  Foreground="#CCC"
                                  FontSize="12"
                                  Checked="Checkbox_Changed"
                                  Unchecked="Checkbox_Changed"/>

                        <CheckBox x:Name="KeywordsCheckBox"
                                  Style="{StaticResource RoundedCheckBox}"
                                  Content="KEYWORDS"
                                  Foreground="#CCC"
                                  Padding="0 2 0 0"
                                  FontSize="12"
                                  ToolTip="Extract keyword-matched URLs"
                                  Checked="Checkbox_Changed"
                                  Unchecked="Checkbox_Changed"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Source Type Row -->
                <StackPanel Grid.Row="3" Margin="0 0 0 15" HorizontalAlignment="Center">
                    <TextBlock Text="Source" HorizontalAlignment="Center"
                               Foreground="#AAA" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Margin="0 0 0 8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FileRadioButton"
                                     Style="{StaticResource RoundedRadioButton}"
                                     Content="Single File"
                                     IsChecked="True"
                                     Foreground="#CCC"
                                     FontSize="12"
                                     Margin="0 0 20 0"
                                     GroupName="SourceType"/>
                        <RadioButton x:Name="FolderRadioButton"
                                     Style="{StaticResource RoundedRadioButton}"
                                     Content="Folder"
                                     Foreground="#CCC"
                                     FontSize="12"
                                     GroupName="SourceType"/>
                    </StackPanel>
                </StackPanel>

                <!-- Browse Button Row (Under Source) -->
                <StackPanel Grid.Row="4" HorizontalAlignment="Center">
                    <Button x:Name="SelectButton"
                            Click="SelectButton_Click"
                            Style="{StaticResource StyledEditButton}"
                            Width="110"
                            Height="36"
                            ToolTip="Select file or folder to process">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconFontAwesome Kind="FolderOpenSolid"
                                                           Margin="0 1 1 0"
                                                           Width="14"
                                                           Height="14"
                                                           Foreground="White"/>
                            <TextBlock Text="Browse..." 
                                       Foreground="White" 
                                       VerticalAlignment="Center"
                                       Margin="6 0 0 0"
                                       FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Controls & Log Output -->
        <Grid Grid.Row="3" Margin="10,5,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Control Buttons -->
            <Grid Grid.Row="0" Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="Transparent"
        CornerRadius="3"
        Padding="4"
        Grid.Column="0"
        Margin="-10,0,-4,0" Grid.ColumnSpan="2">
                    <ProgressBar x:Name="MainProgressBar" Style="{StaticResource GlowingProgressBar}"
                 Minimum="0"
                 Maximum="100"
                 Height="15"
                 Value="0"
                 Foreground="#D19900"
                 BorderThickness="0"/>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Start/Stop Button - matches code-behind -->
                </StackPanel>
            </Grid>

            <!-- Log Output - Standard TextBox for AppendText/ScrollToEnd -->
            <Border Grid.Row="1" Margin="-5 5 0 0"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Output Log"
                               FontWeight="Bold"
                               Margin="10"
                               Grid.Row="0"
                               Foreground="White"/>
                    <TextBox x:Name="LogTextBox"
                             Grid.Row="1"
                             Margin="10 0 10 10"
                             Background="Transparent"
                             Foreground="#AAAAAA"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>
        </Grid>
        <Button x:Name="StartButton" Width="auto"
                            Click="StartButton_Click"
                            Style="{StaticResource StyledSuccessButton}"
                            ToolTip="Start/Stop Processing"
                            Margin="977,8,10,118"
                            Content="▶ Start Processing" Grid.RowSpan="2"/>
    </Grid>
</Page>
