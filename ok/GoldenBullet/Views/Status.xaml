<controls:MetroWindow x:Class="GoldenBullet.Views.Status"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="License Status"
        Height="auto"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        GlowBrush="#FF28A745"
        Background="#FF1E1E1E"
        WindowTitleBrush="#FF252525"
        BorderThickness="0"
        TextElement.FontFamily="Segoe UI">

    <controls:MetroWindow.Resources>

    </controls:MetroWindow.Resources>

    <Grid Margin="30,30,30,0" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,25">
            <Border Background="#FF2D2D2D" CornerRadius="12" Width="70" Height="70" BorderBrush="#FF3C3C3C" BorderThickness="1">
                <iconPacks:PackIconMaterial Kind="LockCheck"
                                            Width="36" Height="36"
                                            Foreground="#FF28A745"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="License Activated"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,15,0,0"
                       HorizontalAlignment="Center"
                       Foreground="#FFE0E0E0"/>
            <TextBlock Text="Your software is fully unlocked"
                       FontSize="13"
                       Foreground="#FFAAAAAA"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 2. License Info Card -->
        <Border Grid.Row="1"
                Background="#FF252525"
                CornerRadius="10"
                Padding="25"
                Margin="0,0,0,25"
                BorderBrush="#FF3C3C3C"
                BorderThickness="1">
            <StackPanel>
                <!-- Customer -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Customer:" FontWeight="SemiBold" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CustomerName}"
                               Foreground="#FFE0E0E0"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Email -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Email:" FontWeight="SemiBold" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CustomerEmail}"
                               Foreground="#FFE0E0E0"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- License ID -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="License ID:" FontWeight="SemiBold" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding LicenseId}"
                               Foreground="#FFE0E0E0"
                               FontFamily="Consolas"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Expiry -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Expires:" FontWeight="SemiBold" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ExpiryDateText}"
                               Foreground="#FF28A745"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Hardware ID (Special Box) -->
                <Border Background="#FF1A1A1A" BorderBrush="#FF3C3C3C" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hardware ID:" FontWeight="SemiBold" Foreground="#FFAAAAAA" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding HardwareId}"
                                   Foreground="#FF00FF00"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   FontFamily="Consolas"
                                   FontSize="11"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- 4. Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="110"
                    Click="BtnCancel_Click"
                    Margin="0,0,15,0"
                    Style="{StaticResource StyledPrimaryButton}" Height="28"/>

        </StackPanel>
    </Grid>
</controls:MetroWindow>
