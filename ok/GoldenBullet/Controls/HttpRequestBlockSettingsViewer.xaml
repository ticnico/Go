<UserControl x:Class="GoldenBullet.Controls.HttpRequestBlockSettingsViewer"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoldenBullet.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="800"
             Background="#FF1E1E1E">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- === Base Text Styles === -->
        <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#fec34d"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HeaderDescStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#fec34d"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- === Styled RadioButton === -->
        <Style x:Key="StyledRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40D19900"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D19900"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- === Button Style === -->
        <Style x:Key="StyledSmallButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#fec34d"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF3D3D3D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D19900"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1D1D1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- === Section Container === -->
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- === Separator Style === -->
        <Style x:Key="StyledSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="0 15 0 10"/>
            <Setter Property="Height" Value="1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="8">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- === Header Section === -->
            <Border Background="#FF1E1E1E" 
                    BorderBrush="#40D19900" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="12,10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <iconPacks:PackIconMaterial Kind="Web" 
                                                    Width="18" Height="18" 
                                                    Foreground="#fec34d" 
                                                    Margin="0,0,8,0"/>
                        <TextBlock Text="HTTP Request" 
                                   FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#fec34d"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HeaderTitleStyle}"
                               Text="{Binding NameAndId}"
                               Margin="26,0,0,2"/>
                    <TextBlock Style="{StaticResource HeaderDescStyle}"
                               Text="{Binding Block.Descriptor.Description}"
                               Margin="26,2,0,0"/>
                    <TextBlock Style="{StaticResource HeaderDescStyle}"
                               Text="{Binding Block.Descriptor.ExtraInfo}"
                               FontSize="10"
                               Margin="26,1,0,0"/>
                </StackPanel>
            </Border>

            <!-- === Basic Settings === -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Style="{StaticResource LabelStyle}" 
               Content="Label:" 
               Grid.Column="0"
               VerticalAlignment="Center"
               Margin="0 0 5 0"/>

                    <TextBox Style="{StaticResource RoundedTextBox}"
                 Grid.Column="1"
                 Text="{Binding Label}"
                 HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SectionBorderStyle}">

                <StackPanel>
                    <CheckBox Style="{StaticResource RoundedCheckBox}"
                              Content="Safe mode (catch exceptions to data.ERROR)"
                              IsChecked="{Binding SafeMode}" 
                              Margin="0,6,0,2"/>

                    <!-- Inside the StackPanel of the Core Settings Border -->
                    <Label Style="{StaticResource LabelStyle}" 
       Content="Core Settings:" 
       FontWeight="SemiBold"
       Margin="0,10,0,4"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <!-- New Row for Proxy -->
                        </Grid.RowDefinitions>

                        <local:StringSettingViewer Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               x:Name="urlSetting" Margin="0,0,0,4"/>
                        <local:EnumSettingViewer Grid.Row="1" Grid.Column="0"
                             x:Name="methodSetting" Margin="0,0,4,0"/>

                        <local:StringSettingViewer2 Grid.Row="1" Grid.Column="1"
                               x:Name="httpVersionSetting" Margin="4,0,0,0"/>
                        <local:BoolSettingViewer Grid.Row="2" Grid.Column="0"
                             x:Name="autoRedirectSetting" Margin="0,4,4,0"/>
                        <local:BoolSettingViewer Grid.Row="2" Grid.Column="1"
                             x:Name="alwaysSendContentSetting" Margin="4,4,0,0"/>

                        <!-- NEW PROXY SETTING CONTROL -->
                        <local:ProxySettingViewer Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                              x:Name="proxyModeSetting" Margin="0,4,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- === Request Mode Selector === -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <Label Style="{StaticResource LabelStyle}" 
                           Content="Request Mode:" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource StyledRadioButton}"
                                     Content="Standard"
                                     IsChecked="{Binding StandardMode}"/>
                        <RadioButton Style="{StaticResource StyledRadioButton}"
                                     Content="Raw"
                                     IsChecked="{Binding RawMode}"/>
                        <RadioButton Style="{StaticResource StyledRadioButton}"
                                     Content="Basic Auth"
                                     IsChecked="{Binding BasicAuthMode}"/>
                        <RadioButton Style="{StaticResource StyledRadioButton}"
                                     Content="Multipart"
                                     IsChecked="{Binding MultipartMode}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- === Mode-Specific Content (TabControl with hidden headers) === -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <TabControl x:Name="tabControl" 
                            Background="Transparent" 
                            BorderThickness="0"
                            Padding="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- Standard Mode -->
                    <TabItem>
                        <StackPanel Margin="0,4,0,0">
                            <Label Style="{StaticResource LabelStyle}" Content="Standard Mode Settings:" FontWeight="SemiBold"/>
                            <local:StringSettingViewer x:Name="standardContentSetting" Margin="0,0,0,4"/>
                            <local:StringSettingViewer3 x:Name="standardContentTypeSetting" Margin="0,0,0,4"/>
                            <local:BoolSettingViewer x:Name="urlEncodeContentSetting"/>
                        </StackPanel>
                    </TabItem>

                    <!-- Raw Mode -->
                    <TabItem>
                        <StackPanel Margin="0,4,0,0">
                            <Label Style="{StaticResource LabelStyle}" Content="Raw Mode Settings:" FontWeight="SemiBold"/>
                            <local:ByteArraySettingViewer x:Name="rawContentSetting" Margin="0,0,0,4"/>
                            <local:StringSettingViewer x:Name="rawContentTypeSetting"/>
                        </StackPanel>
                    </TabItem>

                    <!-- Basic Auth Mode -->
                    <TabItem>
                        <StackPanel Margin="0,4,0,0">
                            <Label Style="{StaticResource LabelStyle}" Content="Basic Auth Settings:" FontWeight="SemiBold"/>
                            <local:StringSettingViewer x:Name="basicAuthUsernameSetting" Margin="0,0,0,4"/>
                            <local:StringSettingViewer x:Name="basicAuthPasswordSetting"/>
                        </StackPanel>
                    </TabItem>

                    <!-- ================= Multipart Mode - REDESIGNED & FIXED ================= -->
                    <!-- ================= Multipart Mode - FIXED & STABLE ================= -->
                    <TabItem>
                        <StackPanel Margin="0,4,0,0">

                            <!-- Section Header -->
                            <Border Background="#FF2A2A2A" BorderBrush="#D19900" BorderThickness="1" 
                CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="PackageVariant" 
                                                Width="16" Height="16" 
                                                Foreground="#fec34d" 
                                                Margin="0,0,6,0"/>
                                        <TextBlock Text="Multipart Form Data" 
                               FontWeight="SemiBold" 
                               Foreground="#fec34d"
                               FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" 
                           Text="Configure form boundaries and individual parts" 
                           Foreground="#FF999999" 
                           FontSize="9" 
                           Margin="22,2,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Boundary Setting -->
                            <Border Style="{StaticResource SectionBorderStyle}">
                                <Grid Margin="5,0,5,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" 
                           Text="Boundary String" 
                           FontWeight="SemiBold" 
                           Foreground="#FFE0E0E0" 
                           FontSize="10"
                           Margin="0,0,0,4"/>
                                    <local:StringSettingViewer Grid.Row="1" 
                                           x:Name="multipartBoundarySetting"
                                           Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="2" 
                           Text="Auto-generated if empty" 
                           Foreground="#FF666666" 
                           FontSize="9" 
                           FontStyle="Italic"
                           Margin="0,2,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Parts Collection Header -->
                            <Grid Margin="0,8,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Grid.Column="0"
                                        Kind="FormatListBulleted" 
                                        Width="14" Height="14" 
                                        Foreground="#fec34d" 
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                       Text="Form Parts" 
                       FontWeight="SemiBold" 
                       Foreground="#FFE0E0E0" 
                       FontSize="11"
                       VerticalAlignment="Center"/>
                                <Button Grid.Column="2"
                    Content="＋ Add Part" 
                    Width="85" Height="26" 
                    Margin="12,0,0,0"
                    Command="{Binding AddMultipartPartCommand}"
                    ToolTip="Add new form part"
                    Style="{StaticResource StyledSmallButton}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                Background="#D19900" 
                                BorderBrush="#D19900" 
                                BorderThickness="1"
                                CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            TextElement.FontSize="10"
                                            TextElement.Foreground="White"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E1A910"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#B18900"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Parts Collection -->
                            <ItemsControl ItemsSource="{Binding MultipartParts}" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Part Card -->
                                        <Border Background="#FF2A2A2A" 
                            BorderBrush="#FF3C3C3C" 
                            BorderThickness="1" 
                            CornerRadius="5" 
                            Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Part Header -->
                                                <Border Grid.Row="0"
                                    Background="#FF252525" 
                                    BorderBrush="#FF333333" 
                                    BorderThickness="0,0,0,1"
                                    Padding="10,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Type Badge -->
                                                        <Border Grid.Column="0"
                                            Background="#D19900" 
                                            CornerRadius="3" 
                                            Padding="6" 
                                            Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <iconPacks:PackIconMaterial 
                                                Kind="{Binding TypeIcon}" 
                                                Width="12" Height="12" 
                                                Foreground="White"
                                                Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding TypeLabel}" 
                                                       Foreground="White" 
                                                       FontSize="9" 
                                                       FontWeight="Medium"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Part Name Preview -->
                                                        <TextBlock Grid.Column="1"
                                               Text="{Binding NameSetting.Value, StringFormat='Field: {0}', TargetNullValue='Field: (unnamed)'}" 
                                               Foreground="#FFE0E0E0" 
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                                        <!-- Remove Button -->
                                                        <Button Grid.Column="3"
                                            Content="🗑" 
                                            Width="22" Height="22"
                                            Command="{Binding DataContext.RemoveMultipartPartCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#FF442222"
                                            BorderBrush="#FF663333"
                                            Foreground="#FFAAAAAA"
                                            ToolTip="Remove part"
                                            Style="{StaticResource StyledSmallButton}"
                                            Padding="0,-3,0,0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="border" 
                                                        Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="1"
                                                        CornerRadius="3">
                                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"
                                                                    TextElement.FontSize="11"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="border" Property="Background" Value="#FF663333"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <!-- Part Content -->
                                                <Border Grid.Row="1" Padding="10,8,10,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Common Fields Row -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Field Name -->
                                                            <Grid Grid.Column="0" Margin="0,0,4,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Grid.Row="0"
                                                       Text="Field Name" 
                                                       Foreground="#FF999999" 
                                                       FontSize="9"
                                                       Margin="0,0,0,2"/>
                                                                <local:StringSettingViewer Grid.Row="1"
                                                                       Setting="{Binding NameSetting}"/>
                                                            </Grid>

                                                            <!-- Content Type -->
                                                            <Grid Grid.Column="1" Margin="4,0,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Grid.Row="0"
                                                       Text="Content-Type" 
                                                       Foreground="#FF999999" 
                                                       FontSize="9"
                                                       Margin="0,0,0,2"/>
                                                                <local:StringSettingViewer Grid.Row="1"
                                                                       Setting="{Binding ContentTypeSetting}"/>
                                                            </Grid>
                                                        </Grid>

                                                        <!-- String Part Fields -->
                                                        <Border Grid.Row="1"
                                            Visibility="{Binding IsStringType, Converter={StaticResource BoolToVis}}"
                                            Background="#FF222222" 
                                            BorderBrush="#FF333333" 
                                            BorderThickness="1" 
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="0,4,0,0">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <iconPacks:PackIconMaterial Kind="Text" 
                                                                            Width="12" Height="12" 
                                                                            Foreground="#fec34d"
                                                                            Margin="0,0,4,0"/>
                                                                    <TextBlock Text="Text Content" 
                                                           Foreground="#FFE0E0E0" 
                                                           FontSize="9"
                                                           FontWeight="Medium"/>
                                                                </StackPanel>
                                                                <local:StringSettingViewer Grid.Row="1"
                                                                       Setting="{Binding DataSetting}"
                                                                       Margin="0,0,0,4"/>
                                                                <TextBlock Grid.Row="2"
                                                       Text="Supports {'VAR'} syntax for dynamic values" 
                                                       Foreground="#FF666666" 
                                                       FontSize="8" 
                                                       FontStyle="Italic"
                                                       Margin="0,3,0,0"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- File Part Fields -->
                                                        <Border Grid.Row="2"
                                            Visibility="{Binding IsFileType, Converter={StaticResource BoolToVis}}"
                                            Background="#FF222222" 
                                            BorderBrush="#FF333333" 
                                            BorderThickness="1" 
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="0,4,0,0">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <iconPacks:PackIconMaterial Kind="FileUpload" 
                                                                            Width="12" Height="12" 
                                                                            Foreground="#fec34d"
                                                                            Margin="0,0,4,0"/>
                                                                    <TextBlock Text="File Path" 
                                                           Foreground="#FFE0E0E0" 
                                                           FontSize="9"
                                                           FontWeight="Medium"/>
                                                                </StackPanel>
                                                                <local:StringSettingViewer Grid.Row="1"
                                                                       Setting="{Binding FileNameSetting}"
                                                                       Margin="0,0,0,4"/>
                                                                <TextBlock Grid.Row="2"
                                                       Text="Use {'VAR:filepath'} for dynamic file paths" 
                                                       Foreground="#FF666666" 
                                                       FontSize="8" 
                                                       FontStyle="Italic"
                                                       Margin="0,3,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Helper Tip -->
                            <Border Background="#FF1A1A2E" 
                BorderBrush="#444466" 
                BorderThickness="1" 
                CornerRadius="4"
                Padding="8,6"
                Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Grid.Column="0"
                                            Kind="LightbulbOn" 
                                            Width="14" Height="14" 
                                            Foreground="#fec34d"
                                            Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                           Text="Pro Tip: Use {'VAR:variableName'} syntax in any field for dynamic runtime values" 
                           Foreground="#FFAAAAAA" 
                           FontSize="9"
                           TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </TabItem>
                    <!-- ================= END Multipart Mode ================= -->

                </TabControl>
            </Border>

            <Separator Style="{StaticResource StyledSeparator}"/>

            <!-- === Additional Settings === -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel Orientation="Vertical">
                    <Label Style="{StaticResource LabelStyle}"
               Content="Additional Settings:"
               FontWeight="SemiBold"
               Margin="0,0,0,6"/>

                    <!-- === Custom Cookies: Custom Title + Hide Default === -->
                    <Border 
                Padding="10,0" 
                Margin="0,0,0,8">
                        <StackPanel Orientation="Vertical">
                            <!-- Custom Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,-5">
                                <iconPacks:PackIconMaterial Kind="Cookie"
                                                Width="16" Height="16"
                                                Foreground="#fec34d"
                                                Margin="0,0,6,0"/>
                                <TextBlock Text="Custom Cookies"
                               FontWeight="SemiBold"
                               Foreground="#fec34d"
                               FontSize="11"/>
                            </StackPanel>

                            <!-- Control with default label HIDDEN -->
                            <local:DictionaryOfStringsSettingViewer 
                    x:Name="customCookiesSetting" 
                    ShowLabel="False"
                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- === Custom Cookies: Custom Title + Hide Default === -->
                    <Border 
Padding="10,0" 
Margin="0,0,0,8">
                        <StackPanel Orientation="Vertical">
                            <!-- Custom Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,-5">
                                <iconPacks:PackIconMaterial Kind="FormatListBulleted"
                                Width="16" Height="16"
                                Foreground="#fec34d"
                                Margin="0,0,6,0"/>
                                <TextBlock Text="Custom Headers"
               FontWeight="SemiBold"
               Foreground="#fec34d"
               FontSize="11"/>
                            </StackPanel>

                            <local:DictionaryOfStringsSettingViewer 
            x:Name="customHeadersSetting"
            ShowLabel="False"
            Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <local:IntSettingViewer x:Name="timeoutMillisecondsSetting" Margin="0,0,0,4"/>
                    <local:IntSettingViewer x:Name="maxNumberOfRedirectsSetting" Margin="0,0,0,4"/>
                    <local:BoolSettingViewer x:Name="absoluteUriInFirstLineSetting" Margin="0,0,0,4"/>
                    <local:BoolSettingViewer x:Name="readResponseContentSetting" Margin="0,0,0,4"/>
                    <local:BoolSettingViewer x:Name="decodeHtmlSetting" Margin="0,0,0,4"/>
                    <local:StringSettingViewer x:Name="codePagesEncodingSetting"/>
                </StackPanel>
            </Border>

            <!-- === Advanced Settings Section === -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <Label Style="{StaticResource LabelStyle}" 
                           Content="Advanced Settings:" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                    <local:EnumSettingViewer x:Name="httpLibrarySetting" Margin="0,0,0,4"/>

                    <!-- cURL Impersonate Settings -->
                    <local:EnumSettingViewer x:Name="curlImpersonateBrowserProfileSetting" Margin="0,0,0,4"
                                             Visibility="{Binding DataContext.IsCurlImpersonate, ElementName=root, Converter={StaticResource ResourceKey=BoolToVis}}" />
                    <local:BoolSettingViewer x:Name="curlUseBrowserHeadersSetting" Margin="0,0,0,4"
                                             Visibility="{Binding DataContext.IsCurlImpersonate, ElementName=root, Converter={StaticResource ResourceKey=BoolToVis}}" />

                    <!-- Standard HTTP Settings -->
                    <local:EnumSettingViewer x:Name="securityProtocolSetting" Margin="0,0,0,4"
                                             Visibility="{Binding DataContext.IsNotCurlImpersonate, ElementName=root, Converter={StaticResource ResourceKey=BoolToVis}}" />
                    <local:BoolSettingViewer x:Name="ignoreCertificateValidationSetting" Margin="0,0,0,4" />
                    <local:BoolSettingViewer x:Name="useCustomCipherSuitesSetting" Margin="0,0,0,4"
                                             Visibility="{Binding DataContext.IsNotCurlImpersonate, ElementName=root, Converter={StaticResource ResourceKey=BoolToVis}}" />
                    <local:ListOfStringsSettingViewer x:Name="customCipherSuitesSetting"
                                                      Visibility="{Binding DataContext.IsNotCurlImpersonate, ElementName=root, Converter={StaticResource ResourceKey=BoolToVis}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
