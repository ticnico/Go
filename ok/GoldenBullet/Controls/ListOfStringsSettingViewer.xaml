<UserControl x:Class="GoldenBullet.Controls.ListOfStringsSettingViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoldenBullet.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- === Label Style (Original Spacing) === -->
        <Style x:Key="SettingLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,5,4,0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="3000"/>
        </Style>

        <!-- === Mode Toggle Button Style (Exact 30×30px + Rounded) === -->
        <Style x:Key="ModeToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="2000"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40D19900"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#D19900" BlurRadius="5" ShadowDepth="0" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1A1A1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- === Interpolated Mode Link Style === -->
        <Style x:Key="InterpLinkStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D19900"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF3399FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Setting Name Label - Original: Margin="0 5 0 0", VerticalAlignment="Top" -->
        <Label Style="{StaticResource SettingLabelStyle}"
               Content="{Binding Name}"
               ToolTip="{Binding Description}"
               VerticalAlignment="Top"
               Grid.Column="0" />

        <!-- Value Input: Variable/Constant/Interpolated Toggle -->
        <TabControl x:Name="tabControl" Grid.Column="1" Background="Transparent">
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- Variable Mode: ComboBox -->
            <TabItem>
                <ComboBox Style="{StaticResource RoundedComboBoxArow}"
                          IsEditable="True"
                          ItemsSource="{Binding Suggestions}"
                          Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" />
            </TabItem>

            <!-- Constant Mode: TextBox (Exact 100px Height) -->
            <TabItem>
                <TextBox Style="{StaticResource RoundedTextBox}"
                         Height="100"
                         AcceptsReturn="True"
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
            </TabItem>

            <!-- Interpolated Mode: TextBox (Exact 100px Height) -->
            <TabItem>
                <TextBox Style="{StaticResource RoundedTextBox}"
                         Height="100"
                         Text="{Binding InterpValue, UpdateSourceTrigger=PropertyChanged}" />
            </TabItem>
        </TabControl>

        <!-- Mode Toggle Buttons (Original: Height="40", VerticalAlignment="Top") -->
        <TabControl x:Name="buttonTabControl" 
                    Grid.Column="2" 
                    Height="40" 
                    VerticalAlignment="Top" 
                    Background="Transparent">
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- Variable -> Constant -->
            <TabItem>
                <Button Click="ConstantMode"
                        Style="{StaticResource ModeToggleButtonStyle}"
                        ToolTip="Switch to constant mode">
                    <TextBlock FontSize="9" FontWeight="SemiBold">VAR</TextBlock>
                </Button>
            </TabItem>

            <!-- Constant -> Interpolated -->
            <TabItem>
                <Button Click="InterpMode"
                        Style="{StaticResource ModeToggleButtonStyle}"
                        ToolTip="Switch to interpolated mode">
                    <iconPacks:PackIconModern Kind="TextSerif" Width="14" Height="14" />
                </Button>
            </TabItem>

            <!-- Interpolated -> Variable -->
            <TabItem>
                <Button Click="VariableMode"
                        Style="{StaticResource ModeToggleButtonStyle}"
                        ToolTip="Switch to variable mode">
                    <iconPacks:PackIconEntypo Kind="Code" Width="14" Height="14"/>
                </Button>
            </TabItem>
        </TabControl>

        <!-- Interpolated Mode Suggestion (Original Layout Preserved) -->
        <StackPanel
            Visibility="{Binding CanSwitchToInterpolatedMode, Converter={StaticResource ResourceKey=BoolToVis}}"
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="0 0 0 5"
            Orientation="Horizontal">
            <TextBlock Foreground="#FFAAAAAA" FontSize="10" VerticalAlignment="Center">
                This setting contains the '&lt;' and '&gt;' characters, do you want to&#160;
            </TextBlock>
            <TextBlock Style="{StaticResource InterpLinkStyle}"
                       MouseDown="SwitchToInterpolatedMode">
                switch to interpolated mode?
            </TextBlock>
        </StackPanel>

    </Grid>
</UserControl>
