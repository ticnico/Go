<UserControl x:Class="GoldenBullet.Controls.ParseBlockSettingsViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoldenBullet.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#FF1E1E1E">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- === Base Text Styles === -->
        <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#fec34d"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HeaderDescStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#fec34d"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>



        <Style x:Key="StyledRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40D19900"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D19900"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- === Section Container === -->
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>

        <!-- === Separator Style === -->
        <Style x:Key="StyledSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="0,15"/>
            <Setter Property="Height" Value="1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="8">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- === Header Section === -->
            <Border Background="#FF1E1E1E" 
                    BorderBrush="#40D19900" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="12,10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <iconPacks:PackIconMaterial Kind="CodeBraces" 
                                                    Width="18" Height="18" 
                                                    Foreground="#fec34d" 
                                                    Margin="0,0,8,0"/>
                        <TextBlock Text="Parse" 
                                   FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#fec34d"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HeaderTitleStyle}"
                               Text="{Binding NameAndId}"
                               Margin="26,0,0,2"/>
                    <TextBlock Style="{StaticResource HeaderDescStyle}"
                               Text="{Binding Block.Descriptor.Description}"
                               Margin="26,2,0,0"/>
                    <TextBlock Style="{StaticResource HeaderDescStyle}"
                               Text="{Binding Block.Descriptor.ExtraInfo}"
                               FontSize="10"
                               Margin="26,1,0,0"/>
                </StackPanel>
            </Border>

            <!-- === Basic Settings === -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <!-- Label -->
                    <DockPanel Margin="0,4,0,8">
                        <Label Style="{StaticResource LabelStyle}" 
           Content="Label:" 
           DockPanel.Dock="Left"
           VerticalAlignment="Center"
           Margin="0 0 5 0"/>

                        <TextBox Style="{StaticResource RoundedTextBox}"
             Text="{Binding Label}"
             HorizontalAlignment="Stretch"
             Margin="0 4 0 0"/>
                    </DockPanel>

                    <!-- Safe Mode -->
                    <CheckBox Style="{StaticResource RoundedCheckBox}"
                              Content="Safe mode (catch exceptions to data.ERROR)"
                              IsChecked="{Binding SafeMode}" 
                              Margin="0,6,0,2"/>

                    <!-- Output Variable -->
                    <DockPanel Margin="0,4,0,8">
                        <Label Style="{StaticResource LabelStyle}" Margin="0 0 5 0"
                               Content="{Binding ReturnValueType}" 
                               DockPanel.Dock="Left"/>
                        <TextBox Style="{StaticResource RoundedTextBox}" 
                                 Text="{Binding OutputVariable}"
                                 DockPanel.Dock="Right"/>
                    </DockPanel>

                    <!-- Capture & Recursive -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Style="{StaticResource RoundedCheckBox}"
                                  Content="Is Capture"
                                  IsChecked="{Binding IsCapture}"
                                  Margin="0,0,12,0"/>
                        <CheckBox Style="{StaticResource RoundedCheckBox}"
                                  Content="Recursive"
                                  IsChecked="{Binding Recursive}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- === Parse Settings === -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <Label Style="{StaticResource LabelStyle}" 
                           Content="Parse Settings:" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                    <local:StringSettingViewer x:Name="inputSetting" Margin="0,0,0,4"/>
                    <local:StringSettingViewer x:Name="prefixSetting" Margin="0,0,0,4"/>
                    <local:StringSettingViewer x:Name="suffixSetting" Margin="0,0,0,4"/>
                    <local:BoolSettingViewer x:Name="urlEncodeOutputSetting"/>
                </StackPanel>
            </Border>

            <Separator Style="{StaticResource StyledSeparator}"/>

            <!-- === Parse Mode Selector === -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <Label Style="{StaticResource LabelStyle}" 
                           Content="Parse Method:" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource StyledRadioButton}"
                                     Content="LR"
                                     IsChecked="{Binding LRMode}"/>
                        <RadioButton Style="{StaticResource StyledRadioButton}"
                                     Content="LR2"
                                     IsChecked="{Binding LR2Mode}"/>
                        <RadioButton Style="{StaticResource StyledRadioButton}"
                                     Content="CSS"
                                     IsChecked="{Binding CSSMode}"/>
                        <RadioButton Style="{StaticResource StyledRadioButton}"
                                     Content="XPath"
                                     IsChecked="{Binding XPathMode}"/>
                        <RadioButton Style="{StaticResource StyledRadioButton}"
                                     Content="Json"
                                     IsChecked="{Binding JsonMode}"/>
                        <RadioButton Style="{StaticResource StyledRadioButton}"
                                     Content="Regex"
                                     IsChecked="{Binding RegexMode}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- === Mode-Specific Content (TabControl with hidden headers - PRESERVED) === -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <TabControl x:Name="tabControl" 
                            Background="Transparent" 
                            BorderThickness="0"
                            Padding="0">
                    <!-- Hide TabItem headers (original behavior) -->
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- LR Mode -->
                    <TabItem>
                        <StackPanel Margin="0,4,0,0">
                            <Label Style="{StaticResource LabelStyle}" Content="Left/Right Delimiters:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <local:StringSettingViewer x:Name="leftDelimSetting" Margin="0,0,0,4"/>
                            <local:StringSettingViewer x:Name="rightDelimSetting" Margin="0,0,0,4"/>
                            <local:BoolSettingViewer x:Name="caseSensitiveSetting"/>
                        </StackPanel>
                    </TabItem>

                    <!-- LR2 Mode (Multi-line support) -->
                    <TabItem>
                        <StackPanel Margin="0,4,0,0">
                            <Label Style="{StaticResource LabelStyle}" Content="Left Delimiter (Multi-line):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="leftDelimTextBox2"
                                     Style="{StaticResource RoundedTextBox}"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding FixedSetting.Value, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,4"/>
                            <Label Style="{StaticResource LabelStyle}" Content="Right Delimiter (Multi-line):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="rightDelimTextBox2"
                                     Style="{StaticResource RoundedTextBox}"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding FixedSetting.Value, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,4"/>
                            <local:BoolSettingViewer x:Name="caseSensitiveSetting2"/>
                        </StackPanel>
                    </TabItem>

                    <!-- CSS Mode -->
                    <TabItem>
                        <StackPanel Margin="0,4,0,0">
                            <Label Style="{StaticResource LabelStyle}" Content="CSS Selector:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <local:StringSettingViewer x:Name="cssSelectorSetting" Margin="0,0,0,4"/>
                            <local:StringSettingViewer x:Name="attributeNameSetting"/>
                        </StackPanel>
                    </TabItem>

                    <!-- XPath Mode -->
                    <TabItem>
                        <StackPanel Margin="0,4,0,0">
                            <Label Style="{StaticResource LabelStyle}" Content="XPath Expression:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <local:StringSettingViewer x:Name="xPathSetting"/>
                        </StackPanel>
                    </TabItem>

                    <!-- JSON Mode -->
                    <TabItem>
                        <StackPanel Margin="0,4,0,0">
                            <Label Style="{StaticResource LabelStyle}" Content="JSON Token:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <local:StringSettingViewer x:Name="jTokenSetting"/>
                        </StackPanel>
                    </TabItem>

                    <!-- Regex Mode -->
                    <TabItem>
                        <StackPanel Margin="0,4,0,0">
                            <Label Style="{StaticResource LabelStyle}" Content="Regex Pattern:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <local:StringSettingViewer x:Name="patternSetting" Margin="0,0,0,4"/>
                            <local:StringSettingViewer x:Name="outputFormatSetting" Margin="0,0,0,4"/>
                            <local:BoolSettingViewer x:Name="multiLineSetting"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
