<UserControl x:Class="GoldenBullet.Controls.ImagePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoldenBullet.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Image Preview Container Style -->
        <Style x:Key="ImagePreviewStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Click to change image"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#40D19900"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#D19900" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Placeholder Icon Style -->
        <Style x:Key="PlaceholderIconStyle" TargetType="iconPacks:PackIconMaterial">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Placeholder Text Style -->
        <Style x:Key="PlaceholderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ImageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40D19900"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#D19900" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1A1A1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button (Blue) -->
        <Style x:Key="ImagePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ImageButtonStyle}">
            <Setter Property="Background" Value="#D19900"/>
            <Setter Property="BorderBrush" Value="#FF005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF0063B1"/>
                    <Setter Property="BorderBrush" Value="#FF004A8A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button (Red) -->
        <Style x:Key="ImageDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ImageButtonStyle}">
            <Setter Property="Background" Value="#FFDC3545"/>
            <Setter Property="BorderBrush" Value="#FFBD2130"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC82333"/>
                    <Setter Property="BorderBrush" Value="#FF9E1B27"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFBD2130"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Helper Text Style -->
        <Style x:Key="HelperTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <!-- Main Container Card -->
    <Border Background="#FF252525" 
            BorderBrush="#40D19900" 
            BorderThickness="1" 
            CornerRadius="8"
            Padding="15">

        <StackPanel HorizontalAlignment="Left">

            <!-- Image Preview Area -->
            <Border x:Name="imagePreviewBorder"
                    Style="{StaticResource ImagePreviewStyle}"
                    MouseLeftButtonUp="OpenImage"
                    AllowDrop="True"
                    DragOver="ImagePreview_DragOver"
                    Drop="ImagePreview_Drop">

                <Grid>
                    <!-- Placeholder (shown when no image) -->
                    <StackPanel x:Name="placeholderPanel"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <iconPacks:PackIconMaterial Kind="ImageOutline" Style="{StaticResource PlaceholderIconStyle}"/>
                        <TextBlock Style="{StaticResource PlaceholderTextStyle}" Text="No image"/>
                        <TextBlock Style="{StaticResource HelperTextStyle}" Text="Click or drop to add"/>
                    </StackPanel>

                    <!-- Actual Image -->
                    <Image x:Name="previewImage"
                           Width="140" Height="140"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Hover Overlay (shows edit hint) -->
                    <Border x:Name="hoverOverlay"
                            Background="#80000000"
                            CornerRadius="6"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="PencilOutline" 
                                                        Width="20" Height="20" 
                                                        Foreground="White"
                                                        Margin="0,0,0,4"/>
                            <TextBlock Text="Change" Foreground="White" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="openImageButton" 
                        Click="OpenImage"
                        Style="{StaticResource StyledEditButton}"
                        Width="90">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconForkAwesome Kind="FolderOpen" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Browse..." VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="clearImageButton" 
                        Click="ClearImage"
                        Style="{StaticResource ImageDangerButtonStyle}"
                        Width="75"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Clear" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Helper Text -->
            <TextBlock Style="{StaticResource HelperTextStyle}" 
                       Text="Supported: PNG, JPG, GIF, BMP • Max 150x150 recommended"/>

            <!-- File Path Display (optional, shown when image loaded) -->
            <TextBlock x:Name="filePathText"
                       Text="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource HelperTextStyle}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed"
                       Margin="0,2,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
