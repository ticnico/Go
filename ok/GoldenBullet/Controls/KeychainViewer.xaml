<UserControl x:Class="GoldenBullet.Controls.KeychainViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoldenBullet.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <!-- === Label Style (Original Spacing) === -->
        <Style x:Key="KeychainLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        

        <!-- === Small Toolbar Button Style (Original: 25×20px) === -->
        <Style x:Key="KeychainSmallButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0 0 3 0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="2000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40D19900"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#D19900" BlurRadius="5" ShadowDepth="0" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1A1A1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- === Add Key Button Style (Original Widths, Rounded) === -->
        <Style x:Key="KeychainAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF28A745"/>
            <Setter Property="BorderBrush" Value="#FF1E7E34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF218838"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF19692C"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF28A745" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E7E34"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF155728"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Original Border: Margin="5 2 0 2", BorderThickness="3", CornerRadius="10", Padding="5" -->
    <Border 
        Margin="5 2 0 2"
        BorderThickness="3"
        BorderBrush="{Binding BorderBrush}"
        CornerRadius="10"
        Padding="5"
        Background="#FF252525">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Row: Status/Mode Selectors + Move/Delete Buttons -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" 
                       Style="{StaticResource KeychainLabelStyle}"
                       Content="Result status:" />
                <ComboBox Grid.Column="1"
                          Style="{StaticResource RoundedComboBox}"
                          ItemsSource="{Binding Statuses}"
                          SelectedValue="{Binding ResultStatus}" />

                <Label Grid.Column="2" 
                       Style="{StaticResource KeychainLabelStyle}"
                       Content="Mode:" />
                <ComboBox Grid.Column="3"
                          Style="{StaticResource RoundedComboBox}"
                          ItemsSource="{Binding Modes}"
                          SelectedValue="{Binding Mode}" />

                <!-- Move Up Button - Original: Grid.Column="5", Width="25", Height="20" -->
                <Button Click="MoveUp" 
                        Grid.Column="5"
                        Style="{StaticResource StyledWarningButton}"
                        Width="25"
                        Height="22"                        
                        ToolTip="Move the keychain up">
                    <iconPacks:PackIconUnicons Kind="AngleUp" Width="10" Height="10" />
                </Button>

                <!-- Move Down Button - Original: Grid.Column="6", Width="25", Height="20" -->
                <Button Click="MoveDown" 
                        Grid.Column="6"
                        Style="{StaticResource StyledWarningButton}"
                        Width="25"
                        Height="22"
                        Margin="5 0 0 0"
                        ToolTip="Move the keychain down">
                    <iconPacks:PackIconUnicons Kind="AngleDown" Width="10" Height="10" />
                </Button>

                <!-- Delete Button - Original: Grid.Column="7", Width="25", Height="20" -->
                <Button Click="Delete" 
                        Grid.Column="7"
                        Style="{StaticResource StyledDangerButton}"
                        Width="25"
                        Height="22"
                        Margin="5 0 0 0"
                        ToolTip="Remove the keychain">
                    <iconPacks:PackIconMaterial Kind="Close" Width="10" Height="10" />
                </Button>
            </Grid>

            <!-- Middle Row: Add Key Type Buttons - Original: StackPanel Orientation="Horizontal", Margin="0 5" -->
            <StackPanel Orientation="Horizontal" 
                        Margin="0 5"
                        Grid.Row="1">

                <Button Click="AddStringKey" 
                        Margin="0 0 5 0" 
                        Style="{StaticResource KeychainAddButtonStyle}"
                        Width="55" 
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="5 0" FontSize="10">String</TextBlock>
                    </StackPanel>
                </Button>

                <Button Click="AddBoolKey" 
                        Margin="0 0 5 0" 
                        Style="{StaticResource KeychainAddButtonStyle}"
                        Width="45" 
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="5 0" FontSize="10">Bool</TextBlock>
                    </StackPanel>
                </Button>

                <Button Click="AddIntKey" 
                        Margin="0 0 5 0" 
                        Style="{StaticResource KeychainAddButtonStyle}"
                        Width="45" 
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="5 0" FontSize="10">Int</TextBlock>
                    </StackPanel>
                </Button>

                <Button Click="AddFloatKey" 
                        Margin="0 0 5 0" 
                        Style="{StaticResource KeychainAddButtonStyle}"
                        Width="50" 
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="5 0" FontSize="10">Float</TextBlock>
                    </StackPanel>
                </Button>

                <Button Click="AddListKey" 
                        Margin="0 0 5 0" 
                        Style="{StaticResource KeychainAddButtonStyle}"
                        Width="50" 
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="5 0" FontSize="10">List</TextBlock>
                    </StackPanel>
                </Button>

                <Button Click="AddDictionaryKey" 
                        Margin="0 0 5 0" 
                        Style="{StaticResource KeychainAddButtonStyle}"
                        Width="70" 
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterialDesign Kind="Add" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="5 0" FontSize="10">Dictionary</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Bottom Row: Keys Panel - Original: Grid.Row="2", No Margin -->
            <StackPanel x:Name="keysPanel" Grid.Row="2" />

        </Grid>
    </Border>
</UserControl>
