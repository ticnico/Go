<Page x:Class="GoldenBullet.Controls.FindDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Find"
      Background="#FF2A2A2A"
      xmlns:local="clr-namespace:GoldenBullet.Controls">
    <Grid Margin="10" Width="360" Height="auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Find:" Foreground="#FFE0E0E0" VerticalAlignment="Center" Width="40"/>
            <TextBox x:Name="SearchTextBox" Width="320" VerticalAlignment="Center" Background="#FF1A1A1A" Foreground="#FFE0E0E0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8" VerticalAlignment="Center">
            <CheckBox x:Name="CaseSensitiveCheck" Content="Case sensitive" Foreground="#FFE0E0E0" Background="Transparent" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" Height="25">
            <Button x:Name="PrevButton" Content="Previous" Width="80" Margin="0,0,8,0" Click="PrevButton_Click" Style="{DynamicResource StyledPrimaryButton}"/>
            <Button x:Name="NextButton" Content="Next" Width="80" Click="NextButton_Click" Style="{DynamicResource StyledPrimaryButton}"/>
        </StackPanel>
    </Grid>
</Page>
