<UserControl x:Class="GoldenBullet.Controls.FloatSettingViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoldenBullet.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             d:DesignHeight="36" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <!-- === Label Style (Original Spacing) === -->
        <Style x:Key="SettingLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="3000"/>
        </Style>

        <!-- === Mode Toggle Button Style (Exact 30×30px + Rounded) === -->
        <Style x:Key="ModeToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#40D19900"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="2000"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40D19900"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#D19900" BlurRadius="5" ShadowDepth="0" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1A1A1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <!-- Setting Name Label -->
        <Label Style="{StaticResource SettingLabelStyle}"
               Content="{Binding Name}"
               ToolTip="{Binding Description}"
               VerticalAlignment="Center"
               Grid.Column="0" />

        <!-- Value Input: Variable/Constant Toggle -->
        <TabControl x:Name="tabControl" Grid.Column="1" Background="Transparent">
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- Variable Mode: ComboBox -->
            <TabItem>
                <ComboBox Style="{StaticResource RoundedComboBoxArow}"
                          IsEditable="True"
                          ItemsSource="{Binding Suggestions}"
                          Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" />
            </TabItem>

            <!-- Constant Mode: NumericUpDown (Wrapped for Rounded Corners) -->
            <TabItem>
                <Border Background="#FF2D2D2D"
                        BorderBrush="#40D19900"
                        BorderThickness="1"
                        CornerRadius="3"
                        Height="30"
                        VerticalAlignment="Center">
                    <mah:NumericUpDown Minimum="-3.40282347E+38"
                                       Maximum="3.40282347E+38"
                                       Interval="0.1"
                                       NumericInputMode="Decimal"
                                       StringFormat="#.#"
                                       Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                       Height="30"
                                       BorderThickness="0"
                                       Background="Transparent"
                                       Foreground="#FFE0E0E0"
                                       FontSize="11"
                                       Padding="4,2,24,2"
                                       VerticalAlignment="Center"
                                       VerticalContentAlignment="Center"/>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Mode Toggle Buttons (30×30px) -->
        <TabControl x:Name="buttonTabControl" Grid.Column="2" Background="Transparent">
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- Variable -> Constant -->
            <TabItem>
                <Button Click="ConstantMode"
                        Style="{StaticResource ModeToggleButtonStyle}"
                        ToolTip="Switch to constant mode">
                    <TextBlock FontSize="9" FontWeight="SemiBold">VAR</TextBlock>
                </Button>
            </TabItem>

            <!-- Constant -> Variable -->
            <TabItem>
                <Button Click="VariableMode"
                        Style="{StaticResource ModeToggleButtonStyle}"
                        ToolTip="Switch to variable mode">
                    <iconPacks:PackIconModern Kind="TextSerif" Width="14" Height="14" />
                </Button>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
