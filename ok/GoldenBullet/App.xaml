<Application x:Class="GoldenBullet.App"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
xmlns:local="clr-namespace:GoldenBullet.Helpers"
xmlns:helpers="clr-namespace:GoldenBullet.Helpers"
Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <!-- =================== -->
            <!-- MahApps.Metro Base Styles -->
            <!-- =================== -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- =================== -->
            <!-- GLOBAL SCROLLBAR STYLE (FIXED FOR MAHAPPS WITH ARROWS) -->
            <!-- Must come AFTER MahApps resources but BEFORE other custom styles -->
            <!-- =================== -->
            <!-- Brushes -->
            <SolidColorBrush x:Key="ScrollBarBg" Color="#2D2D30"/>
            <SolidColorBrush x:Key="ScrollBarBgHover" Color="#3E3E42"/>
            <SolidColorBrush x:Key="ScrollBarBgPressed" Color="#FCBA00"/>
            <SolidColorBrush x:Key="ScrollBarBorder" Color="#3F3F46"/>
            <SolidColorBrush x:Key="ScrollBarBorderHover" Color="#505055"/>
            <SolidColorBrush x:Key="ScrollBarBorderPressed" Color="#FCBA00"/>
            <SolidColorBrush x:Key="ScrollBarForeground" Color="#FFFFFF"/>
            <!-- Arrow Geometries -->
            <Geometry x:Key="ArrowUp">M 0,6 L 5,1 L 10,6 Z</Geometry>
            <Geometry x:Key="ArrowDown">M 0,4 L 5,9 L 10,4 Z</Geometry>
            <Geometry x:Key="ArrowLeft">M 6,0 L 1,5 L 6,10 Z</Geometry>
            <Geometry x:Key="ArrowRight">M 4,0 L 9,5 L 4,10 Z</Geometry>
            <!-- Page Button (invisible filler area) -->
            <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Thumb (The draggable part) -->
            <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border Background="{StaticResource ScrollBarBg}"
BorderBrush="{StaticResource ScrollBarBorder}"
BorderThickness="1"
SnapsToDevicePixels="True"
CornerRadius="2"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ScrollBarBgHover}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource ScrollBarBorderHover}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ScrollBarBgPressed}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource ScrollBarBorderPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Line Button (Arrow Buttons - NOW VISIBLE) -->
            <Style x:Key="ScrollBarLineButton" TargetType="{x:Type RepeatButton}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border x:Name="Border"
Background="{StaticResource ScrollBarBg}"
BorderBrush="{StaticResource ScrollBarBorder}"
BorderThickness="1"
SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource ScrollBarBgHover}"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ScrollBarBorderHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource ScrollBarBgPressed}"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ScrollBarBorderPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Vertical ScrollBar Template (Includes Arrows) -->
            <ControlTemplate x:Key="VerticalScrollBar" TargetType="{x:Type ScrollBar}">
                <Border BorderBrush="{StaticResource ScrollBarBorder}" BorderThickness="1,0,1,0" Width="13">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition MaxHeight="13"/>
                            <RowDefinition/>
                            <RowDefinition MaxHeight="13"/>
                        </Grid.RowDefinitions>
                        <!-- Up Arrow -->
                        <RepeatButton Grid.Row="0"
Style="{StaticResource ScrollBarLineButton}"
Command="ScrollBar.LineUpCommand">
                            <Path Data="{StaticResource ArrowUp}" Fill="{StaticResource ScrollBarForeground}" Width="10" Height="10"/>
                        </RepeatButton>
                        <!-- Track Area -->
                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" Width="14" Margin="0,2,0,2"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <!-- Down Arrow -->
                        <RepeatButton Grid.Row="2"
Style="{StaticResource ScrollBarLineButton}"
Command="ScrollBar.LineDownCommand">
                            <Path Data="{StaticResource ArrowDown}" Fill="{StaticResource ScrollBarForeground}" Width="10" Height="10"/>
                        </RepeatButton>
                    </Grid>
                </Border>
            </ControlTemplate>
            <!-- Horizontal ScrollBar Template (Includes Arrows) -->
            <ControlTemplate x:Key="HorizontalScrollBar" TargetType="{x:Type ScrollBar}">
                <Border BorderBrush="{StaticResource ScrollBarBorder}" BorderThickness="0,1,0,1" Height="13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MaxWidth="13"/>
                            <ColumnDefinition/>
                            <ColumnDefinition MaxWidth="13"/>
                        </Grid.ColumnDefinitions>
                        <!-- Left Arrow -->
                        <RepeatButton Grid.Column="0"
Style="{StaticResource ScrollBarLineButton}"
Command="ScrollBar.LineLeftCommand">
                            <Path Data="{StaticResource ArrowLeft}" Fill="{StaticResource ScrollBarForeground}" Width="10" Height="10"/>
                        </RepeatButton>
                        <!-- Track Area -->
                        <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageLeftCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" Height="14" Margin="2,0,2,0"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageRightCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <!-- Right Arrow -->
                        <RepeatButton Grid.Column="2"
Style="{StaticResource ScrollBarLineButton}"
Command="ScrollBar.LineRightCommand">
                            <Path Data="{StaticResource ArrowRight}" Fill="{StaticResource ScrollBarForeground}" Width="10" Height="10"/>
                        </RepeatButton>
                    </Grid>
                </Border>
            </ControlTemplate>
            <!-- GLOBAL ScrollBar Style (NO x:Key = applies to ALL ScrollBars) -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <!-- Forward mouse wheel events from the scrollbar to its parent ScrollViewer
                     so the mouse wheel still scrolls the content even when over the scrollbar -->
                <EventSetter Event="PreviewMouseWheel" Handler="ScrollBar_PreviewMouseWheel"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width" Value="13"/>
                        <Setter Property="Height" Value="Auto"/>
                        <Setter Property="Template" Value="{StaticResource VerticalScrollBar}"/>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="13"/>
                        <Setter Property="Template" Value="{StaticResource HorizontalScrollBar}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- =================== -->
            <!-- Custom Brushes & Colors (your existing resources) -->
            <!-- =================== -->
            <SolidColorBrush x:Key="ThemeMain" Color="#FCBA00" />
            <SolidColorBrush x:Key="BackgroundMain" Color="#222222" />
            <SolidColorBrush x:Key="BackgroundSecondary" Color="#111111" />
            <SolidColorBrush x:Key="BackgroundInput" Color="#282828" />
            <SolidColorBrush x:Key="ForegroundMain" Color="White" />
            <SolidColorBrush x:Key="ForegroundInput" Color="#DCDCDC" />
            <!-- Buttons -->
            <SolidColorBrush x:Key="SuccessButton" Color="#2F5738"/>
            <SolidColorBrush x:Key="PrimaryButton" Color="#3B3A63"/>
            <SolidColorBrush x:Key="WarningButton" Color="#7A552A"/>
            <SolidColorBrush x:Key="DangerButton" Color="#693838"/>
            <SolidColorBrush x:Key="ForegroundButton" Color="#DCDCDC"/>
            <SolidColorBrush x:Key="BackgroundButton" Color="#282828"/>
            <SolidColorBrush x:Key="IsMouseOver" Color="#D19900"/>
            <SolidColorBrush x:Key="IsPressed" Color="#D19900"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#D19900"/>
<!-- ================================================================================================= -->
            <Style x:Key="StyledButton" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundButton}" />
                <Setter Property="Background" Value="{DynamicResource BackgroundButton}" />
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="#2d2d2d"/>
                <Setter Property="BorderBrush" Value="#3d3d3d"/>
                <Setter Property="Foreground" Value="#e0e0e0"/>
            </Style>
<!-- ================================================================================================= -->
            <Style x:Key="StyledPrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="#FF3C3C3C"/>
                <Setter Property="Foreground" Value="#FFE0E0E0"/>
                <Setter Property="BorderBrush" Value="#FF505050"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="3"
Padding="6 0 5 0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF4A4A4A"/>
                                    <Setter Property="BorderBrush" Value="#40D19900"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
<!-- ================================================================================================= -->
            <Style x:Key="GlowingProgressBar" TargetType="{x:Type ProgressBar}">
                <Setter Property="Background" Value="#2D2D30"/>
                <Setter Property="Foreground" Value="#D19900"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <Grid>
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="5"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" 
                            HorizontalAlignment="Left" CornerRadius="5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#D19900" BlurRadius="10" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                     Storyboard.TargetProperty="(UIElement.Opacity)"
                                                     From="0.5" To="1" Duration="0:0:1" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
<!-- ================================================================================================= -->
            <Style x:Key="StyledSuccessButton" TargetType="Button">
                <Setter Property="Background" Value="#FF28A745"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#FF28A745"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="3"
Padding="5">
                                
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF34CE57"/>
                                    <Setter Property="BorderBrush" Value="#FF34CE57"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
<!-- ================================================================================================= -->
            <Style x:Key="StyledWarningButton" TargetType="Button">
                <Setter Property="Background" Value="#FCBA00"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#FCBA00"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="3"
Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D19900"/>
                                    <Setter Property="BorderBrush" Value="#40D19900"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
<!-- ================================================================================================= -->
            <Style x:Key="StyledDangerButton" TargetType="Button">
                <Setter Property="Background" Value="#FFDC3545"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#FFDC3545"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="3"
Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFBD2130"/>
                                    <Setter Property="BorderBrush" Value="#FFBD2130"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
<!-- ================================================================================================= -->
            <!-- Modern Label Style -->
            <Style x:Key="ModernLabel" TargetType="Label">
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
<!-- ================================================================================================= -->
            <Style x:Key="RoundedTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#FF2D2D2D"/>
                <Setter Property="Foreground" Value="#FFE0E0E0"/>
                <Setter Property="CaretBrush" Value="#FFE0E0E0"/>
                <Setter Property="AcceptsReturn" Value="False"/>
                <!-- ✅ ADD THIS LINE -->
                <Setter Property="BorderBrush" Value="#40D19900"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Padding" Value="3,6"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <!-- Added TextOptions to remove text blur -->
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#D19900"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#D19900"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                            <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                  SnapsToDevicePixels="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
                <Setter Property="CaretBrush" Value="#FFE0E0E0"/>
            </Style>
<!-- ================================================================================================= -->
            <Style x:Key="RoundedTextBoxWarp" TargetType="TextBox">
                <Setter Property="Background" Value="#FF2D2D2D"/>
                <Setter Property="Foreground" Value="#FFE0E0E0"/>
                <Setter Property="CaretBrush" Value="#FFE0E0E0"/>
                <Setter Property="BorderBrush" Value="#40D19900"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <!-- ✅ ENABLE WORD WRAP -->
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Padding" Value="3,4"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <!-- ✅ TOP ALIGN FOR MULTI-LINE -->
                <!-- Added TextOptions to remove text blur -->
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#D19900"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#D19900"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                            <Border Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6"
            SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                      SnapsToDevicePixels="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
<!-- ================================================================================================= -->
            <Style x:Key="RoundedComboBoxArow" TargetType="ComboBox">
                <Setter Property="Background" Value="#FF2D2D2D"/>
                <Setter Property="Foreground" Value="#FFE0E0E0"/>
                <Setter Property="BorderBrush" Value="#40D19900"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>

                                <!-- BORDER -->
                                <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"/>

                                <!-- CONTENT -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="ContentSite"
                                          Grid.Column="0"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          VerticalAlignment="Center"/>

                                    <TextBox x:Name="PART_EditableTextBox"
                                 Grid.Column="0"
                                             VerticalAlignment="Center"
                                 Background="Transparent"
                                 Foreground="{TemplateBinding Foreground}"
                                 BorderThickness="0"
                                 Visibility="Collapsed"/>

                                    <!-- ARROW -->
                                    <Path Grid.Column="1"
                              Width="10"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{TemplateBinding Foreground}"
                              Data="M0,0 L10,0 L5,6 Z"/>
                                </Grid>

                                <!-- CLICK ONLY ARROW -->
                                <ToggleButton Width="20"
                                  HorizontalAlignment="Right"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>

                                <!-- POPUP -->
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False">

                                    <Border Background="#FF2D2D2D"
                                BorderBrush="#FFD19900"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinWidth="{TemplateBinding ActualWidth}">

                                        <ScrollViewer>
                                            <ItemsPresenter/>
                                        </ScrollViewer>

                                    </Border>
                                </Popup>

                            </Grid>

                            <!-- TRIGGERS -->
                            <ControlTemplate.Triggers>

                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFD19900"/>
                                </Trigger>

                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFD19900"/>
                                </Trigger>

                                <!-- MUST BE LAST -->
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFD19900"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
<!-- ================================================================================================= -->
            <Style x:Key="RoundedComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="#FF2D2D2D"/>
                <Setter Property="Foreground" Value="#FFE0E0E0"/>
                <Setter Property="BorderBrush" Value="#40D19900"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="IsEditable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <!-- BORDER -->
                                <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"/>

                                <!-- CONTENT -->
                                <Grid Margin="5,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="ContentSite"
                                          Grid.Column="0"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          VerticalAlignment="Center"/>

                                    <!-- ARROW (Visual Only) -->
                                    <Path Grid.Column="1"
                              Width="10"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{TemplateBinding Foreground}"
                              Data="M0,0 L10,0 L5,6 Z"/>
                                </Grid>

                                <!-- CLICKABLE AREA (Full Width, Completely Invisible) -->
                                <!-- CLICKABLE AREA (Full Width, Completely Invisible) -->
                                <ToggleButton 
    Background="Transparent"
    BorderBrush="Transparent"
    BorderThickness="0"
    Cursor="Hand"
    Focusable="False"
    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- POPUP -->
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False">
                                    <Border Background="#FF2D2D2D"
                                BorderBrush="#FFD19900"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinWidth="{TemplateBinding ActualWidth}">
                                        <ScrollViewer>
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- TRIGGERS -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFD19900"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFD19900"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFD19900"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource RoundedComboBox}"/>

<!-- ================================================================================================= -->            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegroundInput}" />
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="true">
                                <ContentPresenter HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Hover Color (Changed from Blue to Dark Gray) -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#D19900"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#D19900"/>
                                </Trigger>
                                <!-- Selected Color (Changed to Gold Accent) -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#D19900"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
<!-- ================================================================================================= -->
            <Style TargetType="{x:Type iconPacks:PackIconFontAwesome}" BasedOn="{StaticResource {x:Type iconPacks:PackIconFontAwesome}}">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundMain}" />
            </Style>
<!-- ================================================================================================= -->
            <Style x:Key="RoundedCheckBox" TargetType="CheckBox">
                <Setter Property="Background" Value="#FF2D2D2D"/>
                <Setter Property="Foreground" Value="#FFE0E0E0"/>
                <Setter Property="BorderBrush" Value="#40D19900"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBorder"
Grid.Column="0"
Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="4"
Width="16"
Height="16"
Margin="0,0,5,0"
VerticalAlignment="Center"
SnapsToDevicePixels="True">
                                    <Grid>
                                        <Path x:Name="CheckMark"
Width="10"
Height="10"
Data="M 0 5 L 4 9 L 10 0"
Stretch="None"
Stroke="#D19900"
StrokeThickness="2"
Visibility="Collapsed"
VerticalAlignment="Center"
HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter Grid.Column="1"
Content="{TemplateBinding Content}"
ContentTemplate="{TemplateBinding ContentTemplate}"
ContentStringFormat="{TemplateBinding ContentStringFormat}"
HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
Margin="{TemplateBinding Padding}"
RecognizesAccessKey="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#40D19900"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#D19900"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource RoundedCheckBox}"/>
<!-- ================================================================================================= -->
