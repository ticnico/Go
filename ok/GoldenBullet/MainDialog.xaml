<mah:MetroWindow x:Class="GoldenBullet.MainDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoldenBullet"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="MainDialog" Height="300" Width="300"
        Background="#FF1E1E1E"
		SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        BorderThickness="0"
        GlowBrush="#FFD700"
        WindowTitleBrush="#FF252525"
        WindowTransitionsEnabled="False"
        TitleCharacterCasing="Normal"
        WindowStartupLocation="CenterScreen"
        ShowTitleBar="True"
        ShowMinButton="True"
        ShowMaxRestoreButton="True"
        ShowCloseButton="True"
        TitleAlignment="Left">

    <!-- Main Application Container -->
    <Grid Background="#FF1E1E1E">

        <!-- App Header / Custom Title Enhancement -->
        <Border Background="#FF252525" 
                BorderBrush="#80D19900" 
                BorderThickness="0,0,0,1" 
                Height="40" 
                VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon + Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
                    <iconPacks:PackIconMaterial Kind="Security" 
                                                Width="18" Height="18" 
                                                Foreground="#D19900" 
                                                VerticalAlignment="Center"/>
                    <TextBlock Text="GoldenBullet" 
                               Foreground="#FFE0E0E0" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <TextBlock Text="v2.0" 
                               Foreground="#FF666666" 
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Status Indicator (Right Side) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                    <Ellipse Width="8" Height="8" Fill="#FF28A745" Margin="0,0,6,0" ToolTip="Ready"/>
                    <TextBlock Text="Ready" Foreground="#FFAAAAAA" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area (Placeholder for dynamic content) -->
        <ContentControl x:Name="mainContent"
                        Margin="0,40,0,0"
                        Background="Transparent">
            <!-- Dynamic page content loads here -->
        </ContentControl>

        <!-- Optional: App Footer / Status Bar -->
        <Border Background="#FF252525" 
                BorderBrush="#80D19900" 
                BorderThickness="0,1,0,0" 
                Height="28" 
                VerticalAlignment="Bottom">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Status Messages -->
                <TextBlock x:Name="statusText"
                           Grid.Column="0"
                           Text="GoldenBullet is ready" 
                           Foreground="#FFAAAAAA" 
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

                <!-- Right: Quick Info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="Memory: -- MB" Foreground="#FF666666" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Threads: --" Foreground="#FF666666" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</mah:MetroWindow>
