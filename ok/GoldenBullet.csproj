
        <Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows7.0</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationIcon>logo.ico</ApplicationIcon>
        <WindowsSdkPackageVersion>10.0.19041.33</WindowsSdkPackageVersion>
        <RootNamespace>GoldenBullet</RootNamespace>
        <AssemblyName>GoldenBullet</AssemblyName>
        <DebugType>none</DebugType>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>

        <!-- ✅ NetBeauty: Specify libraries folder -->
        <NetBeautyLibsDir>libraries</NetBeautyLibsDir>
    </PropertyGroup>

    <PropertyGroup>
        <!-- ✅ NetBeauty Settings - FIXED -->
        <DisableBeauty>False</DisableBeauty>
        <BeautySharedRuntimeMode>False</BeautySharedRuntimeMode>

        <!-- ⚠️ CHANGE THIS: False for build, True only for publish -->
        <BeautyOnPublishOnly>False</BeautyOnPublishOnly>

        <BeautyNoRuntimeInfo>False</BeautyNoRuntimeInfo>
        <BeautyUsePatch>True</BeautyUsePatch>
        <BeautyLogLevel>Info</BeautyLogLevel>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="Views\Pages\ProxyCheckerPage.xaml.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
        <None Remove="Images\cider.gif" />
        <None Remove="Images\fairy.gif" />
        <None Remove="Images\ffaez.gif" />
        <None Remove="Images\james.gif" />
        <None Remove="Images\laiteux.gif" />
        <None Remove="Images\logohk.png" />
        <None Remove="Images\logohq.png" />
        <None Remove="Images\logohq_square_padded.png" />
        <None Remove="Images\logohq_square_padded_bg.png" />
        <None Remove="Images\mastercho.gif" />
